# Copy to .env and fill in. .env is gitignored. In CI these come from GitHub Secrets.
# Load in Git Bash with: set -a; source .env; set +a

# MotherDuck token (MotherDuck UI -> Settings -> Access tokens)
MOTHERDUCK_TOKEN=

# MotherDuck database the World Bank extract loads into: dev_dwh (default) or prod_dwh.
# Leave it as dev_dwh locally. The scheduled GitHub Actions job sets prod_dwh.
MOTHERDUCK_DATABASE=dev_dwh
