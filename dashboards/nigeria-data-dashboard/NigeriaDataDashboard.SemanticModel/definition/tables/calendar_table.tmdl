	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column year_rank_asc
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: year_rank_asc

		annotation SummarizationSetBy = Automatic

	column qtr_year
		dataType: string
		summarizeBy: none
		sourceColumn: qtr_year
		sortByColumn: qtr_year_sort

		annotation SummarizationSetBy = Automatic

	column qtr_year_sort
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: qtr_year_sort

		annotation SummarizationSetBy = Automatic

	partition calendar_table = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database(MotherDuckHost, MotherDuckDatabase), "select#(lf)    date, day_num, day_name, dayf, day_of_week, day_rank_asc, day_rank_desc,#(lf)    week_date, week_year_num, week_year_name, weekf, week_month_rank,#(lf)    week_rank_asc, week_rank_desc,#(lf)    month_date, month_num, month_name, monthf, month_rank_asc, month_rank_desc,#(lf)    qtr_num, qtr_name, qtr_rank_asc, qtr_rank_desc,#(lf)    year, year_rank_asc,#(lf)    qtr_name || ' ' || year as qtr_year,#(lf)    year * 10 + qtr_num as qtr_year_sort#(lf)from sandbox.fo_calendar#(lf)where date != current_date", null, [EnableFolding = true])
				in
				    Source

	annotation PBI_ResultType = Table
