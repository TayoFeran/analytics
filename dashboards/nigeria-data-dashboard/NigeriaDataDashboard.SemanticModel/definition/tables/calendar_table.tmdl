table calendar_table
	dataCategory: Time

	column date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column day_num
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: day_num

		annotation SummarizationSetBy = Automatic

	column day_name
		dataType: string
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: day_of_week

		annotation SummarizationSetBy = Automatic

	column dayf
		dataType: string
		summarizeBy: none
		sourceColumn: dayf
		sortByColumn: date

		annotation SummarizationSetBy = Automatic

	column day_of_week
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: day_of_week

		annotation SummarizationSetBy = Automatic

	column day_rank_asc
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: day_rank_asc

		annotation SummarizationSetBy = Automatic

	column day_rank_desc
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: day_rank_desc

		annotation SummarizationSetBy = Automatic

	column week_date
		dataType: dateTime
		formatString: dd mmm yyyy
		summarizeBy: none
		sourceColumn: week_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column week_year_num
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: week_year_num

		annotation SummarizationSetBy = Automatic

	column week_year_name
		dataType: string
		summarizeBy: none
		sourceColumn: week_year_name
		sortByColumn: week_year_num

		annotation SummarizationSetBy = Automatic

	column weekf
		dataType: string
		summarizeBy: none
		sourceColumn: weekf
		sortByColumn: week_date

		annotation SummarizationSetBy = Automatic

	column week_month_rank
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: week_month_rank

		annotation SummarizationSetBy = Automatic

	column week_rank_asc
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: week_rank_asc

		annotation SummarizationSetBy = Automatic

	column week_rank_desc
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: week_rank_desc

		annotation SummarizationSetBy = Automatic

	column month_date
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: month_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column month_num
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month_num

		annotation SummarizationSetBy = Automatic

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_num

		annotation SummarizationSetBy = Automatic

	column monthf
		dataType: string
		summarizeBy: none
		sourceColumn: monthf
		sortByColumn: month_date

		annotation SummarizationSetBy = Automatic

	column month_rank_asc
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month_rank_asc

		annotation SummarizationSetBy = Automatic

	column month_rank_desc
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month_rank_desc

		annotation SummarizationSetBy = Automatic

	column qtr_num
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: qtr_num

		annotation SummarizationSetBy = Automatic

	column qtr_name
		dataType: string
		summarizeBy: none
		sourceColumn: qtr_name
		sortByColumn: qtr_num

		annotation SummarizationSetBy = Automatic

	column qtr_rank_asc
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: qtr_rank_asc

		annotation SummarizationSetBy = Automatic

	column qtr_rank_desc
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: qtr_rank_desc

