table Compare_By

	column compare_by
		dataType: string
		summarizeBy: none
		sourceColumn: compare_by
		sortByColumn: compare_by_order

		annotation SummarizationSetBy = Automatic

	column compare_by_order
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: compare_by_order

		annotation SummarizationSetBy = Automatic

	partition Compare_By = m
		mode: import
		source =
				let
				    Source = Table.Distinct(Table.SelectColumns(Compare_A, {"compare_by", "compare_by_order"}))
				in
				    Source

	annotation PBI_ResultType = Table
