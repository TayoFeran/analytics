	partition faac = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(PostgreSQL.Database(MotherDuckHost, MotherDuckDatabase), "select#(lf)    disbursement_date::date as disbursement_date,#(lf)    state,#(lf)    president,#(lf)    total_gross_amount::double as total_gross_amount,#(lf)    statutory_allocation::double as statutory_allocation,#(lf)    gross_vat_allocation::double as gross_vat_allocation,#(lf)    oil_derivation::double as oil_derivation,#(lf)    exchange_gain_difference::double as exchange_gain_difference,#(lf)    total_ecology_fund::double as total_ecology_fund,#(lf)    others_income::double as others_income,#(lf)    total_deductions::double as total_deductions,#(lf)    external_debt::double as external_debt,#(lf)    contractual_obligation_ispo::double as contractual_obligation_ispo,#(lf)    transfer_nddc_hyppadec::double as transfer_nddc_hyppadec,#(lf)    other_deductions_note::double as other_deductions_note,#(lf)    deduction_misc::double as deduction_misc,#(lf)    other_deduction::double as other_deduction,#(lf)    net_amount_after_deductions::double as net_amount_after_deductions,#(lf)    total_gross_amount_usd::double as total_gross_amount_usd,#(lf)    statutory_allocation_usd::double as statutory_allocation_usd,#(lf)    gross_vat_allocation_usd::double as gross_vat_allocation_usd,#(lf)    oil_derivation_usd::double as oil_derivation_usd,#(lf)    exchange_gain_difference_usd::double as exchange_gain_difference_usd,#(lf)    total_ecology_fund_usd::double as total_ecology_fund_usd,#(lf)    others_income_usd::double as others_income_usd,#(lf)    total_deductions_usd::double as total_deductions_usd,#(lf)    external_debt_usd::double as external_debt_usd,#(lf)    contractual_obligation_ispo_usd::double as contractual_obligation_ispo_usd,#(lf)    transfer_nddc_hyppadec_usd::double as transfer_nddc_hyppadec_usd,#(lf)    other_deductions_note_usd::double as other_deductions_note_usd,#(lf)    deduction_misc_usd::double as deduction_misc_usd,#(lf)    other_deduction_usd::double as other_deduction_usd,#(lf)    net_amount_after_deductions_usd::double as net_amount_after_deductions_usd,#(lf)    naira_per_usd::double as naira_per_usd#(lf)from datamart.nigeria_faac_state_month", null, [EnableFolding = true])
				in
				    Source

	annotation PBI_ResultType = Table
