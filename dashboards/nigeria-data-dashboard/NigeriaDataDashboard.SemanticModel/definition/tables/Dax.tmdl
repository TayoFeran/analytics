table Dax

	measure Gross =
			-- Gross allocation in the currency picked on the ₦/$ switch
			IF (
			    SELECTEDVALUE ( Currency[Currency], "₦" ) = "$",
			    SUM ( faac[total_gross_amount_usd] ),
			    SUM ( faac[total_gross_amount] )
			)
		displayFolder: 01 Base\Income

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Statutory =
			-- Statutory allocation in the currency picked on the ₦/$ switch
			IF (
			    SELECTEDVALUE ( Currency[Currency], "₦" ) = "$",
			    SUM ( faac[statutory_allocation_usd] ),
			    SUM ( faac[statutory_allocation] )
			)
		displayFolder: 01 Base\Income

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure VAT =
			-- VAT in the currency picked on the ₦/$ switch
			IF (
			    SELECTEDVALUE ( Currency[Currency], "₦" ) = "$",
