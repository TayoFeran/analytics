	measure Contractual_Obligation =
			-- Contractual obligations (ISPO) in the currency picked on the ₦/$ switch
			IF (
			    SELECTEDVALUE ( Currency[Currency], "₦" ) = "$",
			    SUM ( faac[contractual_obligation_ispo_usd] ),
			    SUM ( faac[contractual_obligation_ispo] )
			)
		displayFolder: 01 Base\Deductions

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure NDDC_Transfer =
			-- NDDC / HYPPADEC transfer in the currency picked on the ₦/$ switch
			IF (
			    SELECTEDVALUE ( Currency[Currency], "₦" ) = "$",
			    SUM ( faac[transfer_nddc_hyppadec_usd] ),
			    SUM ( faac[transfer_nddc_hyppadec] )
			)
		displayFolder: 01 Base\Deductions

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Other_Deductions_Note =
			-- Other deductions (see note) in the currency picked on the ₦/$ switch
			IF (
			    SELECTEDVALUE ( Currency[Currency], "₦" ) = "$",
			    SUM ( faac[other_deductions_note_usd] ),
			    SUM ( faac[other_deductions_note] )
			)
		displayFolder: 01 Base\Deductions

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Deduction_Misc =
			-- Deduction (unlabelled) in the currency picked on the ₦/$ switch
			IF (
			    SELECTEDVALUE ( Currency[Currency], "₦" ) = "$",
			    SUM ( faac[deduction_misc_usd] ),
			    SUM ( faac[deduction_misc] )
			)
		displayFolder: 01 Base\Deductions

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Other_Deduction =
			-- Other deductions in the currency picked on the ₦/$ switch
			IF (
			    SELECTEDVALUE ( Currency[Currency], "₦" ) = "$",
			    SUM ( faac[other_deduction_usd] ),
			    SUM ( faac[other_deduction] )
			)
		displayFolder: 01 Base\Deductions

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Net =
			-- Net received in the currency picked on the ₦/$ switch
			IF (
			    SELECTEDVALUE ( Currency[Currency], "₦" ) = "$",
			    SUM ( faac[net_amount_after_deductions_usd] ),
			    SUM ( faac[net_amount_after_deductions] )
			)
		displayFolder: 01 Base\Net

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Net_rate =
			-- Share of the gross allocation the state actually received
			DIVIDE ( [Net], [Gross], 0 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Base\Net

	measure Months =
			DISTINCTCOUNT ( faac[disbursement_date] )
		formatString: #,0
		displayFolder: 01 Base\Context

	measure States =
			DISTINCTCOUNT ( faac[state] )
		formatString: #,0
		displayFolder: 01 Base\Context

	measure State_months =
			-- State-month rows, the divisor for the Per state per month basis
			COUNTROWS ( faac )
		formatString: #,0
		displayFolder: 01 Base\Context

	measure Latest_month =
			-- Latest month with FAAC data, whatever is selected
			CALCULATE ( MAX ( faac[disbursement_date] ), REMOVEFILTERS () )
		formatString: mmm yyyy
		displayFolder: 01 Base\Context

	measure FX_rate_avg =
			-- Average of the monthly official rates in the selection (naira per US dollar)
			AVERAGEX ( VALUES ( faac[disbursement_date] ), CALCULATE ( MAX ( faac[naira_per_usd] ) ) )
		formatString: ₦#,0.00
		displayFolder: 01 Base\Context

	measure Metric_value =
			-- Value of the metric picked in Metric_param (a matrix row or column, a hovered cell, or a
			-- card's visual filter). Sums columns directly, so calculation groups apply to it exactly once.
			VAR _k = SELECTEDVALUE ( Metric_param[Metric_key] )
			VAR _usd = SELECTEDVALUE ( Currency[Currency], "₦" ) = "$"
			RETURN
			    SWITCH (
			        _k,
			        "Gross", IF ( _usd, SUM ( faac[total_gross_amount_usd] ), SUM ( faac[total_gross_amount] ) ),
			        "Statutory", IF ( _usd, SUM ( faac[statutory_allocation_usd] ), SUM ( faac[statutory_allocation] ) ),
			        "VAT", IF ( _usd, SUM ( faac[gross_vat_allocation_usd] ), SUM ( faac[gross_vat_allocation] ) ),
			        "Oil_Derivation", IF ( _usd, SUM ( faac[oil_derivation_usd] ), SUM ( faac[oil_derivation] ) ),
			        "Exchange_Gain", IF ( _usd, SUM ( faac[exchange_gain_difference_usd] ), SUM ( faac[exchange_gain_difference] ) ),
			        "Ecology", IF ( _usd, SUM ( faac[total_ecology_fund_usd] ), SUM ( faac[total_ecology_fund] ) ),
			        "Others_Income", IF ( _usd, SUM ( faac[others_income_usd] ), SUM ( faac[others_income] ) ),
			        "Deductions", IF ( _usd, SUM ( faac[total_deductions_usd] ), SUM ( faac[total_deductions] ) ),
			        "External_Debt", IF ( _usd, SUM ( faac[external_debt_usd] ), SUM ( faac[external_debt] ) ),
			        "Contractual_Obligation", IF ( _usd, SUM ( faac[contractual_obligation_ispo_usd] ), SUM ( faac[contractual_obligation_ispo] ) ),
			        "NDDC_Transfer", IF ( _usd, SUM ( faac[transfer_nddc_hyppadec_usd] ), SUM ( faac[transfer_nddc_hyppadec] ) ),
			        "Other_Deductions_Note", IF ( _usd, SUM ( faac[other_deductions_note_usd] ), SUM ( faac[other_deductions_note] ) ),
			        "Deduction_Misc", IF ( _usd, SUM ( faac[deduction_misc_usd] ), SUM ( faac[deduction_misc] ) ),
			        "Other_Deduction", IF ( _usd, SUM ( faac[other_deduction_usd] ), SUM ( faac[other_deduction] ) ),
			        "Net", IF ( _usd, SUM ( faac[net_amount_after_deductions_usd] ), SUM ( faac[net_amount_after_deductions] ) )
			    )
		displayFolder: 01 Base\Selected metric

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Oil_Derivation_share =
			DIVIDE ( [Oil_Derivation], [Gross], 0 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Shares

	measure VAT_share =
			DIVIDE ( [VAT], [Gross], 0 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Shares

	measure Deductions_share =
			DIVIDE ( [Deductions], [Gross], 0 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Shares

	measure Net_share_national =
			-- The state's share of the net received by all states, for the current period
			DIVIDE ( [Net_curr], CALCULATE ( [Net_curr], REMOVEFILTERS ( dim_state ) ), 0 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Shares

	measure Gross_curr =
			CALCULATE ( [Gross], 'Period Calc'[Name] = "Current" )
		displayFolder: 03 Period Comparison\Gross

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Gross_prev =
			CALCULATE ( [Gross], 'Period Calc'[Name] = "Previous" )
		displayFolder: 03 Period Comparison\Gross

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Gross_PnP =
			CALCULATE ( [Gross], 'Period Calc'[Name] = "Change %" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Gross

	measure 'Gross_G&D' =
			CALCULATE ( [Gross], 'Period Calc'[Name] = "Trend" )
		displayFolder: 03 Period Comparison\Gross

	measure Gross_colour =
			-- Up is good
			VAR _chg = [Gross_PnP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _chg ) || ROUND ( _chg, 4 ) = 0, "#C98A00",
			        _chg > 0, "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 03 Period Comparison\Gross

	measure Gross_change_text =
			-- e.g. "▲ 8.9% Growth · vs Mar 2026"
			VAR _chg = [Gross_PnP]
			VAR _mark =
			    SWITCH ( TRUE (), ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( _chg ),
			        "No data for this period",
			        _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & " " & [Gross_G&D] & " · " & [Periodic_text]
			    )
		displayFolder: 03 Period Comparison\Gross

	measure Deductions_curr =
			CALCULATE ( [Deductions], 'Period Calc'[Name] = "Current" )
		displayFolder: 03 Period Comparison\Deductions

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Deductions_prev =
			CALCULATE ( [Deductions], 'Period Calc'[Name] = "Previous" )
		displayFolder: 03 Period Comparison\Deductions

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Deductions_PnP =
			CALCULATE ( [Deductions], 'Period Calc'[Name] = "Change %" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Deductions

	measure 'Deductions_G&D' =
			CALCULATE ( [Deductions], 'Period Calc'[Name] = "Trend" )
		displayFolder: 03 Period Comparison\Deductions

	measure Deductions_colour =
			-- Up is bad: more was deducted
			VAR _chg = [Deductions_PnP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _chg ) || ROUND ( _chg, 4 ) = 0, "#C98A00",
			        _chg < 0, "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 03 Period Comparison\Deductions

	measure Deductions_change_text =
			-- e.g. "▲ 8.9% Growth · vs Mar 2026"
			VAR _chg = [Deductions_PnP]
			VAR _mark =
			    SWITCH ( TRUE (), ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( _chg ),
			        "No data for this period",
			        _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & " " & [Deductions_G&D] & " · " & [Periodic_text]
			    )
		displayFolder: 03 Period Comparison\Deductions

	measure Net_curr =
			CALCULATE ( [Net], 'Period Calc'[Name] = "Current" )
		displayFolder: 03 Period Comparison\Net

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Net_prev =
			CALCULATE ( [Net], 'Period Calc'[Name] = "Previous" )
		displayFolder: 03 Period Comparison\Net

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Net_PnP =
			CALCULATE ( [Net], 'Period Calc'[Name] = "Change %" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Net

	measure 'Net_G&D' =
			CALCULATE ( [Net], 'Period Calc'[Name] = "Trend" )
		displayFolder: 03 Period Comparison\Net

	measure Net_colour =
			-- Up is good
			VAR _chg = [Net_PnP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _chg ) || ROUND ( _chg, 4 ) = 0, "#C98A00",
			        _chg > 0, "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 03 Period Comparison\Net

	measure Net_change_text =
			-- e.g. "▲ 8.9% Growth · vs Mar 2026"
			VAR _chg = [Net_PnP]
			VAR _mark =
			    SWITCH ( TRUE (), ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( _chg ),
			        "No data for this period",
			        _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & " " & [Net_G&D] & " · " & [Periodic_text]
			    )
		displayFolder: 03 Period Comparison\Net

	measure FX_rate_curr =
			CALCULATE ( [FX_rate_avg], 'Period Calc'[Name] = "Current" )
		formatString: ₦#,0.00
		displayFolder: 03 Period Comparison\FX_rate

	measure FX_rate_prev =
			CALCULATE ( [FX_rate_avg], 'Period Calc'[Name] = "Previous" )
		formatString: ₦#,0.00
		displayFolder: 03 Period Comparison\FX_rate

	measure FX_rate_PnP =
			CALCULATE ( [FX_rate_avg], 'Period Calc'[Name] = "Change %" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\FX_rate

	measure 'FX_rate_G&D' =
			CALCULATE ( [FX_rate_avg], 'Period Calc'[Name] = "Trend" )
		displayFolder: 03 Period Comparison\FX_rate

	measure FX_rate_colour =
			-- Up is bad (a higher rate means a weaker naira)
			VAR _chg = [FX_rate_PnP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _chg ) || ROUND ( _chg, 4 ) = 0, "#C98A00",
			        _chg < 0, "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 03 Period Comparison\FX_rate

	measure FX_rate_change_text =
			-- e.g. "▲ 8.9% Growth · vs Mar 2026"
			VAR _chg = [FX_rate_PnP]
			VAR _mark =
			    SWITCH ( TRUE (), ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( _chg ),
			        "No data for this period",
			        _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & " " & [FX_rate_G&D] & " · " & [Periodic_text]
			    )
		displayFolder: 03 Period Comparison\FX_rate

	measure Metric_value_curr =
			CALCULATE ( [Metric_value], 'Period Calc'[Name] = "Current" )
		displayFolder: 03 Period Comparison\Metric (tooltip)

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Metric_value_prev =
			CALCULATE ( [Metric_value], 'Period Calc'[Name] = "Previous" )
		displayFolder: 03 Period Comparison\Metric (tooltip)

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Metric_value_PnP =
			CALCULATE ( [Metric_value], 'Period Calc'[Name] = "Change %" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Metric (tooltip)

	measure 'Metric_value_G&D' =
			CALCULATE ( [Metric_value], 'Period Calc'[Name] = "Trend" )
		displayFolder: 03 Period Comparison\Metric (tooltip)

	measure Metric_value_colour =
			-- Income and net: up is good. Deductions: up is bad. No change: amber.
			VAR _chg = [Metric_value_PnP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _chg ) || ROUND ( _chg, 4 ) = 0, "#C98A00",
			        ( _chg > 0 ) = ( SELECTEDVALUE ( Metric_param[Metric_family] ) <> "Deduction" ), "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 03 Period Comparison\Metric (tooltip)

	measure Metric_change_text =
			-- e.g. "▲ 8.9% Growth · vs Mar 2026"
			VAR _chg = [Metric_value_PnP]
			VAR _mark =
			    SWITCH ( TRUE (), ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( _chg ),
			        "No data for this period",
			        _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & " " & [Metric_value_G&D] & " · " & [Periodic_text]
			    )
		displayFolder: 03 Period Comparison\Metric (tooltip)

	measure Side_A_label =
			SELECTEDVALUE ( Compare_A[member], "Pick side A" )
		displayFolder: 04 Comparison\Sides

	measure Side_B_label =
			SELECTEDVALUE ( Compare_B[member], "Pick side B" )
		displayFolder: 04 Comparison\Sides

	measure Side_A_meta =
			-- e.g. "APC · 96 months · 36 states"
			VAR _by = SELECTEDVALUE ( Compare_By[compare_by], "Administration" )
			VAR _months = CALCULATE ( [Months], 'Compare Side'[Name] = "A" )
			VAR _states = CALCULATE ( [States], 'Compare Side'[Name] = "A" )
			VAR _party =
			    IF (
			        _by = "Administration",
			        LOOKUPVALUE ( dim_administration[party], dim_administration[president], [Side_A_label] ) & " · "
			    )
			RETURN
			    IF (
			        ISBLANK ( _months ),
			        "No data",
			        _party & _months & IF ( _months = 1, " month", " months" ) & " · "
			            & _states & IF ( _states = 1, " state", " states" )
			    )
		displayFolder: 04 Comparison\Sides

	measure Side_B_meta =
			-- e.g. "APC · 96 months · 36 states"
			VAR _by = SELECTEDVALUE ( Compare_By[compare_by], "Administration" )
			VAR _months = CALCULATE ( [Months], 'Compare Side'[Name] = "B" )
			VAR _states = CALCULATE ( [States], 'Compare Side'[Name] = "B" )
			VAR _party =
			    IF (
			        _by = "Administration",
			        LOOKUPVALUE ( dim_administration[party], dim_administration[president], [Side_B_label] ) & " · "
			    )
			RETURN
			    IF (
			        ISBLANK ( _months ),
			        "No data",
			        _party & _months & IF ( _months = 1, " month", " months" ) & " · "
			            & _states & IF ( _states = 1, " state", " states" )
			    )
		displayFolder: 04 Comparison\Sides

	measure Side_A_total =
			-- Side A's total for the metric picked in Metric_param. Ignores Basis on purpose:
			-- callers read the Basis slicer themselves and divide.
			CALCULATE ( [Metric_value], 'Compare Side'[Name] = "A", REMOVEFILTERS ( Basis[Basis] ) )
		displayFolder: 04 Comparison\Sides

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Side_B_total =
			-- Side B's total for the metric picked in Metric_param. Ignores Basis on purpose:
			-- callers read the Basis slicer themselves and divide.
			CALCULATE ( [Metric_value], 'Compare Side'[Name] = "B", REMOVEFILTERS ( Basis[Basis] ) )
		displayFolder: 04 Comparison\Sides

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Side_A_months =
			CALCULATE ( [Months], 'Compare Side'[Name] = "A", REMOVEFILTERS ( Basis[Basis] ) )
		formatString: #,0
		displayFolder: 04 Comparison\Sides

	measure Side_B_months =
			CALCULATE ( [Months], 'Compare Side'[Name] = "B", REMOVEFILTERS ( Basis[Basis] ) )
		formatString: #,0
		displayFolder: 04 Comparison\Sides

	measure Side_A_state_months =
			CALCULATE ( [State_months], 'Compare Side'[Name] = "A", REMOVEFILTERS ( Basis[Basis] ) )
		formatString: #,0
		displayFolder: 04 Comparison\Sides

	measure Side_B_state_months =
			CALCULATE ( [State_months], 'Compare Side'[Name] = "B", REMOVEFILTERS ( Basis[Basis] ) )
		formatString: #,0
		displayFolder: 04 Comparison\Sides

	measure Side_A_value =
			-- Side A's value of the metric picked in Metric_param, on the selected Basis.
			-- Put it directly in a visual; inside another measure it can't see the Basis slicer.
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a =
			    DIVIDE (
			        CALCULATE ( [Side_A_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 )
			    )
			VAR _b =
			    DIVIDE (
			        CALCULATE ( [Side_B_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 )
			    )
			RETURN
			    _a
		displayFolder: 04 Comparison\Sides

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Side_B_value =
			-- Side B's value of the metric picked in Metric_param, on the selected Basis.
			-- Put it directly in a visual; inside another measure it can't see the Basis slicer.
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a =
			    DIVIDE (
			        CALCULATE ( [Side_A_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 )
			    )
			VAR _b =
			    DIVIDE (
			        CALCULATE ( [Side_B_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 )
			    )
			RETURN
			    _b
		displayFolder: 04 Comparison\Sides

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Compare_valid =
			-- Warning text when both sides are the same; blank otherwise
			VAR _by = SELECTEDVALUE ( Compare_By[compare_by], "Administration" )
			RETURN
			    IF (
			        NOT ISBLANK ( SELECTEDVALUE ( Compare_A[member] ) )
			            && SELECTEDVALUE ( Compare_A[member] ) = SELECTEDVALUE ( Compare_B[member] ),
			        "Pick two different " & LOWER ( _by ) & "s to compare."
			    )
		displayFolder: 04 Comparison\Sides

	measure Metric_A_colour =
			-- Green if Side A is better, red if worse, amber if equal. For deductions, higher is worse.
			VAR _fam = SELECTEDVALUE ( Metric_param[Metric_family] )
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a =
			    DIVIDE (
			        CALCULATE ( [Side_A_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 )
			    )
			VAR _b =
			    DIVIDE (
			        CALCULATE ( [Side_B_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 )
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _a ) || ISBLANK ( _b ), "#6B7C73",
			        ROUND ( _a, 0 ) = ROUND ( _b, 0 ), "#C98A00",
			        ( _a > _b ) = ( _fam <> "Deduction" ), "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 04 Comparison\Colours

	measure Metric_B_colour =
			-- Green if Side B is better, red if worse, amber if equal. For deductions, higher is worse.
			VAR _fam = SELECTEDVALUE ( Metric_param[Metric_family] )
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a =
			    DIVIDE (
			        CALCULATE ( [Side_A_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 )
			    )
			VAR _b =
			    DIVIDE (
			        CALCULATE ( [Side_B_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 )
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _a ) || ISBLANK ( _b ), "#6B7C73",
			        ROUND ( _a, 0 ) = ROUND ( _b, 0 ), "#C98A00",
			        ( _b > _a ) = ( _fam <> "Deduction" ), "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 04 Comparison\Colours

	measure Last_6_Period_flag =
			-- 1 for the 6 months up to the latest month with data (sparklines, tooltip trends)
			VAR _last = [Latest_month]
			VAR _m = MAX ( calendar_table[month_date] )
			RETURN
			    IF ( _m <= EOMONTH ( _last, 0 ) && _m > EOMONTH ( _last, -6 ), 1, 0 )
		formatString: 0
		displayFolder: 05 Visual Helpers\Sparklines

	measure Last_24_month_flag =
			-- 1 for the 24 months up to the latest month with data (Overview trend)
			VAR _last = [Latest_month]
			VAR _m = MAX ( calendar_table[month_date] )
			RETURN
			    IF ( _m <= EOMONTH ( _last, 0 ) && _m > EOMONTH ( _last, -24 ), 1, 0 )
		formatString: 0
		displayFolder: 05 Visual Helpers\Sparklines

	measure Trend_title =
			"Gross allocation and net received, last 24 months · " & [Area_label]
		displayFolder: 06 Titles & Labels\Titles

	measure Mix_title =
			"Revenue mix · " & [Period_label]
		displayFolder: 06 Titles & Labels\Titles

	measure Top5_title =
			"Top 5 states by net received · " & [Period_label]
		displayFolder: 06 Titles & Labels\Titles

	measure Map_title =
			"Net received by state · " & [Period_label]
		displayFolder: 06 Titles & Labels\Titles

	measure Ranking_title =
			"States ranked by net received · " & [Period_label]
		displayFolder: 06 Titles & Labels\Titles

	measure Oil_title =
			"Oil derivation by state · " & [Period_label]
		displayFolder: 06 Titles & Labels\Titles

	measure Period_label =
			-- The current period in words: "Apr 2026", "Q2 2026 to date", "2026 to date"
			VAR _last = [Latest_month]
			RETURN
			    SWITCH (
			        SWITCH ( SELECTEDVALUE ( Period[Period Order] ), 1, "Quarterly", 2, "Yearly", "Monthly" ),
			        "Quarterly", "Q" & QUARTER ( _last ) & " " & YEAR ( _last ) & " to date",
			        "Yearly", YEAR ( _last ) & " to date",
			        FORMAT ( _last, "mmm yyyy" )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Periodic_text =
			-- What "previous" means: "vs Mar 2026", "vs Q2 2025 (to date)", "vs Jan–Apr 2025"
			VAR _last = [Latest_month]
			VAR _py = YEAR ( _last ) - 1
			RETURN
			    SWITCH (
			        SWITCH ( SELECTEDVALUE ( Period[Period Order] ), 1, "Quarterly", 2, "Yearly", "Monthly" ),
			        "Quarterly", "vs Q" & QUARTER ( _last ) & " " & _py & " (to date)",
			        "Yearly",
			            "vs "
			                & IF (
			                    MONTH ( _last ) = 1,
			                    "Jan " & _py,
			                    "Jan–" & FORMAT ( DATE ( _py, MONTH ( _last ), 1 ), "mmm yyyy" )
			                ),
			        "vs " & FORMAT ( EDATE ( _last, -1 ), "mmm yyyy" )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Area_label =
			SWITCH (
			    TRUE (),
			    HASONEVALUE ( dim_state[state] ), VALUES ( dim_state[state] ),
			    HASONEVALUE ( dim_state[zone] ), VALUES ( dim_state[zone] ),
			    HASONEVALUE ( dim_state[region] ), VALUES ( dim_state[region] ),
			    "All states"
			)
		displayFolder: 06 Titles & Labels\Text

	measure Currency_label =
			IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "US dollars", "naira" )
		displayFolder: 06 Titles & Labels\Text

	measure Basis_label =
			SELECTEDVALUE ( Basis[Basis], "Total" ) & ", " & [Currency_label]
		displayFolder: 06 Titles & Labels\Text

	measure Refresh_text =
			"Updated " & FORMAT ( MAX ( 'Refresh Time'[refreshed_at] ), "dd-mmm-yy | hh:mm" ) & " Lagos"
			    & UNICHAR ( 10 ) & "FAAC data to " & FORMAT ( [Latest_month], "mmm yyyy" )
		displayFolder: 06 Titles & Labels\Text

	measure Comparison_narrative =
			-- e.g. "Under Tinubu, states were allocated ₦607.0bn a month on average, 2.3× as much as
			-- under Buhari (₦265.3bn). Deductions took 9.8% of gross under Tinubu and 12.3% under Buhari."
			VAR _by = SELECTEDVALUE ( Compare_By[compare_by], "Administration" )
			VAR _na = [Side_A_label]
			VAR _nb = [Side_B_label]
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a =
			    DIVIDE (
			        CALCULATE ( [Side_A_total], Metric_param[Metric_key] = "Gross" ),
			        SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 )
			    )
			VAR _b =
			    DIVIDE (
			        CALCULATE ( [Side_B_total], Metric_param[Metric_key] = "Gross" ),
			        SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 )
			    )
			-- A share within one side: the basis divisor cancels, so totals are enough
			VAR _da =
			    DIVIDE (
			        CALCULATE ( [Side_A_total], Metric_param[Metric_key] = "Deductions" ),
			        CALCULATE ( [Side_A_total], Metric_param[Metric_key] = "Gross" )
			    )
			VAR _db =
			    DIVIDE (
			        CALCULATE ( [Side_B_total], Metric_param[Metric_key] = "Deductions" ),
			        CALCULATE ( [Side_B_total], Metric_param[Metric_key] = "Gross" )
			    )
			VAR _per =
			    SWITCH (
			        _basis,
			        "Monthly average", " a month on average",
			        "Per state per month", " per state per month",
			        " in total"
			    )
			VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _fa =
			    _s
			        & SWITCH (
			            TRUE (),
			            ABS ( _a ) >= 1e12, FORMAT ( _a / 1e12, "#,0.0" ) & "tn",
			            ABS ( _a ) >= 1e9, FORMAT ( _a / 1e9, "#,0.0" ) & "bn",
			            ABS ( _a ) >= 1e6, FORMAT ( _a / 1e6, "#,0.0" ) & "m",
			            FORMAT ( _a, "#,0" )
			        )
			VAR _fb =
			    _s
			        & SWITCH (
			            TRUE (),
			            ABS ( _b ) >= 1e12, FORMAT ( _b / 1e12, "#,0.0" ) & "tn",
			            ABS ( _b ) >= 1e9, FORMAT ( _b / 1e9, "#,0.0" ) & "bn",
			            ABS ( _b ) >= 1e6, FORMAT ( _b / 1e6, "#,0.0" ) & "m",
			            FORMAT ( _b, "#,0" )
			        )
			VAR _subject =
			    SWITCH (
			        _by,
			        "Administration", "Under " & _nb & ", states were allocated ",
			        "State", _nb & " was allocated ",
			        "States in the " & _nb & " were allocated "
			    )
			VAR _ref = SWITCH ( _by, "Administration", "under " & _na, "State", _na, "states in the " & _na )
			VAR _in = IF ( _by = "Administration", "under ", "in " )
			VAR _r = DIVIDE ( _b, _a )
			VAR _cmp =
			    SWITCH (
			        TRUE (),
			        ROUND ( _r, 3 ) = 1, "the same as " & _ref,
			        _r >= 1.5, FORMAT ( _r, "0.0" ) & "× as much as " & _ref,
			        _r > 1, FORMAT ( _r - 1, "0%" ) & " more than " & _ref,
			        FORMAT ( 1 - _r, "0%" ) & " less than " & _ref
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( [Compare_valid] ), [Compare_valid],
			        ISBLANK ( _a ) || ISBLANK ( _b ), "Pick " & IF ( _by = "Administration", "an ", "a " ) & LOWER ( _by ) & " for each side.",
			        _subject & _fb & _per & ", " & _cmp & " (" & _fa & "). "
			            & "Deductions took " & FORMAT ( _db, "0.0%" ) & " of gross " & _in & _nb
			            & " and " & FORMAT ( _da, "0.0%" ) & " " & _in & _na & "."
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Metric_definition =
			-- Plain-language explanation of the hovered metric, keyed on Metric_key
			VAR _k = SELECTEDVALUE ( Metric_param[Metric_key] )
			RETURN
			    SWITCH (
			        _k,
			        "Gross", "Everything the state was allocated at the monthly FAAC sharing, before deductions: statutory allocation, VAT, oil derivation, exchange gain, ecology fund and other income.",
			        "Statutory", "The state's share of the Federation Account, the pool of federally collected revenue such as oil and gas earnings, company income tax and customs duties. States split it using the revenue allocation formula, which weighs equality, population, land mass and other factors.",
			        "VAT", "The state's share of Value Added Tax collected nationwide. VAT is pooled and split between the federal government, states and local governments, then among states partly equally and partly by population and where the tax was generated.",
			        "Oil_Derivation", "Extra money for oil- and gas-producing states: at least 13% of revenue from natural resources goes back to the states that produce them (Constitution, s.162(2)). Most states receive none.",
			        "Exchange_Gain", "The state's share of the extra naira the Federation Account earns when dollar revenue is converted at a weaker naira rate than the budget assumed. Only paid in some months.",
			        "Ecology", "The state's share of the Ecological Fund, set aside from the Federation Account for problems such as erosion, flooding and desertification.",
			        "Others_Income", "Smaller or one-off revenue lines that the FAAC report groups as ""Others"".",
			        "Deductions", "Money taken from the state's allocation at source, before payment, mostly to repay debts and meet commitments the state has signed up to.",
			        "External_Debt", "Repayments on the state's foreign loans (for example from the World Bank), deducted at source by the federal government.",
			        "Contractual_Obligation", "Irrevocable Standing Payment Orders (ISPOs): payments the state committed to in advance, usually for bank loans, bonds or contracts, deducted automatically each month.",
			        "NDDC_Transfer", "Half of the ecological fund due to member states, transferred by law to the Niger Delta Development Commission (NDDC) or the Hydroelectric Power Producing Areas Development Commission (HYPPADEC).",
			        "Other_Deductions_Note", "Other deductions that the FAAC report explains in its notes, often repayments of federal loans to states such as budget support or bailout facilities.",
			        "Deduction_Misc", "A deduction shown in the FAAC report under a column headed only ""Deduction"", with no further detail.",
			        "Other_Deduction", "Smaller deductions that the FAAC report groups as ""Others"".",
			        "Net", "What the state actually received: gross allocation minus deductions.",
			        "Hover a metric to see what it means."
			    )
		displayFolder: 06 Titles & Labels\Tooltips

	measure FX_rate_definition =
			"The month's average official naira-per-dollar rate (World Bank). Each month's naira amounts are converted at that month's own rate."
		displayFolder: 06 Titles & Labels\Tooltips

	measure Deductions_share_definition =
			"The share of the gross allocation taken as deductions."
		displayFolder: 06 Titles & Labels\Tooltips

	measure Net_share_definition =
			"The state's share of the net received by all 36 states."
		displayFolder: 06 Titles & Labels\Tooltips

	measure Metric_tooltip_title =
			UPPER ( SELECTEDVALUE ( Metric_param[Metric_label], "Metric" ) & " · " & [Area_label] )
		displayFolder: 06 Titles & Labels\Tooltips

	measure Metric_tooltip_subtitle =
			[Period_label] & " · " & [Currency_label]
		displayFolder: 06 Titles & Labels\Tooltips

	measure Metric_tooltip_summary =
			-- e.g. "Oil derivation was ₦18.4bn in Apr 2026, up 8.9% vs Mar 2026."
			VAR _name = SELECTEDVALUE ( Metric_param[Metric_label], "This metric" )
			VAR _v = [Metric_value_curr]
			VAR _chg = [Metric_value_PnP]
			VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _amount =
			    _s
			        & SWITCH (
			            TRUE (),
			            ABS ( _v ) >= 1e12, FORMAT ( _v / 1e12, "#,0.0" ) & "tn",
			            ABS ( _v ) >= 1e9, FORMAT ( _v / 1e9, "#,0.0" ) & "bn",
			            ABS ( _v ) >= 1e6, FORMAT ( _v / 1e6, "#,0.0" ) & "m",
			            FORMAT ( _v, "#,0" )
			        )
			VAR _move =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _chg ), "",
			        ROUND ( _chg, 4 ) = 0, ", unchanged " & [Periodic_text],
			        ", " & IF ( _chg > 0, "up ", "down " ) & FORMAT ( ABS ( _chg ), "0.0%" ) & " " & [Periodic_text]
			    )
			RETURN
			    IF (
			        ISBLANK ( _v ),
			        "No data for this period.",
			        _name & " was " & _amount & " in " & [Period_label] & _move & "."
			    )
		displayFolder: 06 Titles & Labels\Tooltips

	measure State_tooltip_title =
			UPPER ( SELECTEDVALUE ( dim_state[state] ) )
		displayFolder: 06 Titles & Labels\Tooltips

	measure State_tooltip_subtitle =
			-- "South South · South · Rank 2 of 36 by net". Ranked against every state, even with a Zone filter.
			VAR _net = [Net_curr]
			VAR _rank =
			    CALCULATE (
			        RANKX ( VALUES ( dim_state[state] ), [Net_curr], _net, DESC ),
			        REMOVEFILTERS ( dim_state )
			    )
			VAR _n =
			    CALCULATE (
			        COUNTROWS ( FILTER ( VALUES ( dim_state[state] ), NOT ISBLANK ( [Net_curr] ) ) ),
			        REMOVEFILTERS ( dim_state )
			    )
			RETURN
			    SELECTEDVALUE ( dim_state[zone] ) & " · " & SELECTEDVALUE ( dim_state[region] )
			        & " · Rank " & _rank & " of " & _n & " by net"
		displayFolder: 06 Titles & Labels\Tooltips

	measure Compare_tooltip_title =
			UPPER ( SELECTEDVALUE ( Metric_param[Metric_label], "Metric" ) ) & " · " & [Basis_label]
		displayFolder: 06 Titles & Labels\Tooltips

	measure Compare_tooltip_text =
			-- "▲ Tinubu 185.0% higher than Buhari", coloured with Metric_B_colour
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a =
			    DIVIDE (
			        CALCULATE ( [Side_A_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 )
			    )
			VAR _b =
			    DIVIDE (
			        CALCULATE ( [Side_B_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 )
			    )
			VAR _d = DIVIDE ( _b - _a, _a )
			VAR _mark =
			    SWITCH ( TRUE (), ROUND ( _d, 4 ) = 0, UNICHAR ( 9632 ), _d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _a ) || ISBLANK ( _b ), "No data for one side.",
			        ROUND ( _d, 4 ) = 0, _mark & " " & [Side_B_label] & " and " & [Side_A_label] & " are equal",
			        _mark & " " & [Side_B_label] & " " & FORMAT ( ABS ( _d ), "0.0%" )
			            & IF ( _d > 0, " higher", " lower" ) & " than " & [Side_A_label]
			    )
		displayFolder: 06 Titles & Labels\Tooltips

	measure State_share_text =
			-- e.g. "Share of national net: 7.6%"
			"Share of national net: " & FORMAT ( [Net_share_national], "0.0%" )
		displayFolder: 06 Titles & Labels\Tooltips

	measure Naira_per_usd =
			-- Official naira per US dollar, averaged over the months in the selection
			AVERAGE ( econ_month[naira_per_usd] )
		formatString: ₦#,0.00
		displayFolder: 01 Base\Economy

	measure CPI_index =
			-- World Bank consumer price index (only ratios between months mean anything)
			AVERAGE ( econ_month[cpi_index] )
		formatString: #,0.0
		displayFolder: 01 Base\Economy

	measure GDP_naira =
			SUM ( econ_year[gdp_naira] )
		formatString: ₦#,0
		displayFolder: 01 Base\Economy

	measure GDP_usd =
			-- Moves with the exchange rate, so it can fall while the economy grows
			SUM ( econ_year[gdp_usd] )
		formatString: $#,0
		displayFolder: 01 Base\Economy

	measure Population =
			-- Averaged, not summed: a population isn't added up across years
			AVERAGE ( econ_year[population] )
		formatString: #,0
		displayFolder: 01 Base\Economy

	measure Inflation_yoy =
			-- Prices vs the same month a year earlier. Over several months: the average monthly rate
			AVERAGE ( econ_month[inflation_yoy] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Economy

	measure Naira_value_change_yoy =
			-- What a naira buys in dollars vs a year earlier. Negative = the naira lost value
			AVERAGE ( econ_month[naira_value_change_yoy] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Economy

	measure Real_GDP_growth =
			-- Growth after inflation. Over several years: the average yearly rate
			AVERAGE ( econ_year[real_gdp_growth] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Economy

	measure GDP_per_person_usd =
			DIVIDE ( SUM ( econ_year[gdp_usd] ), SUM ( econ_year[population] ) )
		formatString: $#,0
		displayFolder: 02 Rates & Averages\Economy

	measure GDP_per_person_naira =
			DIVIDE ( SUM ( econ_year[gdp_naira] ), SUM ( econ_year[population] ) )
		formatString: ₦#,0
		displayFolder: 02 Rates & Averages\Economy

	measure Inflation_latest_month =
			-- Latest month in the selection with an inflation figure
			CALCULATE ( MAX ( econ_month[month_date] ), NOT ISBLANK ( econ_month[inflation_yoy] ) )
		formatString: mmm yyyy
		displayFolder: 03 Period Comparison\Inflation

	measure Inflation_latest =
			VAR _m = [Inflation_latest_month]
			RETURN
			    CALCULATE ( [Inflation_yoy], econ_month[month_date] = _m )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Inflation

	measure Inflation_prev =
			-- The month before the latest one, even if it falls outside the selection
			VAR _m = [Inflation_latest_month]
			RETURN
			    CALCULATE ( [Inflation_yoy], REMOVEFILTERS ( econ_month ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_month[month_date] = EDATE ( _m, -1 ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Inflation

	measure Inflation_change_text =
			-- e.g. "▼ 0.4 pp vs Jun 2026" (percentage points: the gap between two rates)
			VAR _d = [Inflation_latest] - [Inflation_prev]
			VAR _mark = SWITCH ( TRUE (), ROUND ( _d, 4 ) = 0, UNICHAR ( 9632 ), _d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( [Inflation_prev] ),
			        "No earlier month",
			        _mark & " " & FORMAT ( ABS ( _d ) * 100, "0.0" ) & " pp vs "
			            & FORMAT ( EDATE ( [Inflation_latest_month], -1 ), "mmm yyyy" )
			    )
		displayFolder: 03 Period Comparison\Inflation

	measure Inflation_colour =
			-- Falling inflation is good
			VAR _d = [Inflation_latest] - [Inflation_prev]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( [Inflation_prev] ) || ROUND ( _d, 4 ) = 0, "#C98A00", _d < 0, "#0E8A5F", "#C93C3C" )
		displayFolder: 03 Period Comparison\Inflation

	measure Naira_latest_month =
			CALCULATE ( MAX ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
		formatString: mmm yyyy
		displayFolder: 03 Period Comparison\Naira

	measure Naira_latest =
			VAR _m = [Naira_latest_month]
			RETURN
			    CALCULATE ( [Naira_per_usd], econ_month[month_date] = _m )
		formatString: ₦#,0.00
		displayFolder: 03 Period Comparison\Naira

	measure Naira_change_latest =
			-- Change in the naira's value over the year to the latest month
			VAR _m = [Naira_latest_month]
			RETURN
			    CALCULATE ( [Naira_value_change_yoy], econ_month[month_date] = _m )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Naira

	measure Naira_change_text =
			-- e.g. "▲ 13.2% stronger vs Aug 2025"
			VAR _c = [Naira_change_latest]
			VAR _mark = SWITCH ( TRUE (), ROUND ( _c, 4 ) = 0, UNICHAR ( 9632 ), _c > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( _c ),
			        "No year-earlier month",
			        _mark & " " & FORMAT ( ABS ( _c ), "0.0%" ) & IF ( _c >= 0, " stronger", " weaker" ) & " vs "
			            & FORMAT ( EDATE ( [Naira_latest_month], -12 ), "mmm yyyy" )
			    )
		displayFolder: 03 Period Comparison\Naira

	measure Naira_colour =
			-- A stronger naira is good
			VAR _c = [Naira_change_latest]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _c ) || ROUND ( _c, 4 ) = 0, "#C98A00", _c > 0, "#0E8A5F", "#C93C3C" )
		displayFolder: 03 Period Comparison\Naira

	measure GDP_latest_year =
			-- Latest year in the selection with GDP data
			CALCULATE ( MAX ( econ_year[year] ), NOT ISBLANK ( econ_year[gdp_naira] ) )
		formatString: 0
		displayFolder: 03 Period Comparison\GDP

	measure Growth_latest =
			VAR _y = [GDP_latest_year]
			RETURN
			    CALCULATE ( [Real_GDP_growth], econ_year[year] = _y )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\GDP

	measure GDP_naira_latest =
			VAR _y = [GDP_latest_year]
			RETURN
			    CALCULATE ( [GDP_naira], econ_year[year] = _y )
		formatString: ₦#,0
		displayFolder: 03 Period Comparison\GDP

	measure GDP_usd_latest =
			VAR _y = [GDP_latest_year]
			RETURN
			    CALCULATE ( [GDP_usd], econ_year[year] = _y )
		formatString: $#,0
		displayFolder: 03 Period Comparison\GDP

	measure GDP_per_person_usd_latest =
			VAR _y = [GDP_latest_year]
			RETURN
			    CALCULATE ( [GDP_per_person_usd], econ_year[year] = _y )
		formatString: $#,0
		displayFolder: 03 Period Comparison\GDP

	measure GDP_per_person_naira_latest =
			VAR _y = [GDP_latest_year]
			RETURN
			    CALCULATE ( [GDP_per_person_naira], econ_year[year] = _y )
		formatString: ₦#,0
		displayFolder: 03 Period Comparison\GDP

	measure Growth_prev =
			-- The year before the latest one, even if it falls outside the selection
			VAR _y = [GDP_latest_year]
			RETURN
			    CALCULATE ( [Real_GDP_growth], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _y - 1 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\GDP

	measure Growth_change_text =
			-- e.g. "▼ 0.1 pp vs 2024"
			VAR _d = [Growth_latest] - [Growth_prev]
			VAR _mark = SWITCH ( TRUE (), ROUND ( _d, 4 ) = 0, UNICHAR ( 9632 ), _d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( [Growth_prev] ),
			        "No earlier year",
			        _mark & " " & FORMAT ( ABS ( _d ) * 100, "0.0" ) & " pp vs " & ( [GDP_latest_year] - 1 )
			    )
		displayFolder: 03 Period Comparison\GDP

	measure Growth_colour =
			-- Faster growth is good
			VAR _d = [Growth_latest] - [Growth_prev]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( [Growth_prev] ) || ROUND ( _d, 4 ) = 0, "#C98A00", _d > 0, "#0E8A5F", "#C93C3C" )
		displayFolder: 03 Period Comparison\GDP

	measure Term_naira_change =
			-- What a naira buys in dollars at the end of the selection vs its start, e.g. -0.56 = lost 56%.
			-- For a president: first month in office to last (or latest) month.
			VAR _first = CALCULATE ( MIN ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
			VAR _last = CALCULATE ( MAX ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
			VAR _r1 = CALCULATE ( [Naira_per_usd], econ_month[month_date] = _first )
			VAR _r2 = CALCULATE ( [Naira_per_usd], econ_month[month_date] = _last )
			RETURN
			    IF ( _first < _last, DIVIDE ( _r1, _r2 ) - 1 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Administration

	measure Term_months =
			-- Months with exchange rate data in the selection
			CALCULATE ( COUNTROWS ( econ_month ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
		formatString: #,0
		displayFolder: 03 Period Comparison\Administration

	measure Term_coverage_text =
			-- Says when the data covers only part of a term. Disappears once older data is backfilled.
			VAR _start = SELECTEDVALUE ( dim_administration[first_disbursement_month] )
			VAR _next =
			    CALCULATE (
			        MIN ( dim_administration[first_disbursement_month] ),
			        REMOVEFILTERS ( dim_administration ),
			        dim_administration[first_disbursement_month] > _start
			    )
			VAR _first = CALCULATE ( MIN ( econ_month[month_date] ) )
			VAR _last = CALCULATE ( MAX ( econ_month[month_date] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _start ), BLANK (),
			        ISBLANK ( _first ), "No monthly data for this term yet",
			        _first > _start,
			            "Monthly data covers " & FORMAT ( _first, "mmm yyyy" ) & " to " & FORMAT ( _last, "mmm yyyy" ) & " only",
			        ISBLANK ( _next ), "Term in progress: to " & FORMAT ( _last, "mmm yyyy" ),
			        BLANK ()
			    )
		displayFolder: 03 Period Comparison\Administration

	measure Price_base_month =
			-- The prices "Today's prices" uses: the latest FAAC month that has a CPI figure
			VAR _faac_last = CALCULATE ( MAX ( faac[disbursement_date] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE (
			        MAX ( econ_month[month_date] ),
			        REMOVEFILTERS (),
			        NOT ISBLANK ( econ_month[cpi_index] ),
			        econ_month[month_date] <= _faac_last
			    )
		formatString: mmm yyyy
		displayFolder: 01 Base\Real terms

	measure Net_paid =
			-- Net FAAC received, in naira as paid. Ignores the ₦/$ switch: CPI measures naira prices.
			SUM ( faac[net_amount_after_deductions] )
		formatString: ₦#,0
		displayFolder: 01 Base\Real terms

	measure Net_today_prices =
			-- Each month's net restated in the base month's prices: net × (base CPI ÷ that month's CPI).
			-- Adjusted month by month and then added, so every month uses its own price level.
			-- Months with no CPI yet are left out (blank), never shown as paid.
			VAR _base = [Price_base_month]
			VAR _base_cpi = CALCULATE ( MAX ( econ_month[cpi_index] ), REMOVEFILTERS (), econ_month[month_date] = _base )
			RETURN
			    SUMX (
			        VALUES ( calendar_table[month_date] ),
			        VAR _net = CALCULATE ( SUM ( faac[net_amount_after_deductions] ) )
			        VAR _cpi = CALCULATE ( MAX ( econ_month[cpi_index] ) )
			        RETURN
			            IF ( NOT ISBLANK ( _net ) && NOT ISBLANK ( _cpi ), _net * DIVIDE ( _base_cpi, _cpi ) )
			    )
		formatString: ₦#,0
		displayFolder: 01 Base\Real terms

	measure Net_prices =
			-- Net in the prices picked on the Prices switch (Economy section)
			IF ( SELECTEDVALUE ( Prices[Prices], "As paid" ) = "Today's prices", [Net_today_prices], [Net_paid] )
		formatString: ₦#,0
		displayFolder: 01 Base\Real terms

	measure Real_terms_title =
			-- e.g. "Net FAAC received by states · in Apr 2026 prices"
			"Net FAAC received by states · "
			    & IF (
			        SELECTEDVALUE ( Prices[Prices], "As paid" ) = "Today's prices",
			        "in " & FORMAT ( [Price_base_month], "mmm yyyy" ) & " prices",
			        "as paid"
			    )
		displayFolder: 06 Titles & Labels\Titles

	measure Inflation_as_of_text =
			"Year to " & FORMAT ( [Inflation_latest_month], "mmm yyyy" ) & " · World Bank"
		displayFolder: 06 Titles & Labels\Text

	measure Naira_as_of_text =
			"Naira per US dollar · " & FORMAT ( [Naira_latest_month], "mmm yyyy" ) & " · World Bank"
		displayFolder: 06 Titles & Labels\Text

	measure GDP_as_of_text =
			[GDP_latest_year] & " · World Bank"
		displayFolder: 06 Titles & Labels\Text

	measure Inflation_narrative =
			-- e.g. "Prices rose 15.4% in the year to Jul 2026, down from a peak of 34.2% in Jun 2024.
			-- A year earlier the rate was 22.2%."
			VAR _m = [Inflation_latest_month]
			VAR _v = [Inflation_latest]
			VAR _t =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( econ_month[month_date] ), "@i", CALCULATE ( [Inflation_yoy] ) ),
			        NOT ISBLANK ( [@i] )
			    )
			VAR _pk = TOPN ( 1, _t, [@i], DESC, econ_month[month_date], DESC )
			VAR _pk_m = MAXX ( _pk, econ_month[month_date] )
			VAR _pk_v = MAXX ( _pk, [@i] )
			VAR _ya = CALCULATE ( [Inflation_yoy], REMOVEFILTERS ( econ_month ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_month[month_date] = EDATE ( _m, -12 ) )
			RETURN
			    IF (
			        ISBLANK ( _v ),
			        "No inflation data for this selection.",
			        "Prices " & IF ( _v >= 0, "rose ", "fell " ) & FORMAT ( ABS ( _v ), "0.0%" ) & " in the year to "
			            & FORMAT ( _m, "mmm yyyy" )
			            & IF (
			                _pk_m = _m,
			                ", the highest rate in this period.",
			                ", down from a peak of " & FORMAT ( _pk_v, "0.0%" ) & " in " & FORMAT ( _pk_m, "mmm yyyy" ) & "."
			            )
			            & IF ( NOT ISBLANK ( _ya ), " A year earlier the rate was " & FORMAT ( _ya, "0.0%" ) & "." )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Naira_narrative =
			-- e.g. "₦1,354.97 bought one US dollar in Aug 2026. A naira buys 13.2% more dollars than a year
			-- earlier, but 88.9% fewer than in Jan 2010 (₦150.35)."
			VAR _m = [Naira_latest_month]
			VAR _r = [Naira_latest]
			VAR _c = [Naira_change_latest]
			VAR _first = CALCULATE ( MIN ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
			VAR _r1 = CALCULATE ( [Naira_per_usd], econ_month[month_date] = _first )
			VAR _since = DIVIDE ( _r1, _r ) - 1
			VAR _yr =
			    IF (
			        NOT ISBLANK ( _c ),
			        " A naira buys " & FORMAT ( ABS ( _c ), "0.0%" ) & IF ( _c >= 0, " more", " fewer" )
			            & " dollars than a year earlier"
			    )
			VAR _long =
			    IF (
			        _first < EDATE ( _m, -12 ),
			        IF ( ISBLANK ( _yr ), " A naira buys ", IF ( ( _c >= 0 ) = ( _since >= 0 ), ", and ", ", but " ) )
			            & FORMAT ( ABS ( _since ), "0.0%" ) & IF ( _since >= 0, " more", " fewer" )
			            & IF ( ISBLANK ( _yr ), " dollars", "" ) & " than in " & FORMAT ( _first, "mmm yyyy" )
			            & " (" & FORMAT ( _r1, "₦#,0.00" ) & ")"
			    )
			RETURN
			    IF (
			        ISBLANK ( _r ),
			        "No exchange rate data for this selection.",
			        FORMAT ( _r, "₦#,0.00" ) & " bought one US dollar in " & FORMAT ( _m, "mmm yyyy" ) & "." & _yr & _long
			            & IF ( NOT ISBLANK ( _yr ) || NOT ISBLANK ( _long ), "." )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure GDP_narrative =
			-- e.g. "The economy grew 4.0% after inflation in 2025, to ₦441.5tn. In dollars it was $291.0bn,
			-- 51% below its 2020 peak of $599.0bn: the naira lost value, the economy didn't shrink."
			VAR _y = [GDP_latest_year]
			VAR _g = [Growth_latest]
			VAR _n = [GDP_naira_latest]
			VAR _u = [GDP_usd_latest]
			VAR _t = ADDCOLUMNS ( VALUES ( econ_year[year] ), "@u", CALCULATE ( [GDP_usd] ) )
			VAR _pk = TOPN ( 1, _t, [@u], DESC, econ_year[year], DESC )
			VAR _pk_y = MAXX ( _pk, econ_year[year] )
			VAR _pk_u = MAXX ( _pk, [@u] )
			VAR _pk_n = CALCULATE ( [GDP_naira], econ_year[year] = _pk_y )
			RETURN
			    IF (
			        ISBLANK ( _n ),
			        "No GDP data for this selection.",
			        "The economy " & IF ( _g >= 0, "grew ", "shrank " ) & FORMAT ( ABS ( _g ), "0.0%" )
			            & " after inflation in " & _y & ", to " & "₦" & SWITCH ( TRUE (), ABS ( _n ) >= 1e12, FORMAT ( _n / 1e12, "#,0.0" ) & "tn", FORMAT ( _n / 1e9, "#,0.0" ) & "bn" ) & ". "
			            & IF (
			                _pk_y = _y,
			                "In dollars it was " & "$" & SWITCH ( TRUE (), ABS ( _u ) >= 1e12, FORMAT ( _u / 1e12, "#,0.0" ) & "tn", FORMAT ( _u / 1e9, "#,0.0" ) & "bn" ) & ", the highest in this period.",
			                "In dollars it was " & "$" & SWITCH ( TRUE (), ABS ( _u ) >= 1e12, FORMAT ( _u / 1e12, "#,0.0" ) & "tn", FORMAT ( _u / 1e9, "#,0.0" ) & "bn" ) & ", " & FORMAT ( 1 - DIVIDE ( _u, _pk_u ), "0%" )
			                    & " below its " & _pk_y & " peak of " & "$" & SWITCH ( TRUE (), ABS ( _pk_u ) >= 1e12, FORMAT ( _pk_u / 1e12, "#,0.0" ) & "tn", FORMAT ( _pk_u / 1e9, "#,0.0" ) & "bn" )
			                    & IF ( _n > _pk_n, ": the naira lost value, the economy didn't shrink.", "." )
			            )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Real_terms_narrative =
			-- e.g. "States received ₦708.2bn in Apr 2026, 3.4× the ₦206.8bn of Jan 2020. In Apr 2026 prices,
			-- Jan 2020 was worth ₦702.3bn, so in real terms states received 0.8% more."
			VAR _first = CALCULATE ( MIN ( faac[disbursement_date] ) )
			VAR _last = CALCULATE ( MAX ( faac[disbursement_date] ) )
			VAR _base = [Price_base_month]
			VAR _p1 = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _first, 0 ) )
			VAR _p2 = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _last, 0 ) )
			VAR _t1 = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _first, 0 ) )
			VAR _t2 = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _last, 0 ) )
			VAR _chg = DIVIDE ( _t2, _t1 ) - 1
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _p2 ) || _first = _last, "Select more than one month to compare.",
			        ISBLANK ( _t2 ),
			            "Price data for " & FORMAT ( _last, "mmm yyyy" ) & " isn't out yet, so it can't be compared in real terms.",
			        "States received " & "₦" & SWITCH ( TRUE (), ABS ( _p2 ) >= 1e12, FORMAT ( _p2 / 1e12, "#,0.0" ) & "tn", FORMAT ( _p2 / 1e9, "#,0.0" ) & "bn" ) & " in " & FORMAT ( _last, "mmm yyyy" ) & ", "
			            & FORMAT ( DIVIDE ( _p2, _p1 ), "0.0" ) & "× the " & "₦" & SWITCH ( TRUE (), ABS ( _p1 ) >= 1e12, FORMAT ( _p1 / 1e12, "#,0.0" ) & "tn", FORMAT ( _p1 / 1e9, "#,0.0" ) & "bn" ) & " of "
			            & FORMAT ( _first, "mmm yyyy" ) & ". In " & FORMAT ( _base, "mmm yyyy" ) & " prices, "
			            & FORMAT ( _first, "mmm yyyy" ) & " was worth " & "₦" & SWITCH ( TRUE (), ABS ( _t1 ) >= 1e12, FORMAT ( _t1 / 1e12, "#,0.0" ) & "tn", FORMAT ( _t1 / 1e9, "#,0.0" ) & "bn" )
			            & ", so in real terms states received "
			            & IF ( ROUND ( _chg, 3 ) = 0, "about the same.", FORMAT ( ABS ( _chg ), "0.0%" ) & IF ( _chg > 0, " more.", " less." ) )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Administration_narrative =
			-- e.g. "Inflation averaged 10.6% under Jonathan (from Jan 2011), 13.4% under Buhari and 24.0% under
			-- Tinubu (so far). The naira lost the most value under Tinubu: 55.9%."
			VAR _now = CALCULATE ( MAX ( dim_administration[first_disbursement_month] ), REMOVEFILTERS ( dim_administration ) )
			VAR _t =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dim_administration[president] ),
			            "@start", CALCULATE ( MIN ( dim_administration[first_disbursement_month] ) ),
			            "@inf", [Inflation_yoy],
			            "@inf_from", CALCULATE ( MIN ( econ_month[month_date] ), NOT ISBLANK ( econ_month[inflation_yoy] ) ),
			            "@naira", [Term_naira_change]
			        ),
			        NOT ISBLANK ( [@inf] )
			    )
			VAR _n = COUNTROWS ( _t )
			VAR _items =
			    ADDCOLUMNS (
			        _t,
			        "@rank", RANKX ( _t, [@start], , ASC ),
			        "@text",
			            FORMAT ( [@inf], "0.0%" ) & " under " & dim_administration[president]
			                & IF ( [@inf_from] > [@start], " (from " & FORMAT ( [@inf_from], "mmm yyyy" ) & ")" )
			                & IF ( [@start] = _now, " (so far)" )
			    )
			VAR _list =
			    CONCATENATEX ( FILTER ( _items, [@rank] < _n ), [@text], ", ", [@start], ASC )
			        & IF ( _n > 1, " and " ) & MAXX ( FILTER ( _items, [@rank] = _n ), [@text] )
			VAR _worst = TOPN ( 1, FILTER ( _t, NOT ISBLANK ( [@naira] ) ), [@naira], ASC )
			RETURN
			    IF (
			        _n = 0,
			        "No inflation data for this selection.",
			        "Inflation averaged " & _list & "."
			            & IF (
			                NOT ISEMPTY ( _worst ) && MAXX ( _worst, [@naira] ) < 0,
			                " The naira lost the most value under " & MAXX ( _worst, dim_administration[president] ) & ": "
			                    & FORMAT ( - MAXX ( _worst, [@naira] ), "0.0%" ) & "."
			            )
			    )
		displayFolder: 06 Titles & Labels\Text

	column Value
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition Dax = calculated
		mode: import
		source =
				ROW ( "Value", 0 )

	annotation PBI_ResultType = Table
