	measure Deduction_Misc =
			-- Deduction (unlabelled) in the currency picked on the ₦/$ switch
			IF (
			    SELECTEDVALUE ( Currency[Currency], "₦" ) = "$",
			    SUM ( faac[deduction_misc_usd] ),
			    SUM ( faac[deduction_misc] )
			)
		displayFolder: 01 Base\Deductions

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Other_Deduction =
			-- Other deductions in the currency picked on the ₦/$ switch
			IF (
			    SELECTEDVALUE ( Currency[Currency], "₦" ) = "$",
			    SUM ( faac[other_deduction_usd] ),
			    SUM ( faac[other_deduction] )
			)
		displayFolder: 01 Base\Deductions

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Net =
			-- Net received in the currency picked on the ₦/$ switch
			IF (
			    SELECTEDVALUE ( Currency[Currency], "₦" ) = "$",
			    SUM ( faac[net_amount_after_deductions_usd] ),
			    SUM ( faac[net_amount_after_deductions] )
			)
		displayFolder: 01 Base\Net

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Net_rate =
			-- Share of the gross allocation the state actually received
			DIVIDE ( [Net], [Gross], 0 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Base\Net

	measure Months =
			DISTINCTCOUNT ( faac[disbursement_date] )
		formatString: #,0
		displayFolder: 01 Base\Context

	measure States =
			DISTINCTCOUNT ( faac[state] )
		formatString: #,0
		displayFolder: 01 Base\Context

	measure State_months =
			-- State-month rows, the divisor for the Per state per month basis
			COUNTROWS ( faac )
		formatString: #,0
		displayFolder: 01 Base\Context

	measure Latest_month =
			-- Latest month with FAAC data up to the To month of the date range;
			-- a chart's own month axis, states and presidents don't change it
			VAR _to = [Range_to]
			RETURN
			    CALCULATE (
			        MAX ( faac[disbursement_date] ),
			        REMOVEFILTERS ( calendar_table ),
			        REMOVEFILTERS ( dim_state ),
			        REMOVEFILTERS ( dim_administration ),
			        faac[disbursement_date] <= _to
			    )
		formatString: mmm yyyy
		displayFolder: 01 Base\Context

	measure FX_rate_avg =
			-- Average of the monthly official rates in the selection (naira per US dollar)
			AVERAGEX ( VALUES ( faac[disbursement_date] ), CALCULATE ( MAX ( faac[naira_per_usd] ) ) )
		formatString: ₦#,0.00
		displayFolder: 01 Base\Context

	measure Metric_value =
			-- Value of the metric picked in Metric_param (a matrix row or column, a hovered cell, or a
			-- card's visual filter). Sums columns directly, so calculation groups apply to it exactly once.
			VAR _k = SELECTEDVALUE ( Metric_param[Metric_key] )
			VAR _usd = SELECTEDVALUE ( Currency[Currency], "₦" ) = "$"
			RETURN
			    SWITCH (
			        _k,
			        "Gross", IF ( _usd, SUM ( faac[total_gross_amount_usd] ), SUM ( faac[total_gross_amount] ) ),
			        "Statutory", IF ( _usd, SUM ( faac[statutory_allocation_usd] ), SUM ( faac[statutory_allocation] ) ),
			        "VAT", IF ( _usd, SUM ( faac[gross_vat_allocation_usd] ), SUM ( faac[gross_vat_allocation] ) ),
			        "Oil_Derivation", IF ( _usd, SUM ( faac[oil_derivation_usd] ), SUM ( faac[oil_derivation] ) ),
			        "Exchange_Gain", IF ( _usd, SUM ( faac[exchange_gain_difference_usd] ), SUM ( faac[exchange_gain_difference] ) ),
			        "Ecology", IF ( _usd, SUM ( faac[total_ecology_fund_usd] ), SUM ( faac[total_ecology_fund] ) ),
			        "Others_Income", IF ( _usd, SUM ( faac[others_income_usd] ), SUM ( faac[others_income] ) ),
			        "Deductions", IF ( _usd, SUM ( faac[total_deductions_usd] ), SUM ( faac[total_deductions] ) ),
			        "External_Debt", IF ( _usd, SUM ( faac[external_debt_usd] ), SUM ( faac[external_debt] ) ),
			        "Contractual_Obligation", IF ( _usd, SUM ( faac[contractual_obligation_ispo_usd] ), SUM ( faac[contractual_obligation_ispo] ) ),
			        "NDDC_Transfer", IF ( _usd, SUM ( faac[transfer_nddc_hyppadec_usd] ), SUM ( faac[transfer_nddc_hyppadec] ) ),
			        "Other_Deductions_Note", IF ( _usd, SUM ( faac[other_deductions_note_usd] ), SUM ( faac[other_deductions_note] ) ),
			        "Deduction_Misc", IF ( _usd, SUM ( faac[deduction_misc_usd] ), SUM ( faac[deduction_misc] ) ),
			        "Other_Deduction", IF ( _usd, SUM ( faac[other_deduction_usd] ), SUM ( faac[other_deduction] ) ),
			        "Net", IF ( _usd, SUM ( faac[net_amount_after_deductions_usd] ), SUM ( faac[net_amount_after_deductions] ) )
			    )
		displayFolder: 01 Base\Selected metric

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Oil_Derivation_share =
			DIVIDE ( [Oil_Derivation], [Gross], 0 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Shares

	measure VAT_share =
			DIVIDE ( [VAT], [Gross], 0 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Shares

	measure Deductions_share =
			DIVIDE ( [Deductions], [Gross], 0 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Shares

	measure Net_share_national =
			-- The state's share of the net received by all states, for the current period
			DIVIDE ( [Net_curr], CALCULATE ( [Net_curr], REMOVEFILTERS ( dim_state ) ), 0 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Shares

	measure Gross_curr =
			CALCULATE ( [Gross], 'Period Calc'[Name] = "Current" )
		displayFolder: 03 Period Comparison\Gross

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Gross_prev =
			CALCULATE ( [Gross], 'Period Calc'[Name] = "Previous" )
		displayFolder: 03 Period Comparison\Gross

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Gross_PnP =
			CALCULATE ( [Gross], 'Period Calc'[Name] = "Change %" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Gross

	measure 'Gross_G&D' =
			CALCULATE ( [Gross], 'Period Calc'[Name] = "Trend" )
		displayFolder: 03 Period Comparison\Gross

	measure Gross_colour =
			-- Up is good
			VAR _chg = [Gross_PnP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _chg ) || ROUND ( _chg, 4 ) = 0, "#C98A00",
			        _chg > 0, "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 03 Period Comparison\Gross

	measure Gross_change_text =
			-- e.g. "▲ 8.9% Growth · vs Mar 2026"
			VAR _chg = [Gross_PnP]
			VAR _mark =
			    SWITCH ( TRUE (), ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( _chg ),
			        "No data for this period",
			        _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & " " & [Gross_G&D] & " · " & [Periodic_text]
			    )
		displayFolder: 03 Period Comparison\Gross

	measure Deductions_curr =
			CALCULATE ( [Deductions], 'Period Calc'[Name] = "Current" )
		displayFolder: 03 Period Comparison\Deductions

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Deductions_prev =
			CALCULATE ( [Deductions], 'Period Calc'[Name] = "Previous" )
		displayFolder: 03 Period Comparison\Deductions

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Deductions_PnP =
			CALCULATE ( [Deductions], 'Period Calc'[Name] = "Change %" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Deductions

	measure 'Deductions_G&D' =
			CALCULATE ( [Deductions], 'Period Calc'[Name] = "Trend" )
		displayFolder: 03 Period Comparison\Deductions

	measure Deductions_colour =
			-- Up is bad: more was deducted
			VAR _chg = [Deductions_PnP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _chg ) || ROUND ( _chg, 4 ) = 0, "#C98A00",
			        _chg < 0, "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 03 Period Comparison\Deductions

	measure Deductions_change_text =
			-- e.g. "▲ 8.9% Growth · vs Mar 2026"
			VAR _chg = [Deductions_PnP]
			VAR _mark =
			    SWITCH ( TRUE (), ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( _chg ),
			        "No data for this period",
			        _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & " " & [Deductions_G&D] & " · " & [Periodic_text]
			    )
		displayFolder: 03 Period Comparison\Deductions

	measure Net_curr =
			CALCULATE ( [Net], 'Period Calc'[Name] = "Current" )
		displayFolder: 03 Period Comparison\Net

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Net_prev =
			CALCULATE ( [Net], 'Period Calc'[Name] = "Previous" )
		displayFolder: 03 Period Comparison\Net

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Net_PnP =
			CALCULATE ( [Net], 'Period Calc'[Name] = "Change %" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Net

	measure 'Net_G&D' =
			CALCULATE ( [Net], 'Period Calc'[Name] = "Trend" )
		displayFolder: 03 Period Comparison\Net

	measure Net_colour =
			-- Up is good
			VAR _chg = [Net_PnP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _chg ) || ROUND ( _chg, 4 ) = 0, "#C98A00",
			        _chg > 0, "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 03 Period Comparison\Net

	measure Net_change_text =
			-- e.g. "▲ 8.9% Growth · vs Mar 2026"
			VAR _chg = [Net_PnP]
			VAR _mark =
			    SWITCH ( TRUE (), ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( _chg ),
			        "No data for this period",
			        _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & " " & [Net_G&D] & " · " & [Periodic_text]
			    )
		displayFolder: 03 Period Comparison\Net

	measure FX_rate_curr =
			CALCULATE ( [FX_rate_avg], 'Period Calc'[Name] = "Current" )
		formatString: ₦#,0.00
		displayFolder: 03 Period Comparison\FX_rate

	measure FX_rate_prev =
			CALCULATE ( [FX_rate_avg], 'Period Calc'[Name] = "Previous" )
		formatString: ₦#,0.00
		displayFolder: 03 Period Comparison\FX_rate

	measure FX_rate_PnP =
			CALCULATE ( [FX_rate_avg], 'Period Calc'[Name] = "Change %" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\FX_rate

	measure 'FX_rate_G&D' =
			CALCULATE ( [FX_rate_avg], 'Period Calc'[Name] = "Trend" )
		displayFolder: 03 Period Comparison\FX_rate

	measure FX_rate_colour =
			-- Up is bad (a higher rate means a weaker naira)
			VAR _chg = [FX_rate_PnP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _chg ) || ROUND ( _chg, 4 ) = 0, "#C98A00",
			        _chg < 0, "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 03 Period Comparison\FX_rate

	measure FX_rate_change_text =
			-- e.g. "▲ 8.9% Growth · vs Mar 2026"
			VAR _chg = [FX_rate_PnP]
			VAR _mark =
			    SWITCH ( TRUE (), ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( _chg ),
			        "No data for this period",
			        _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & " " & [FX_rate_G&D] & " · " & [Periodic_text]
			    )
		displayFolder: 03 Period Comparison\FX_rate

	measure Metric_value_curr =
			CALCULATE ( [Metric_value], 'Period Calc'[Name] = "Current" )
		displayFolder: 03 Period Comparison\Metric (tooltip)

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Metric_value_prev =
			CALCULATE ( [Metric_value], 'Period Calc'[Name] = "Previous" )
		displayFolder: 03 Period Comparison\Metric (tooltip)

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Metric_value_PnP =
			CALCULATE ( [Metric_value], 'Period Calc'[Name] = "Change %" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Metric (tooltip)

	measure 'Metric_value_G&D' =
			CALCULATE ( [Metric_value], 'Period Calc'[Name] = "Trend" )
		displayFolder: 03 Period Comparison\Metric (tooltip)

	measure Metric_value_colour =
			-- Income and net: up is good. Deductions: up is bad. No change: amber.
			VAR _chg = [Metric_value_PnP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _chg ) || ROUND ( _chg, 4 ) = 0, "#C98A00",
			        ( _chg > 0 ) = ( SELECTEDVALUE ( Metric_param[Metric_family] ) <> "Deduction" ), "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 03 Period Comparison\Metric (tooltip)

	measure Metric_change_text =
			-- e.g. "▲ 8.9% Growth · vs Mar 2026"
			VAR _chg = [Metric_value_PnP]
			VAR _mark =
			    SWITCH ( TRUE (), ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( _chg ),
			        "No data for this period",
			        _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & " " & [Metric_value_G&D] & " · " & [Periodic_text]
			    )
		displayFolder: 03 Period Comparison\Metric (tooltip)

	measure Side_A_label =
			SELECTEDVALUE ( Compare_A[member], "Pick side A" )
		displayFolder: 04 Comparison\Sides

	measure Side_B_label =
			SELECTEDVALUE ( Compare_B[member], "Pick side B" )
		displayFolder: 04 Comparison\Sides

	measure Side_A_meta =
			-- e.g. "APC · 96 months · 36 states"
			VAR _by = SELECTEDVALUE ( Compare_By[compare_by], "Administration" )
			VAR _months = CALCULATE ( [Months], 'Compare Side'[Name] = "A" )
			VAR _states = CALCULATE ( [States], 'Compare Side'[Name] = "A" )
			VAR _party =
			    IF (
			        _by = "Administration",
			        LOOKUPVALUE ( dim_administration[party], dim_administration[president], [Side_A_label] ) & " · "
			    )
			RETURN
			    IF (
			        ISBLANK ( _months ),
			        "No data",
			        _party & _months & IF ( _months = 1, " month", " months" ) & " · "
			            & _states & IF ( _states = 1, " state", " states" )
			    )
		displayFolder: 04 Comparison\Sides

	measure Side_B_meta =
			-- e.g. "APC · 96 months · 36 states"
			VAR _by = SELECTEDVALUE ( Compare_By[compare_by], "Administration" )
			VAR _months = CALCULATE ( [Months], 'Compare Side'[Name] = "B" )
			VAR _states = CALCULATE ( [States], 'Compare Side'[Name] = "B" )
			VAR _party =
			    IF (
			        _by = "Administration",
			        LOOKUPVALUE ( dim_administration[party], dim_administration[president], [Side_B_label] ) & " · "
			    )
			RETURN
			    IF (
			        ISBLANK ( _months ),
			        "No data",
			        _party & _months & IF ( _months = 1, " month", " months" ) & " · "
			            & _states & IF ( _states = 1, " state", " states" )
			    )
		displayFolder: 04 Comparison\Sides

	measure Side_A_total =
			-- Side A's total for the metric picked in Metric_param. Ignores Basis on purpose:
			-- callers read the Basis slicer themselves and divide.
			CALCULATE ( [Metric_value], 'Compare Side'[Name] = "A", REMOVEFILTERS ( Basis[Basis] ) )
		displayFolder: 04 Comparison\Sides

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Side_B_total =
			-- Side B's total for the metric picked in Metric_param. Ignores Basis on purpose:
			-- callers read the Basis slicer themselves and divide.
			CALCULATE ( [Metric_value], 'Compare Side'[Name] = "B", REMOVEFILTERS ( Basis[Basis] ) )
		displayFolder: 04 Comparison\Sides

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Side_A_months =
			CALCULATE ( [Months], 'Compare Side'[Name] = "A", REMOVEFILTERS ( Basis[Basis] ) )
		formatString: #,0
		displayFolder: 04 Comparison\Sides

	measure Side_B_months =
			CALCULATE ( [Months], 'Compare Side'[Name] = "B", REMOVEFILTERS ( Basis[Basis] ) )
		formatString: #,0
		displayFolder: 04 Comparison\Sides

	measure Side_A_state_months =
			CALCULATE ( [State_months], 'Compare Side'[Name] = "A", REMOVEFILTERS ( Basis[Basis] ) )
		formatString: #,0
		displayFolder: 04 Comparison\Sides

	measure Side_B_state_months =
			CALCULATE ( [State_months], 'Compare Side'[Name] = "B", REMOVEFILTERS ( Basis[Basis] ) )
		formatString: #,0
		displayFolder: 04 Comparison\Sides

	measure Side_A_value =
			-- Side A's value of the metric picked in Metric_param, on the selected Basis.
			-- Put it directly in a visual; inside another measure it can't see the Basis slicer.
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a =
			    DIVIDE (
			        CALCULATE ( [Side_A_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 )
			    )
			VAR _b =
			    DIVIDE (
			        CALCULATE ( [Side_B_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 )
			    )
			RETURN
			    _a
		displayFolder: 04 Comparison\Sides

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Side_B_value =
			-- Side B's value of the metric picked in Metric_param, on the selected Basis.
			-- Put it directly in a visual; inside another measure it can't see the Basis slicer.
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a =
			    DIVIDE (
			        CALCULATE ( [Side_A_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 )
			    )
			VAR _b =
			    DIVIDE (
			        CALCULATE ( [Side_B_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 )
			    )
			RETURN
			    _b
		displayFolder: 04 Comparison\Sides

		formatStringDefinition =
				VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
				-- Only the symbol: visuals ignore comma scaling, so display units do the scaling
				RETURN """" & _s & """#,0"

	measure Compare_valid =
			-- Warning text when both sides are the same; blank otherwise
			VAR _by = SELECTEDVALUE ( Compare_By[compare_by], "Administration" )
			RETURN
			    IF (
			        NOT ISBLANK ( SELECTEDVALUE ( Compare_A[member] ) )
			            && SELECTEDVALUE ( Compare_A[member] ) = SELECTEDVALUE ( Compare_B[member] ),
			        "Pick two different " & LOWER ( _by ) & "s to compare."
			    )
		displayFolder: 04 Comparison\Sides

	measure Metric_A_colour =
			-- Green if Side A is better, red if worse, amber if equal. For deductions, higher is worse.
			VAR _fam = SELECTEDVALUE ( Metric_param[Metric_family] )
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a =
			    DIVIDE (
			        CALCULATE ( [Side_A_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 )
			    )
			VAR _b =
			    DIVIDE (
			        CALCULATE ( [Side_B_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 )
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _a ) || ISBLANK ( _b ), "#6B7C73",
			        ROUND ( _a, 0 ) = ROUND ( _b, 0 ), "#C98A00",
			        ( _a > _b ) = ( _fam <> "Deduction" ), "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 04 Comparison\Colours

	measure Metric_B_colour =
			-- Green if Side B is better, red if worse, amber if equal. For deductions, higher is worse.
			VAR _fam = SELECTEDVALUE ( Metric_param[Metric_family] )
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a =
			    DIVIDE (
			        CALCULATE ( [Side_A_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 )
			    )
			VAR _b =
			    DIVIDE (
			        CALCULATE ( [Side_B_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 )
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _a ) || ISBLANK ( _b ), "#6B7C73",
			        ROUND ( _a, 0 ) = ROUND ( _b, 0 ), "#C98A00",
			        ( _b > _a ) = ( _fam <> "Deduction" ), "#0E8A5F",
			        "#C93C3C"
			    )
		displayFolder: 04 Comparison\Colours

	measure Last_6_Period_flag =
			-- 1 for the 6 months up to the latest month with data (sparklines, tooltip trends)
			VAR _last = [Latest_month]
			VAR _m = MAX ( calendar_table[month_date] )
			RETURN
			    IF ( _m <= EOMONTH ( _last, 0 ) && _m > EOMONTH ( _last, -6 ), 1, 0 )
		formatString: 0
		displayFolder: 05 Visual Helpers\Sparklines

	measure Last_24_month_flag =
			-- 1 for the 24 months up to the latest month with data (Overview trend)
			VAR _last = [Latest_month]
			VAR _m = MAX ( calendar_table[month_date] )
			RETURN
			    IF ( _m <= EOMONTH ( _last, 0 ) && _m > EOMONTH ( _last, -24 ), 1, 0 )
		formatString: 0
		displayFolder: 05 Visual Helpers\Sparklines

	measure Trend_title =
			"Gross allocation and net received, last 24 months · " & [Area_label]
		displayFolder: 06 Titles & Labels\Titles

	measure Mix_title =
			"Revenue mix · " & [Period_label]
		displayFolder: 06 Titles & Labels\Titles

	measure Top5_title =
			"Top 5 states by net received · " & [Period_label]
		displayFolder: 06 Titles & Labels\Titles

	measure Map_title =
			"Net received by state · " & [Period_label]
		displayFolder: 06 Titles & Labels\Titles

	measure Ranking_title =
			"States ranked by net received · " & [Period_label]
		displayFolder: 06 Titles & Labels\Titles

	measure Oil_title =
			"Oil derivation by state · " & [Period_label]
		displayFolder: 06 Titles & Labels\Titles

	measure Period_label =
			-- The current period in words: "Apr 2026", "Q2 2026 to date", "2026 to date"
			VAR _last = [Latest_month]
			RETURN
			    SWITCH (
			        SWITCH ( SELECTEDVALUE ( Period[Period Order] ), 1, "Quarterly", 2, "Yearly", "Monthly" ),
			        "Quarterly", "Q" & QUARTER ( _last ) & " " & YEAR ( _last ) & " to date",
			        "Yearly", YEAR ( _last ) & " to date",
			        FORMAT ( _last, "mmm yyyy" )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Periodic_text =
			-- What "previous" means: "vs Mar 2026", "vs Q2 2025 (to date)", "vs Jan–Apr 2025"
			VAR _last = [Latest_month]
			VAR _py = YEAR ( _last ) - 1
			RETURN
			    SWITCH (
			        SWITCH ( SELECTEDVALUE ( Period[Period Order] ), 1, "Quarterly", 2, "Yearly", "Monthly" ),
			        "Quarterly", "vs Q" & QUARTER ( _last ) & " " & _py & " (to date)",
			        "Yearly",
			            "vs "
			                & IF (
			                    MONTH ( _last ) = 1,
			                    "Jan " & _py,
			                    "Jan–" & FORMAT ( DATE ( _py, MONTH ( _last ), 1 ), "mmm yyyy" )
			                ),
			        "vs " & FORMAT ( EDATE ( _last, -1 ), "mmm yyyy" )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Area_label =
			SWITCH (
			    TRUE (),
			    HASONEVALUE ( dim_state[state] ), VALUES ( dim_state[state] ),
			    HASONEVALUE ( dim_state[zone] ), VALUES ( dim_state[zone] ),
			    HASONEVALUE ( dim_state[region] ), VALUES ( dim_state[region] ),
			    "All states"
			)
		displayFolder: 06 Titles & Labels\Text

	measure Currency_label =
			IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "US dollars", "naira" )
		displayFolder: 06 Titles & Labels\Text

	measure Basis_label =
			SELECTEDVALUE ( Basis[Basis], "Total" ) & ", " & [Currency_label]
		displayFolder: 06 Titles & Labels\Text

	measure Comparison_narrative =
			-- e.g. "Under Tinubu, states were allocated ₦607.0bn a month on average, 2.3× as much as
			-- under Buhari (₦265.3bn). Deductions took 9.8% of gross under Tinubu and 12.3% under Buhari."
			VAR _by = SELECTEDVALUE ( Compare_By[compare_by], "Administration" )
			VAR _na = [Side_A_label]
			VAR _nb = [Side_B_label]
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a =
			    DIVIDE (
			        CALCULATE ( [Side_A_total], Metric_param[Metric_key] = "Gross" ),
			        SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 )
			    )
			VAR _b =
			    DIVIDE (
			        CALCULATE ( [Side_B_total], Metric_param[Metric_key] = "Gross" ),
			        SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 )
			    )
			-- A share within one side: the basis divisor cancels, so totals are enough
			VAR _da =
			    DIVIDE (
			        CALCULATE ( [Side_A_total], Metric_param[Metric_key] = "Deductions" ),
			        CALCULATE ( [Side_A_total], Metric_param[Metric_key] = "Gross" )
			    )
			VAR _db =
			    DIVIDE (
			        CALCULATE ( [Side_B_total], Metric_param[Metric_key] = "Deductions" ),
			        CALCULATE ( [Side_B_total], Metric_param[Metric_key] = "Gross" )
			    )
			VAR _per =
			    SWITCH (
			        _basis,
			        "Monthly average", " a month on average",
			        "Per state per month", " per state per month",
			        " in total"
			    )
			VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _fa =
			    _s
			        & SWITCH (
			            TRUE (),
			            ABS ( _a ) >= 1e12, FORMAT ( _a / 1e12, "#,0.0" ) & "tn",
			            ABS ( _a ) >= 1e9, FORMAT ( _a / 1e9, "#,0.0" ) & "bn",
			            ABS ( _a ) >= 1e6, FORMAT ( _a / 1e6, "#,0.0" ) & "m",
			            FORMAT ( _a, "#,0" )
			        )
			VAR _fb =
			    _s
			        & SWITCH (
			            TRUE (),
			            ABS ( _b ) >= 1e12, FORMAT ( _b / 1e12, "#,0.0" ) & "tn",
			            ABS ( _b ) >= 1e9, FORMAT ( _b / 1e9, "#,0.0" ) & "bn",
			            ABS ( _b ) >= 1e6, FORMAT ( _b / 1e6, "#,0.0" ) & "m",
			            FORMAT ( _b, "#,0" )
			        )
			VAR _subject =
			    SWITCH (
			        _by,
			        "Administration", "Under " & _nb & ", states were allocated ",
			        "State", _nb & " was allocated ",
			        "States in the " & _nb & " were allocated "
			    )
			VAR _ref = SWITCH ( _by, "Administration", "under " & _na, "State", _na, "states in the " & _na )
			VAR _in = IF ( _by = "Administration", "under ", "in " )
			VAR _r = DIVIDE ( _b, _a )
			VAR _cmp =
			    SWITCH (
			        TRUE (),
			        ROUND ( _r, 3 ) = 1, "the same as " & _ref,
			        _r >= 1.5, FORMAT ( _r, "0.0" ) & "× as much as " & _ref,
			        _r > 1, FORMAT ( _r - 1, "0%" ) & " more than " & _ref,
			        FORMAT ( 1 - _r, "0%" ) & " less than " & _ref
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( [Compare_valid] ), [Compare_valid],
			        ISBLANK ( _a ) || ISBLANK ( _b ), "Pick " & IF ( _by = "Administration", "an ", "a " ) & LOWER ( _by ) & " for each side.",
			        _subject & _fb & _per & ", " & _cmp & " (" & _fa & "). "
			            & "Deductions took " & FORMAT ( _db, "0.0%" ) & " of gross " & _in & _nb
			            & " and " & FORMAT ( _da, "0.0%" ) & " " & _in & _na & "."
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Metric_definition =
			-- Plain-language explanation of the hovered metric, keyed on Metric_key
			VAR _k = SELECTEDVALUE ( Metric_param[Metric_key] )
			RETURN
			    SWITCH (
			        _k,
			        "Gross", "Everything the state was allocated at the monthly FAAC sharing, before deductions: statutory allocation, VAT, oil derivation, exchange gain, ecology fund and other income.",
			        "Statutory", "The state's share of the Federation Account, the pool of federally collected revenue such as oil and gas earnings, company income tax and customs duties. States split it using the revenue allocation formula, which weighs equality, population, land mass and other factors.",
			        "VAT", "The state's share of Value Added Tax collected nationwide. VAT is pooled and split between the federal government, states and local governments, then among states partly equally and partly by population and where the tax was generated.",
			        "Oil_Derivation", "Extra money for oil- and gas-producing states: at least 13% of revenue from natural resources goes back to the states that produce them (Constitution, s.162(2)). Most states receive none.",
			        "Exchange_Gain", "The state's share of the extra naira the Federation Account earns when dollar revenue is converted at a weaker naira rate than the budget assumed. Only paid in some months.",
			        "Ecology", "The state's share of the Ecological Fund, set aside from the Federation Account for problems such as erosion, flooding and desertification.",
			        "Others_Income", "Smaller or one-off revenue lines that the FAAC report groups as ""Others"".",
			        "Deductions", "Money taken from the state's allocation at source, before payment, mostly to repay debts and meet commitments the state has signed up to.",
			        "External_Debt", "Repayments on the state's foreign loans (for example from the World Bank), deducted at source by the federal government.",
			        "Contractual_Obligation", "Irrevocable Standing Payment Orders (ISPOs): payments the state committed to in advance, usually for bank loans, bonds or contracts, deducted automatically each month.",
			        "NDDC_Transfer", "Half of the ecological fund due to member states, transferred by law to the Niger Delta Development Commission (NDDC) or the Hydroelectric Power Producing Areas Development Commission (HYPPADEC).",
			        "Other_Deductions_Note", "Other deductions that the FAAC report explains in its notes, often repayments of federal loans to states such as budget support or bailout facilities.",
			        "Deduction_Misc", "A deduction shown in the FAAC report under a column headed only ""Deduction"", with no further detail.",
			        "Other_Deduction", "Smaller deductions that the FAAC report groups as ""Others"".",
			        "Net", "What the state actually received: gross allocation minus deductions.",
			        "Hover a metric to see what it means."
			    )
		displayFolder: 06 Titles & Labels\Tooltips

	measure FX_rate_definition =
			"The month's average official naira-per-dollar rate (World Bank). Each month's naira amounts are converted at that month's own rate."
		displayFolder: 06 Titles & Labels\Tooltips

	measure Deductions_share_definition =
			"The share of the gross allocation taken as deductions."
		displayFolder: 06 Titles & Labels\Tooltips

	measure Net_share_definition =
			"The state's share of the net received by all 36 states."
		displayFolder: 06 Titles & Labels\Tooltips

	measure Metric_tooltip_title =
			UPPER ( SELECTEDVALUE ( Metric_param[Metric_label], "Metric" ) & " · " & [Area_label] )
		displayFolder: 06 Titles & Labels\Tooltips

	measure Metric_tooltip_subtitle =
			[Period_label] & " · " & [Currency_label]
		displayFolder: 06 Titles & Labels\Tooltips

	measure Metric_tooltip_summary =
			-- e.g. "Oil derivation was ₦18.4bn in Apr 2026, up 8.9% vs Mar 2026."
			VAR _name = SELECTEDVALUE ( Metric_param[Metric_label], "This metric" )
			VAR _v = [Metric_value_curr]
			VAR _chg = [Metric_value_PnP]
			VAR _s = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _amount =
			    _s
			        & SWITCH (
			            TRUE (),
			            ABS ( _v ) >= 1e12, FORMAT ( _v / 1e12, "#,0.0" ) & "tn",
			            ABS ( _v ) >= 1e9, FORMAT ( _v / 1e9, "#,0.0" ) & "bn",
			            ABS ( _v ) >= 1e6, FORMAT ( _v / 1e6, "#,0.0" ) & "m",
			            FORMAT ( _v, "#,0" )
			        )
			VAR _move =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _chg ), "",
			        ROUND ( _chg, 4 ) = 0, ", unchanged " & [Periodic_text],
			        ", " & IF ( _chg > 0, "up ", "down " ) & FORMAT ( ABS ( _chg ), "0.0%" ) & " " & [Periodic_text]
			    )
			RETURN
			    IF (
			        ISBLANK ( _v ),
			        "No data for this period.",
			        _name & " was " & _amount & " in " & [Period_label] & _move & "."
			    )
		displayFolder: 06 Titles & Labels\Tooltips

	measure State_tooltip_title =
			UPPER ( SELECTEDVALUE ( dim_state[state] ) )
		displayFolder: 06 Titles & Labels\Tooltips

	measure State_tooltip_subtitle =
			-- "South South · South · Rank 2 of 36 by net". Ranked against every state, even with a Zone filter.
			VAR _net = [Net_curr]
			VAR _rank =
			    CALCULATE (
			        RANKX ( VALUES ( dim_state[state] ), [Net_curr], _net, DESC ),
			        REMOVEFILTERS ( dim_state )
			    )
			VAR _n =
			    CALCULATE (
			        COUNTROWS ( FILTER ( VALUES ( dim_state[state] ), NOT ISBLANK ( [Net_curr] ) ) ),
			        REMOVEFILTERS ( dim_state )
			    )
			RETURN
			    SELECTEDVALUE ( dim_state[zone] ) & " · " & SELECTEDVALUE ( dim_state[region] )
			        & " · Rank " & _rank & " of " & _n & " by net"
		displayFolder: 06 Titles & Labels\Tooltips

	measure Compare_tooltip_title =
			UPPER ( SELECTEDVALUE ( Metric_param[Metric_label], "Metric" ) ) & " · " & [Basis_label]
		displayFolder: 06 Titles & Labels\Tooltips

	measure Compare_tooltip_text =
			-- "▲ Tinubu 185.0% higher than Buhari", coloured with Metric_B_colour
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a =
			    DIVIDE (
			        CALCULATE ( [Side_A_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 )
			    )
			VAR _b =
			    DIVIDE (
			        CALCULATE ( [Side_B_total] ),
			        SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 )
			    )
			VAR _d = DIVIDE ( _b - _a, _a )
			VAR _mark =
			    SWITCH ( TRUE (), ROUND ( _d, 4 ) = 0, UNICHAR ( 9632 ), _d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _a ) || ISBLANK ( _b ), "No data for one side.",
			        ROUND ( _d, 4 ) = 0, _mark & " " & [Side_B_label] & " and " & [Side_A_label] & " are equal",
			        _mark & " " & [Side_B_label] & " " & FORMAT ( ABS ( _d ), "0.0%" )
			            & IF ( _d > 0, " higher", " lower" ) & " than " & [Side_A_label]
			    )
		displayFolder: 06 Titles & Labels\Tooltips

	measure State_share_text =
			-- e.g. "Share of national net: 7.6%"
			"Share of national net: " & FORMAT ( [Net_share_national], "0.0%" )
		displayFolder: 06 Titles & Labels\Tooltips

	measure Naira_per_usd =
			-- Official naira per US dollar, averaged over the months in the selection
			AVERAGE ( econ_month[naira_per_usd] )
		formatString: ₦#,0.00
		displayFolder: 01 Base\Economy

	measure CPI_index =
			-- World Bank consumer price index (only ratios between months mean anything)
			AVERAGE ( econ_month[cpi_index] )
		formatString: #,0.0
		displayFolder: 01 Base\Economy

	measure GDP_naira =
			SUM ( econ_year[gdp_naira] )
		formatString: ₦#,0
		displayFolder: 01 Base\Economy

	measure GDP_usd =
			-- Moves with the exchange rate, so it can fall while the economy grows
			SUM ( econ_year[gdp_usd] )
		formatString: $#,0
		displayFolder: 01 Base\Economy

	measure Population =
			-- Averaged, not summed: a population isn't added up across years
			AVERAGE ( econ_year[population] )
		formatString: #,0
		displayFolder: 01 Base\Economy

	measure Inflation_yoy =
			-- Prices vs the same month a year earlier. Over several months: the average monthly rate
			AVERAGE ( econ_month[inflation_yoy] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Economy

	measure Naira_value_change_yoy =
			-- What a naira buys in dollars vs a year earlier. Negative = the naira lost value
			AVERAGE ( econ_month[naira_value_change_yoy] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Economy

	measure Real_GDP_growth =
			-- Growth after inflation. Over several years: the average yearly rate
			AVERAGE ( econ_year[real_gdp_growth] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Economy

	measure GDP_per_person_usd =
			DIVIDE ( SUM ( econ_year[gdp_usd] ), SUM ( econ_year[population] ) )
		formatString: $#,0
		displayFolder: 02 Rates & Averages\Economy

	measure GDP_per_person_naira =
			DIVIDE ( SUM ( econ_year[gdp_naira] ), SUM ( econ_year[population] ) )
		formatString: ₦#,0
		displayFolder: 02 Rates & Averages\Economy

	measure Inflation_latest_month =
			-- Latest month in the selection with an inflation figure
			CALCULATE ( MAX ( econ_month[month_date] ), NOT ISBLANK ( econ_month[inflation_yoy] ) )
		formatString: mmm yyyy
		displayFolder: 03 Period Comparison\Inflation

	measure Inflation_latest =
			VAR _m = [Inflation_latest_month]
			RETURN
			    CALCULATE ( [Inflation_yoy], econ_month[month_date] = _m )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Inflation

	measure Inflation_prev =
			-- The month before the latest one, even if it falls outside the selection
			VAR _m = [Inflation_latest_month]
			RETURN
			    CALCULATE ( [Inflation_yoy], REMOVEFILTERS ( econ_month ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_month[month_date] = EDATE ( _m, -1 ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Inflation

	measure Inflation_change_text =
			-- e.g. "▼ 0.4 pp vs Jun 2026" (percentage points: the gap between two rates)
			VAR _d = [Inflation_latest] - [Inflation_prev]
			VAR _mark = SWITCH ( TRUE (), ROUND ( _d, 4 ) = 0, UNICHAR ( 9632 ), _d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( [Inflation_prev] ),
			        "No earlier month",
			        _mark & " " & FORMAT ( ABS ( _d ) * 100, "0.0" ) & " pp vs "
			            & FORMAT ( EDATE ( [Inflation_latest_month], -1 ), "mmm yyyy" )
			    )
		displayFolder: 03 Period Comparison\Inflation

	measure Inflation_colour =
			-- Falling inflation is good
			VAR _d = [Inflation_latest] - [Inflation_prev]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( [Inflation_prev] ) || ROUND ( _d, 4 ) = 0, "#C98A00", _d < 0, "#0E8A5F", "#C93C3C" )
		displayFolder: 03 Period Comparison\Inflation

	measure Naira_latest_month =
			CALCULATE ( MAX ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
		formatString: mmm yyyy
		displayFolder: 03 Period Comparison\Naira

	measure Naira_latest =
			VAR _m = [Naira_latest_month]
			RETURN
			    CALCULATE ( [Naira_per_usd], econ_month[month_date] = _m )
		formatString: ₦#,0.00
		displayFolder: 03 Period Comparison\Naira

	measure Naira_change_latest =
			-- Change in the naira's value over the year to the latest month
			VAR _m = [Naira_latest_month]
			RETURN
			    CALCULATE ( [Naira_value_change_yoy], econ_month[month_date] = _m )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Naira

	measure Naira_change_text =
			-- e.g. "▲ 13.2% stronger vs Aug 2025"
			VAR _c = [Naira_change_latest]
			VAR _mark = SWITCH ( TRUE (), ROUND ( _c, 4 ) = 0, UNICHAR ( 9632 ), _c > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( _c ),
			        "No year-earlier month",
			        _mark & " " & FORMAT ( ABS ( _c ), "0.0%" ) & IF ( _c >= 0, " stronger", " weaker" ) & " vs "
			            & FORMAT ( EDATE ( [Naira_latest_month], -12 ), "mmm yyyy" )
			    )
		displayFolder: 03 Period Comparison\Naira

	measure Naira_colour =
			-- A stronger naira is good
			VAR _c = [Naira_change_latest]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _c ) || ROUND ( _c, 4 ) = 0, "#C98A00", _c > 0, "#0E8A5F", "#C93C3C" )
		displayFolder: 03 Period Comparison\Naira

	measure GDP_latest_year =
			-- Latest year in the selection with GDP data
			CALCULATE ( MAX ( econ_year[year] ), NOT ISBLANK ( econ_year[gdp_naira] ) )
		formatString: 0
		displayFolder: 03 Period Comparison\GDP

	measure Growth_latest =
			VAR _y = [GDP_latest_year]
			RETURN
			    CALCULATE ( [Real_GDP_growth], econ_year[year] = _y )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\GDP

	measure GDP_naira_latest =
			VAR _y = [GDP_latest_year]
			RETURN
			    CALCULATE ( [GDP_naira], econ_year[year] = _y )
		formatString: ₦#,0
		displayFolder: 03 Period Comparison\GDP

	measure GDP_usd_latest =
			VAR _y = [GDP_latest_year]
			RETURN
			    CALCULATE ( [GDP_usd], econ_year[year] = _y )
		formatString: $#,0
		displayFolder: 03 Period Comparison\GDP

	measure GDP_per_person_usd_latest =
			VAR _y = [GDP_latest_year]
			RETURN
			    CALCULATE ( [GDP_per_person_usd], econ_year[year] = _y )
		formatString: $#,0
		displayFolder: 03 Period Comparison\GDP

	measure GDP_per_person_naira_latest =
			VAR _y = [GDP_latest_year]
			RETURN
			    CALCULATE ( [GDP_per_person_naira], econ_year[year] = _y )
		formatString: ₦#,0
		displayFolder: 03 Period Comparison\GDP

	measure Growth_prev =
			-- The year before the latest one, even if it falls outside the selection
			VAR _y = [GDP_latest_year]
			RETURN
			    CALCULATE ( [Real_GDP_growth], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _y - 1 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\GDP

	measure Growth_change_text =
			-- e.g. "▼ 0.1 pp vs 2024"
			VAR _d = [Growth_latest] - [Growth_prev]
			VAR _mark = SWITCH ( TRUE (), ROUND ( _d, 4 ) = 0, UNICHAR ( 9632 ), _d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			RETURN
			    IF (
			        ISBLANK ( [Growth_prev] ),
			        "No earlier year",
			        _mark & " " & FORMAT ( ABS ( _d ) * 100, "0.0" ) & " pp vs " & ( [GDP_latest_year] - 1 )
			    )
		displayFolder: 03 Period Comparison\GDP

	measure Growth_colour =
			-- Faster growth is good
			VAR _d = [Growth_latest] - [Growth_prev]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( [Growth_prev] ) || ROUND ( _d, 4 ) = 0, "#C98A00", _d > 0, "#0E8A5F", "#C93C3C" )
		displayFolder: 03 Period Comparison\GDP

	measure Term_naira_change =
			-- What a naira buys in dollars at the end of the selection vs its start, e.g. -0.56 = lost 56%.
			-- For a president: first month in office to last (or latest) month.
			VAR _first = CALCULATE ( MIN ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
			VAR _last = CALCULATE ( MAX ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
			VAR _r1 = CALCULATE ( [Naira_per_usd], econ_month[month_date] = _first )
			VAR _r2 = CALCULATE ( [Naira_per_usd], econ_month[month_date] = _last )
			RETURN
			    IF ( _first < _last, DIVIDE ( _r1, _r2 ) - 1 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Period Comparison\Administration

	measure Term_months =
			-- Months with exchange rate data in the selection
			CALCULATE ( COUNTROWS ( econ_month ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
		formatString: #,0
		displayFolder: 03 Period Comparison\Administration

	measure Term_coverage_text =
			-- Says when the data covers only part of a term. Disappears once older data is backfilled.
			VAR _start = SELECTEDVALUE ( dim_administration[first_disbursement_month] )
			VAR _next =
			    CALCULATE (
			        MIN ( dim_administration[first_disbursement_month] ),
			        REMOVEFILTERS ( dim_administration ),
			        dim_administration[first_disbursement_month] > _start
			    )
			VAR _first = CALCULATE ( MIN ( econ_month[month_date] ) )
			VAR _last = CALCULATE ( MAX ( econ_month[month_date] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _start ), BLANK (),
			        ISBLANK ( _first ), "No monthly data for this term yet",
			        _first > _start,
			            "Monthly data covers " & FORMAT ( _first, "mmm yyyy" ) & " to " & FORMAT ( _last, "mmm yyyy" ) & " only",
			        ISBLANK ( _next ), "Term in progress: to " & FORMAT ( _last, "mmm yyyy" ),
			        BLANK ()
			    )
		displayFolder: 03 Period Comparison\Administration

	measure Price_base_month =
			-- The prices "Today's prices" uses: the latest FAAC month that has a CPI figure
			VAR _faac_last = CALCULATE ( MAX ( faac[disbursement_date] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE (
			        MAX ( econ_month[month_date] ),
			        REMOVEFILTERS (),
			        NOT ISBLANK ( econ_month[cpi_index] ),
			        econ_month[month_date] <= _faac_last
			    )
		formatString: mmm yyyy
		displayFolder: 01 Base\Real terms

	measure Net_paid =
			-- Net FAAC received, in naira as paid. Ignores the ₦/$ switch: CPI measures naira prices.
			SUM ( faac[net_amount_after_deductions] )
		formatString: ₦#,0
		displayFolder: 01 Base\Real terms

	measure Net_today_prices =
			-- Each month's net restated in the base month's prices: net × (base CPI ÷ that month's CPI).
			-- Adjusted month by month and then added, so every month uses its own price level.
			-- Months with no CPI yet are left out (blank), never shown as paid.
			VAR _base = [Price_base_month]
			VAR _base_cpi = CALCULATE ( MAX ( econ_month[cpi_index] ), REMOVEFILTERS (), econ_month[month_date] = _base )
			RETURN
			    SUMX (
			        VALUES ( calendar_table[month_date] ),
			        VAR _net = CALCULATE ( SUM ( faac[net_amount_after_deductions] ) )
			        VAR _cpi = CALCULATE ( MAX ( econ_month[cpi_index] ) )
			        RETURN
			            IF ( NOT ISBLANK ( _net ) && NOT ISBLANK ( _cpi ), _net * DIVIDE ( _base_cpi, _cpi ) )
			    )
		formatString: ₦#,0
		displayFolder: 01 Base\Real terms

	measure Net_prices =
			-- Net in the prices picked on the Prices switch (Economy section)
			IF ( SELECTEDVALUE ( Prices[Prices], "As paid" ) = "Today's prices", [Net_today_prices], [Net_paid] )
		formatString: ₦#,0
		displayFolder: 01 Base\Real terms

	measure Real_terms_title =
			-- e.g. "Net FAAC received by states · in Apr 2026 prices"
			"Net FAAC received by states · "
			    & IF (
			        SELECTEDVALUE ( Prices[Prices], "As paid" ) = "Today's prices",
			        "in " & FORMAT ( [Price_base_month], "mmm yyyy" ) & " prices",
			        "as paid"
			    )
		displayFolder: 06 Titles & Labels\Titles

	measure Inflation_as_of_text =
			"Year to " & FORMAT ( [Inflation_latest_month], "mmm yyyy" )
		displayFolder: 06 Titles & Labels\Text

	measure Naira_as_of_text =
			FORMAT ( [Naira_latest_month], "mmm yyyy" )
		displayFolder: 06 Titles & Labels\Text

	measure GDP_as_of_text =
			FORMAT ( [GDP_latest_year], "0" )
		displayFolder: 06 Titles & Labels\Text

	measure Inflation_narrative =
			-- e.g. "Prices rose 15.4% in the year to Jul 2026, down from a peak of 34.2% in Jun 2024.
			-- A year earlier the rate was 22.2%."
			VAR _m = [Inflation_latest_month]
			VAR _v = [Inflation_latest]
			VAR _t =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( econ_month[month_date] ), "@i", CALCULATE ( [Inflation_yoy] ) ),
			        NOT ISBLANK ( [@i] )
			    )
			VAR _pk = TOPN ( 1, _t, [@i], DESC, econ_month[month_date], DESC )
			VAR _pk_m = MAXX ( _pk, econ_month[month_date] )
			VAR _pk_v = MAXX ( _pk, [@i] )
			VAR _ya = CALCULATE ( [Inflation_yoy], REMOVEFILTERS ( econ_month ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_month[month_date] = EDATE ( _m, -12 ) )
			RETURN
			    IF (
			        ISBLANK ( _v ),
			        "No inflation data for this selection.",
			        "Prices " & IF ( _v >= 0, "rose ", "fell " ) & FORMAT ( ABS ( _v ), "0.0%" ) & " in the year to "
			            & FORMAT ( _m, "mmm yyyy" )
			            & IF (
			                _pk_m = _m,
			                ", the highest rate in this period.",
			                ", down from a peak of " & FORMAT ( _pk_v, "0.0%" ) & " in " & FORMAT ( _pk_m, "mmm yyyy" ) & "."
			            )
			            & IF ( NOT ISBLANK ( _ya ), " A year earlier the rate was " & FORMAT ( _ya, "0.0%" ) & "." )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Naira_narrative =
			-- e.g. "₦1,354.97 bought one US dollar in Aug 2026. A naira buys 13.2% more dollars than a year
			-- earlier, but 88.9% fewer than in Jan 2010 (₦150.35)."
			VAR _m = [Naira_latest_month]
			VAR _r = [Naira_latest]
			VAR _c = [Naira_change_latest]
			VAR _first = CALCULATE ( MIN ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
			VAR _r1 = CALCULATE ( [Naira_per_usd], econ_month[month_date] = _first )
			VAR _since = DIVIDE ( _r1, _r ) - 1
			VAR _yr =
			    IF (
			        NOT ISBLANK ( _c ),
			        " A naira buys " & FORMAT ( ABS ( _c ), "0.0%" ) & IF ( _c >= 0, " more", " fewer" )
			            & " dollars than a year earlier"
			    )
			VAR _long =
			    IF (
			        _first < EDATE ( _m, -12 ),
			        IF ( ISBLANK ( _yr ), " A naira buys ", IF ( ( _c >= 0 ) = ( _since >= 0 ), ", and ", ", but " ) )
			            & FORMAT ( ABS ( _since ), "0.0%" ) & IF ( _since >= 0, " more", " fewer" )
			            & IF ( ISBLANK ( _yr ), " dollars", "" ) & " than in " & FORMAT ( _first, "mmm yyyy" )
			            & " (" & FORMAT ( _r1, "₦#,0.00" ) & ")"
			    )
			RETURN
			    IF (
			        ISBLANK ( _r ),
			        "No exchange rate data for this selection.",
			        FORMAT ( _r, "₦#,0.00" ) & " bought one US dollar in " & FORMAT ( _m, "mmm yyyy" ) & "." & _yr & _long
			            & IF ( NOT ISBLANK ( _yr ) || NOT ISBLANK ( _long ), "." )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure GDP_narrative =
			-- e.g. "The economy grew 4.0% after inflation in 2025, to ₦441.5tn. In dollars it was $291.0bn,
			-- 51% below its 2020 peak of $599.0bn: the naira lost value, the economy didn't shrink."
			VAR _y = [GDP_latest_year]
			VAR _g = [Growth_latest]
			VAR _n = [GDP_naira_latest]
			VAR _u = [GDP_usd_latest]
			VAR _t = ADDCOLUMNS ( VALUES ( econ_year[year] ), "@u", CALCULATE ( [GDP_usd] ) )
			VAR _pk = TOPN ( 1, _t, [@u], DESC, econ_year[year], DESC )
			VAR _pk_y = MAXX ( _pk, econ_year[year] )
			VAR _pk_u = MAXX ( _pk, [@u] )
			VAR _pk_n = CALCULATE ( [GDP_naira], econ_year[year] = _pk_y )
			RETURN
			    IF (
			        ISBLANK ( _n ),
			        "No GDP data for this selection.",
			        "The economy " & IF ( _g >= 0, "grew ", "shrank " ) & FORMAT ( ABS ( _g ), "0.0%" )
			            & " after inflation in " & _y & ", to " & "₦" & SWITCH ( TRUE (), ABS ( _n ) >= 1e12, FORMAT ( _n / 1e12, "#,0.0" ) & "tn", FORMAT ( _n / 1e9, "#,0.0" ) & "bn" ) & ". "
			            & IF (
			                _pk_y = _y,
			                "In dollars it was " & "$" & SWITCH ( TRUE (), ABS ( _u ) >= 1e12, FORMAT ( _u / 1e12, "#,0.0" ) & "tn", FORMAT ( _u / 1e9, "#,0.0" ) & "bn" ) & ", the highest in this period.",
			                "In dollars it was " & "$" & SWITCH ( TRUE (), ABS ( _u ) >= 1e12, FORMAT ( _u / 1e12, "#,0.0" ) & "tn", FORMAT ( _u / 1e9, "#,0.0" ) & "bn" ) & ", " & FORMAT ( 1 - DIVIDE ( _u, _pk_u ), "0%" )
			                    & " below its " & _pk_y & " peak of " & "$" & SWITCH ( TRUE (), ABS ( _pk_u ) >= 1e12, FORMAT ( _pk_u / 1e12, "#,0.0" ) & "tn", FORMAT ( _pk_u / 1e9, "#,0.0" ) & "bn" )
			                    & IF ( _n > _pk_n, ": the naira lost value, the economy didn't shrink.", "." )
			            )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Real_terms_narrative =
			-- e.g. "States received ₦708.2bn in Apr 2026, 3.4× the ₦206.8bn of Jan 2020. In Apr 2026 prices,
			-- Jan 2020 was worth ₦702.3bn, so in real terms states received 0.8% more."
			VAR _first = CALCULATE ( MIN ( faac[disbursement_date] ) )
			VAR _last = CALCULATE ( MAX ( faac[disbursement_date] ) )
			VAR _base = [Price_base_month]
			VAR _p1 = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _first, 0 ) )
			VAR _p2 = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _last, 0 ) )
			VAR _t1 = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _first, 0 ) )
			VAR _t2 = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _last, 0 ) )
			VAR _chg = DIVIDE ( _t2, _t1 ) - 1
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _p2 ) || _first = _last, "Select more than one month to compare.",
			        ISBLANK ( _t2 ),
			            "Price data for " & FORMAT ( _last, "mmm yyyy" ) & " isn't out yet, so it can't be compared in real terms.",
			        "States received " & "₦" & SWITCH ( TRUE (), ABS ( _p2 ) >= 1e12, FORMAT ( _p2 / 1e12, "#,0.0" ) & "tn", FORMAT ( _p2 / 1e9, "#,0.0" ) & "bn" ) & " in " & FORMAT ( _last, "mmm yyyy" ) & ", "
			            & FORMAT ( DIVIDE ( _p2, _p1 ), "0.0" ) & "× the " & "₦" & SWITCH ( TRUE (), ABS ( _p1 ) >= 1e12, FORMAT ( _p1 / 1e12, "#,0.0" ) & "tn", FORMAT ( _p1 / 1e9, "#,0.0" ) & "bn" ) & " of "
			            & FORMAT ( _first, "mmm yyyy" ) & ". In " & FORMAT ( _base, "mmm yyyy" ) & " prices, "
			            & FORMAT ( _first, "mmm yyyy" ) & " was worth " & "₦" & SWITCH ( TRUE (), ABS ( _t1 ) >= 1e12, FORMAT ( _t1 / 1e12, "#,0.0" ) & "tn", FORMAT ( _t1 / 1e9, "#,0.0" ) & "bn" )
			            & ", so in real terms states received "
			            & IF ( ROUND ( _chg, 3 ) = 0, "about the same.", FORMAT ( ABS ( _chg ), "0.0%" ) & IF ( _chg > 0, " more.", " less." ) )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Administration_narrative =
			-- e.g. "Inflation averaged 10.6% under Jonathan (from Jan 2011), 13.4% under Buhari and 24.0% under
			-- Tinubu (so far). The naira lost the most value under Tinubu: 55.9%."
			VAR _now = CALCULATE ( MAX ( dim_administration[first_disbursement_month] ), REMOVEFILTERS ( dim_administration ) )
			VAR _t =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dim_administration[president] ),
			            "@start", CALCULATE ( MIN ( dim_administration[first_disbursement_month] ) ),
			            "@inf", [Inflation_yoy],
			            "@inf_from", CALCULATE ( MIN ( econ_month[month_date] ), NOT ISBLANK ( econ_month[inflation_yoy] ) ),
			            "@naira", [Term_naira_change]
			        ),
			        NOT ISBLANK ( [@inf] )
			    )
			VAR _n = COUNTROWS ( _t )
			VAR _items =
			    ADDCOLUMNS (
			        _t,
			        "@rank", RANKX ( _t, [@start], , ASC ),
			        "@text",
			            FORMAT ( [@inf], "0.0%" ) & " under " & dim_administration[president]
			                & IF ( [@inf_from] > [@start], " (from " & FORMAT ( [@inf_from], "mmm yyyy" ) & ")" )
			                & IF ( [@start] = _now, " (so far)" )
			    )
			VAR _list =
			    CONCATENATEX ( FILTER ( _items, [@rank] < _n ), [@text], ", ", [@start], ASC )
			        & IF ( _n > 1, " and " ) & MAXX ( FILTER ( _items, [@rank] = _n ), [@text] )
			VAR _worst = TOPN ( 1, FILTER ( _t, NOT ISBLANK ( [@naira] ) ), [@naira], ASC )
			RETURN
			    IF (
			        _n = 0,
			        "No inflation data for this selection.",
			        "Inflation averaged " & _list & "."
			            & IF (
			                NOT ISEMPTY ( _worst ) && MAXX ( _worst, [@naira] ) < 0,
			                " The naira lost the most value under " & MAXX ( _worst, dim_administration[president] ) & ": "
			                    & FORMAT ( - MAXX ( _worst, [@naira] ), "0.0%" ) & "."
			            )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Inflation_definition =
			"How much prices rose compared with the same month a year earlier (World Bank consumer price index)."
		displayFolder: 06 Titles & Labels\Tooltips

	measure Naira_value_definition =
			"How many more or fewer US dollars a naira buys than before. Negative means the naira lost value."
		displayFolder: 06 Titles & Labels\Tooltips

	measure Real_growth_definition =
			"How much the economy grew in the year after removing price rises."
		displayFolder: 06 Titles & Labels\Tooltips

	measure GDP_per_person_definition =
			"The economy's total output divided by the population. It is an average, not what a typical person earns."
		displayFolder: 06 Titles & Labels\Tooltips

	measure Today_prices_definition =
			"Today's prices: each month's amount restated in " & FORMAT ( [Price_base_month], "mmm yyyy" )
			    & " prices, using the World Bank consumer price index."
		displayFolder: 06 Titles & Labels\Tooltips

	measure Econ_month_definitions =
			"Inflation: " & [Inflation_definition] & "  Naira value: " & [Naira_value_definition]
		displayFolder: 06 Titles & Labels\Tooltips

	measure Econ_year_definitions =
			"Real growth: " & [Real_growth_definition] & "  Per person: " & [GDP_per_person_definition]
		displayFolder: 06 Titles & Labels\Tooltips

	measure President_definitions =
			"Averages are over the months or years each president was in office. Naira value compares the rate at the start "
			    & "and end of the term. A year goes to the president in office for most of it."
		displayFolder: 06 Titles & Labels\Tooltips

	measure Econ_month_tooltip_title =
			-- e.g. "Jul 2026 · Tinubu"
			FORMAT ( MAX ( econ_month[month_date] ), "mmm yyyy" ) & " · " & SELECTEDVALUE ( econ_month[president] )
		displayFolder: 06 Titles & Labels\Tooltips

	measure Econ_year_tooltip_title =
			-- e.g. "2024 · Tinubu"; years before 1999 have no president
			MAX ( econ_year[year] ) & " · "
			    & COALESCE ( SELECTEDVALUE ( econ_year[president] ), "Before 1999 (military rule)" )
		displayFolder: 06 Titles & Labels\Tooltips

	measure GDP_year_tooltip_text =
			-- e.g. "From 2023, GDP rose 18.7% in naira but fell 48.2% in dollars: the naira lost value,
			-- the economy didn't shrink."
			VAR _y = MAX ( econ_year[year] )
			VAR _n = [GDP_naira]
			VAR _u = [GDP_usd]
			VAR _n0 = CALCULATE ( [GDP_naira], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _y - 1 )
			VAR _u0 = CALCULATE ( [GDP_usd], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _y - 1 )
			VAR _cn = DIVIDE ( _n, _n0 ) - 1
			VAR _cu = DIVIDE ( _u, _u0 ) - 1
			RETURN
			    IF (
			        NOT ISBLANK ( _n0 ),
			        "From " & ( _y - 1 ) & ", GDP " & IF ( _cn >= 0, "rose ", "fell " ) & FORMAT ( ABS ( _cn ), "0.0%" )
			            & " in naira" & IF ( ( _cn >= 0 ) = ( _cu >= 0 ), " and ", " but " )
			            & IF ( _cu >= 0, "rose ", "fell " ) & FORMAT ( ABS ( _cu ), "0.0%" ) & " in dollars"
			            & IF ( _cn > 0 && _cu < 0, ": the naira lost value, the economy didn't shrink.", "." )
			    )
		displayFolder: 06 Titles & Labels\Tooltips

	measure Real_terms_tooltip_title =
			-- e.g. "Jan 2020 · Buhari"
			FORMAT ( MAX ( faac[disbursement_date] ), "mmm yyyy" ) & " · " & SELECTEDVALUE ( faac[president] )
		displayFolder: 06 Titles & Labels\Tooltips

	measure Real_terms_tooltip_text =
			-- e.g. "Prices rose 3.40× from Jan 2020 to Apr 2026 (CPI 300.7 → 1,021.2), so ₦206.8bn then
			-- bought what ₦702.2bn buys in Apr 2026."
			VAR _m = MAX ( faac[disbursement_date] )
			VAR _base = [Price_base_month]
			VAR _cpi = MAX ( econ_month[cpi_index] )
			VAR _base_cpi = CALCULATE ( MAX ( econ_month[cpi_index] ), REMOVEFILTERS (), econ_month[month_date] = _base )
			VAR _p = [Net_paid]
			VAR _t = [Net_today_prices]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _p ), BLANK (),
			        ISBLANK ( _cpi ), "Price data for " & FORMAT ( _m, "mmm yyyy" ) & " isn't out yet.",
			        _m = _base, "This is the base month, so today's prices equal what was paid.",
			        "Prices rose " & FORMAT ( [Price_multiplier], "0.00" ) & "× from " & FORMAT ( _m, "mmm yyyy" ) & " to "
			            & FORMAT ( _base, "mmm yyyy" ) & " (CPI " & FORMAT ( _cpi, "#,0.0" ) & " → "
			            & FORMAT ( _base_cpi, "#,0.0" ) & "), so ₦" & FORMAT ( _p / 1e9, "#,0.0" ) & "bn then bought what ₦"
			            & FORMAT ( _t / 1e9, "#,0.0" ) & "bn buys in " & FORMAT ( _base, "mmm yyyy" ) & "."
			    )
		displayFolder: 06 Titles & Labels\Tooltips

	measure President_tooltip_title =
			COALESCE ( SELECTEDVALUE ( dim_administration[full_name] ), "Before 1999 (military rule)" )
		displayFolder: 06 Titles & Labels\Tooltips

	measure President_tooltip_subtitle =
			-- e.g. "APC · 29 May 2015 to 29 May 2023 · 96 months of data"
			VAR _end = SELECTEDVALUE ( dim_administration[term_end] )
			RETURN
			    IF (
			        HASONEVALUE ( dim_administration[president] ),
			        SELECTEDVALUE ( dim_administration[party] ) & " · "
			            & FORMAT ( SELECTEDVALUE ( dim_administration[term_start] ), "d mmm yyyy" ) & " to "
			            & IF ( ISBLANK ( _end ), "present", FORMAT ( _end, "d mmm yyyy" ) )
			            & " · " & FORMAT ( [Term_months] + 0, "#,0" ) & " months of data",
			        "Years " & MIN ( econ_year[year] ) & " to " & MAX ( econ_year[year] )
			    )
		displayFolder: 06 Titles & Labels\Tooltips

	measure Term_rate_text =
			-- e.g. "₦198.86 in May 2015 → ₦461.42 in Apr 2023"
			VAR _first = CALCULATE ( MIN ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
			VAR _last = CALCULATE ( MAX ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _first ),
			        FORMAT ( CALCULATE ( [Naira_per_usd], econ_month[month_date] = _first ), "₦#,0.00" ) & " in "
			            & FORMAT ( _first, "mmm yyyy" ) & " → "
			            & FORMAT ( CALCULATE ( [Naira_per_usd], econ_month[month_date] = _last ), "₦#,0.00" ) & " in "
			            & FORMAT ( _last, "mmm yyyy" ),
			        "No monthly exchange rate data for this term yet"
			    )
		displayFolder: 06 Titles & Labels\Tooltips

	measure Price_multiplier =
			-- How many times prices rose between the hovered month and the base month, e.g. 3.40
			VAR _base = [Price_base_month]
			VAR _base_cpi = CALCULATE ( MAX ( econ_month[cpi_index] ), REMOVEFILTERS (), econ_month[month_date] = _base )
			RETURN
			    DIVIDE ( _base_cpi, MAX ( econ_month[cpi_index] ) )
		formatString: ×0.00
		displayFolder: 01 Base\Real terms

	measure Real_first_month =
			-- First FAAC month in the selection
			CALCULATE ( MIN ( faac[disbursement_date] ) )
		formatString: mmm yyyy
		displayFolder: 01 Base\Real terms

	measure Real_latest_month =
			CALCULATE ( MAX ( faac[disbursement_date] ) )
		formatString: mmm yyyy
		displayFolder: 01 Base\Real terms

	measure Net_first_month =
			-- Net in that month, in the prices picked on the Prices switch
			-- (calendar_table[month_date] is the last day of the month, hence EOMONTH)
			VAR _m = EOMONTH ( [Real_first_month], 0 )
			RETURN
			    CALCULATE ( [Net_prices], calendar_table[month_date] = _m )
		formatString: ₦#,0
		displayFolder: 01 Base\Real terms

	measure Net_latest_month =
			-- Net in that month, in the prices picked on the Prices switch
			-- (calendar_table[month_date] is the last day of the month, hence EOMONTH)
			VAR _m = EOMONTH ( [Real_latest_month], 0 )
			RETURN
			    CALCULATE ( [Net_prices], calendar_table[month_date] = _m )
		formatString: ₦#,0
		displayFolder: 01 Base\Real terms

	measure Change_as_paid =
			-- Latest month vs first month in the selection
			VAR _m1 = EOMONTH ( [Real_first_month], 0 )
			VAR _m2 = EOMONTH ( [Real_latest_month], 0 )
			RETURN
			    DIVIDE (
			        CALCULATE ( [Net_paid], calendar_table[month_date] = _m2 ),
			        CALCULATE ( [Net_paid], calendar_table[month_date] = _m1 )
			    ) - 1
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Base\Real terms

	measure Change_real =
			-- Latest month vs first month in the selection
			VAR _m1 = EOMONTH ( [Real_first_month], 0 )
			VAR _m2 = EOMONTH ( [Real_latest_month], 0 )
			RETURN
			    DIVIDE (
			        CALCULATE ( [Net_today_prices], calendar_table[month_date] = _m2 ),
			        CALCULATE ( [Net_today_prices], calendar_table[month_date] = _m1 )
			    ) - 1
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Base\Real terms

	measure Naira_value_colour =
			VAR _v = [Naira_value_change_yoy]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _v ) || ROUND ( _v, 4 ) = 0, "#C98A00", _v > 0, "#0E8A5F", "#C93C3C" )
		displayFolder: 04 Comparison\Colours

	measure Term_naira_colour =
			VAR _v = [Term_naira_change]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _v ) || ROUND ( _v, 4 ) = 0, "#C98A00", _v > 0, "#0E8A5F", "#C93C3C" )
		displayFolder: 04 Comparison\Colours

	measure Growth_sign_colour =
			VAR _v = [Real_GDP_growth]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _v ) || ROUND ( _v, 4 ) = 0, "#C98A00", _v > 0, "#0E8A5F", "#C93C3C" )
		displayFolder: 04 Comparison\Colours

	measure Change_as_paid_colour =
			VAR _v = [Change_as_paid]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _v ) || ROUND ( _v, 4 ) = 0, "#C98A00", _v > 0, "#0E8A5F", "#C93C3C" )
		displayFolder: 04 Comparison\Colours

	measure Change_real_colour =
			VAR _v = [Change_real]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _v ) || ROUND ( _v, 4 ) = 0, "#C98A00", _v > 0, "#0E8A5F", "#C93C3C" )
		displayFolder: 04 Comparison\Colours

	measure Prices_label =
			-- "as paid" or "in Apr 2026 prices", following the Prices switch
			IF (
			    SELECTEDVALUE ( Prices[Prices], "As paid" ) = "Today's prices",
			    "in " & FORMAT ( [Price_base_month], "mmm yyyy" ) & " prices",
			    "as paid"
			)
		displayFolder: 06 Titles & Labels\Text

	measure Real_first_month_text =
			FORMAT ( [Real_first_month], "mmm yyyy" ) & " · " & [Prices_label]
		displayFolder: 06 Titles & Labels\Text

	measure Real_latest_month_text =
			FORMAT ( [Real_latest_month], "mmm yyyy" ) & " · " & [Prices_label]
		displayFolder: 06 Titles & Labels\Text

	measure Change_period_text =
			-- e.g. "Jan 2020 to Apr 2026"
			FORMAT ( [Real_first_month], "mmm yyyy" ) & " to " & FORMAT ( [Real_latest_month], "mmm yyyy" )
		displayFolder: 06 Titles & Labels\Text

	measure GDP_per_person_naira_text =
			-- Second line of the GDP per person card, e.g. "₦1,858,879 per person"
			FORMAT ( [GDP_per_person_naira_latest], "₦#,0" ) & " per person"
		displayFolder: 06 Titles & Labels\Text

	measure Coverage_summary =
			-- One line for the Presidents page, e.g. "Data coverage: Obasanjo: No monthly data for this term yet · ..."
			-- Only partial terms are listed, so the line shrinks as older data is backfilled.
			VAR _t =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dim_administration[president] ),
			            "@note", [Term_coverage_text],
			            "@start", CALCULATE ( MIN ( dim_administration[term_start] ) )
			        ),
			        NOT ISBLANK ( [@note] ) && NOT ISBLANK ( dim_administration[president] )
			    )
			RETURN
			    IF (
			        NOT ISEMPTY ( _t ),
			        "Data coverage: " & CONCATENATEX ( _t, dim_administration[president] & ": " & [@note], "   ·   ", [@start], ASC )
			    )
		displayFolder: 06 Titles & Labels\Text

	measure Naira_latest_text =
			-- Card text, so Power BI's auto units don't shorten ₦1,354.97 to ₦1.35K
			FORMAT ( [Naira_latest], "₦#,0.00" )
		displayFolder: 06 Titles & Labels\Text

	measure GDP_per_person_usd_text =
			-- Card text, so Power BI's auto units don't shorten $1,224 to $1K
			FORMAT ( [GDP_per_person_usd_latest], "$#,0" )
		displayFolder: 06 Titles & Labels\Text

	measure Fresh_FAAC_grace_days =
			-- Days after a month ends before its FAAC data counts as due
			45
		formatString: 0
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_FAAC_warn_days =
			-- Days late that still count as amber; later is red
			15
		formatString: 0
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_FAAC_data_month =
			-- Newest month of FAAC data in the warehouse; ignores slicers on purpose
			CALCULATE ( MAX ( faac[disbursement_date] ), REMOVEFILTERS () )
		formatString: mmm yyyy
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_FAAC_status =
			-- 0 on time, 1 late (amber), 2 overdue (red), 3 refresh missed (red)
			VAR _grace = [Fresh_FAAC_grace_days]
			VAR _now = UTCNOW () + TIME ( 1, 0, 0 ) -- Lagos is UTC+1
			VAR _today = DATE ( YEAR ( _now ), MONTH ( _now ), DAY ( _now ) )
			VAR _x = _today - _grace
			-- Latest month whose grace period has passed
			VAR _required = IF ( _x = EOMONTH ( _x, 0 ), _x, EOMONTH ( _x, -1 ) )
			VAR _dataEnd = EOMONTH ( [Fresh_FAAC_data_month], 0 )
			VAR _lag = INT ( _required - _dataEnd )
			VAR _due = EOMONTH ( _dataEnd, 1 ) + _grace
			VAR _refreshed = MAX ( 'Refresh Time'[refreshed_at] )
			RETURN
			    SWITCH ( TRUE (),
			        _lag <= 0, 0,
			        _refreshed < _due, 3, -- late, and the dashboard hasn't refreshed since the data was due
			        _lag <= [Fresh_FAAC_warn_days], 1,
			        2
			    )
		formatString: 0
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_FAAC_text =
			-- e.g. "Latest data: Apr 2026". The pill colour carries on time / late / overdue.
			"Latest data: " & FORMAT ( [Fresh_FAAC_data_month], "mmm yyyy" )
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_CPI_grace_days =
			-- Days after a month ends before its World Bank CPI and exchange-rate data counts as due
			60
		formatString: 0
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_CPI_warn_days =
			-- Days late that still count as amber; later is red
			30
		formatString: 0
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_CPI_data_month =
			-- Newest month of World Bank CPI and exchange-rate data in the warehouse; ignores slicers on purpose
			-- CPI and FX must both have arrived, so take the earlier of the two
			MIN (
			    CALCULATE ( MAX ( econ_month[month_date] ), REMOVEFILTERS (), NOT ISBLANK ( econ_month[inflation_yoy] ) ),
			    CALCULATE ( MAX ( econ_month[month_date] ), REMOVEFILTERS (), NOT ISBLANK ( econ_month[naira_per_usd] ) )
			)
		formatString: mmm yyyy
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_CPI_status =
			-- 0 on time, 1 late (amber), 2 overdue (red), 3 refresh missed (red)
			VAR _grace = [Fresh_CPI_grace_days]
			VAR _now = UTCNOW () + TIME ( 1, 0, 0 ) -- Lagos is UTC+1
			VAR _today = DATE ( YEAR ( _now ), MONTH ( _now ), DAY ( _now ) )
			VAR _x = _today - _grace
			-- Latest month whose grace period has passed
			VAR _required = IF ( _x = EOMONTH ( _x, 0 ), _x, EOMONTH ( _x, -1 ) )
			VAR _dataEnd = EOMONTH ( [Fresh_CPI_data_month], 0 )
			VAR _lag = INT ( _required - _dataEnd )
			VAR _due = EOMONTH ( _dataEnd, 1 ) + _grace
			VAR _refreshed = MAX ( 'Refresh Time'[refreshed_at] )
			RETURN
			    SWITCH ( TRUE (),
			        _lag <= 0, 0,
			        _refreshed < _due, 3, -- late, and the dashboard hasn't refreshed since the data was due
			        _lag <= [Fresh_CPI_warn_days], 1,
			        2
			    )
		formatString: 0
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_CPI_text =
			-- e.g. "Latest data: Apr 2026". The pill colour carries on time / late / overdue.
			"Latest data: " & FORMAT ( [Fresh_CPI_data_month], "mmm yyyy" )
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_GDP_grace_days =
			-- Days after a year ends before its GDP counts as due
			270
		formatString: 0
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_GDP_warn_days =
			-- Days late that still count as amber; later is red
			90
		formatString: 0
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_GDP_data_year =
			-- Newest year with GDP in the warehouse; ignores slicers on purpose
			CALCULATE ( MAX ( econ_year[year] ), REMOVEFILTERS (), NOT ISBLANK ( econ_year[gdp_usd] ) )
		formatString: 0
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_GDP_status =
			-- 0 on time, 1 late (amber), 2 overdue (red), 3 refresh missed (red)
			VAR _grace = [Fresh_GDP_grace_days]
			VAR _now = UTCNOW () + TIME ( 1, 0, 0 ) -- Lagos is UTC+1
			VAR _today = DATE ( YEAR ( _now ), MONTH ( _now ), DAY ( _now ) )
			VAR _x = _today - _grace
			-- Latest year whose grace period has passed
			VAR _requiredYear = IF ( _x >= DATE ( YEAR ( _x ), 12, 31 ), YEAR ( _x ), YEAR ( _x ) - 1 )
			VAR _dataYear = [Fresh_GDP_data_year]
			VAR _lag = INT ( DATE ( _requiredYear, 12, 31 ) - DATE ( _dataYear, 12, 31 ) )
			VAR _due = DATE ( _dataYear + 1, 12, 31 ) + _grace
			VAR _refreshed = MAX ( 'Refresh Time'[refreshed_at] )
			RETURN
			    SWITCH ( TRUE (),
			        _lag <= 0, 0,
			        _refreshed < _due, 3,
			        _lag <= [Fresh_GDP_warn_days], 1,
			        2
			    )
		formatString: 0
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_GDP_text =
			-- e.g. "Latest data: 2025". The pill colour carries on time / late / overdue.
			"Latest data: " & [Fresh_GDP_data_year]
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_refreshed_text =
			-- e.g. "5 Nov 2026, 08:14" (Lagos time)
			FORMAT ( MAX ( 'Refresh Time'[refreshed_at] ), "d mmm yyyy, hh:nn" )
		displayFolder: 05 Visual Helpers\Freshness

	measure Fresh_css =
			-- Shared styles for the freshness strips (HTML attributes use single quotes)
			"<style>"
			    & "html{font-size:calc(100vh / 60)}html,body{margin:0;padding:0;overflow:hidden}"
			    & ".fw{position:fixed;top:3rem;right:3rem;font-family:Segoe UI,sans-serif}"
			    & ".fs{display:inline-flex;align-items:center;gap:8rem;padding:4rem 12rem 4rem 5rem;border-radius:999rem;background:#fff;border:1rem solid;font-size:10rem;color:#14231D;white-space:nowrap}"
			    & ".pl{display:inline-flex;align-items:center;gap:5rem;color:#fff;font-weight:600;font-size:9.5rem;padding:4rem 10rem;border-radius:999rem}"
			    & ".pl i{width:6rem;height:6rem;border-radius:50%;background:#fff;display:inline-block}"
			    & ".sr{display:inline-flex;flex-direction:column;line-height:1.25;text-align:left}"
			    & ".sr b{font-size:8rem;letter-spacing:1.4rem;color:#5E6E67;font-weight:600}"
			    & ".sr span{font-weight:600}"
			    & ".sp{width:1rem;height:24rem;background:#E3E9E6;display:inline-block}"
			    & ".fc{color:#5E6E67;border-left:1rem solid #E3E9E6;padding-left:9rem;line-height:1.3;text-align:left}"
			    & "</style>"
		displayFolder: 05 Visual Helpers\Freshness

	measure Freshness_faac_html =
			-- Freshness strip: FAAC pages. The worse source sets the pill.
			VAR _w = [Fresh_FAAC_status]
			VAR _col = SWITCH ( _w, 0, "#0E8A5F", 1, "#C98A00", "#C93C3C" )
			VAR _lab = SWITCH ( _w, 0, "On time", 1, "Late", 2, "Overdue", "Refresh missed" )
			RETURN
			    [Fresh_css]
			    & "<div class='fw'><div class='fs' style='border-color:" & _col & "55'>"
			    & "<span class='pl' style='background:" & _col & "'><i></i>" & _lab & "</span>"
			    & "<span class='sr'><b>FAAC · MONTHLY</b><span>" & [Fresh_FAAC_text] & "</span></span>"
			    & "<span class='fc'>Refreshed<br>" & [Fresh_refreshed_text] & "</span>"
			    & "</div></div>"
		displayFolder: 05 Visual Helpers\HTML

	measure Freshness_real_html =
			-- Freshness strip: FAAC in real terms. The worse source sets the pill.
			VAR _w = MAX ( [Fresh_FAAC_status], [Fresh_CPI_status] )
			VAR _col = SWITCH ( _w, 0, "#0E8A5F", 1, "#C98A00", "#C93C3C" )
			VAR _lab = SWITCH ( _w, 0, "On time", 1, "Late", 2, "Overdue", "Refresh missed" )
			RETURN
			    [Fresh_css]
			    & "<div class='fw'><div class='fs' style='border-color:" & _col & "55'>"
			    & "<span class='pl' style='background:" & _col & "'><i></i>" & _lab & "</span>"
			    & "<span class='sr'><b>FAAC · MONTHLY</b><span>" & [Fresh_FAAC_text] & "</span></span>"
			    & "<span class='sp'></span>"
			    & "<span class='sr'><b>CPI · MONTHLY</b><span>" & [Fresh_CPI_text] & "</span></span>"
			    & "<span class='fc'>Refreshed<br>" & [Fresh_refreshed_text] & "</span>"
			    & "</div></div>"
		displayFolder: 05 Visual Helpers\HTML

	measure Freshness_econ_html =
			-- Freshness strip: Economy pages. The worse source sets the pill.
			VAR _w = MAX ( [Fresh_CPI_status], [Fresh_GDP_status] )
			VAR _col = SWITCH ( _w, 0, "#0E8A5F", 1, "#C98A00", "#C93C3C" )
			VAR _lab = SWITCH ( _w, 0, "On time", 1, "Late", 2, "Overdue", "Refresh missed" )
			RETURN
			    [Fresh_css]
			    & "<div class='fw'><div class='fs' style='border-color:" & _col & "55'>"
			    & "<span class='pl' style='background:" & _col & "'><i></i>" & _lab & "</span>"
			    & "<span class='sr'><b>CPI &amp; FX · MONTHLY</b><span>" & [Fresh_CPI_text] & "</span></span>"
			    & "<span class='sp'></span>"
			    & "<span class='sr'><b>GDP · YEARLY</b><span>" & [Fresh_GDP_text] & "</span></span>"
			    & "<span class='fc'>Refreshed<br>" & [Fresh_refreshed_text] & "</span>"
			    & "</div></div>"
		displayFolder: 05 Visual Helpers\HTML

	measure Flip_css =
			-- Shared styles for the flip cards (HTML Content (lite) visual; attributes use single quotes)
			"<style>html{font-size:calc(100vh / 96)}html,body{margin:0;padding:0;overflow:hidden}"
			    & ".fc{position:fixed;top:0;left:0;right:0;bottom:0;perspective:1000rem;font-family:Segoe UI,sans-serif}"
			    & ".fi{position:relative;width:100%;height:100%;transition:transform .6s;transform-style:preserve-3d}"
			    & ".fc:hover .fi{transform:rotateY(180deg)}"
			    & ".face{position:absolute;top:0;left:0;right:0;bottom:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:12rem;overflow:hidden;box-sizing:border-box}"
			    & ".front{background:#fff;box-shadow:0 1rem 3rem rgba(11,61,46,.10);padding:12rem 14rem 0 16rem;border-top:4rem solid #0B3D2E}"
			    & ".lbl{font-size:9rem;letter-spacing:1.8rem;color:#5E6E67;font-weight:600}"
			    & ".val{font-size:22rem;font-weight:700;margin-top:3rem;color:#14231D;letter-spacing:-.3rem}"
			    & ".val small{font-size:12rem;font-weight:600;color:#5E6E67;margin-left:2rem}"
			    & ".chg{display:flex;align-items:center;gap:6rem;font-size:9.5rem;margin-top:4rem;color:#5E6E67;white-space:nowrap}"
			    & ".bd{font-weight:700;padding:2rem 6rem;border-radius:5rem}"
			    & ".sp{position:absolute;right:12rem;top:28rem}"
			    & ".hint{position:absolute;right:12rem;bottom:6rem;font-size:7.5rem;color:#9AABA3;letter-spacing:.4rem}"
			    & ".asof{position:absolute;left:16rem;bottom:6rem;font-size:8rem;color:#9AABA3}"
			    & ".back{background:#0B3D2E;color:#fff;transform:rotateY(180deg);padding:12rem 14rem}"
			    & ".bt{font-size:8.5rem;letter-spacing:1.8rem;color:#E2B53E;font-weight:600}"
			    & ".back p{margin:5rem 0 0;font-size:10.5rem;line-height:1.4}"
			    & ".t3{display:grid;grid-template-columns:14rem 1fr auto 30rem;gap:3rem 8rem;margin-top:7rem;font-size:10.5rem;align-items:center}"
			    & ".t3 span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.t3 b{color:#E2B53E}.t3 .v{font-weight:700;text-align:right}.t3 .sh{opacity:.75;text-align:right;font-size:9.5rem}"
			    & "</style>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure Gross_flipcard =
			-- Flip card: gross allocation. Front = value, change and 6-month sparkline; back = top 3 revenue streams
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _v = [Gross_curr]
			VAR _chg = [Gross_PnP]
			VAR _col = [Gross_colour]
			VAR _mark = SWITCH ( TRUE (), ISBLANK ( _chg ), "", ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			VAR _badge = IF ( ISBLANK ( _chg ), "No change data", _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) )
			VAR _last = [Latest_month]
			VAR _pts =
			    ADDCOLUMNS (
			        FILTER (
			            ALL ( calendar_table[month_date] ),
			            calendar_table[month_date] > EOMONTH ( _last, -6 ) && calendar_table[month_date] <= EOMONTH ( _last, 0 )
			        ),
			        "@v", VAR _m = calendar_table[month_date] RETURN CALCULATE ( [Gross], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m )
			    )
			VAR _pi = ADDCOLUMNS ( _pts, "@i", RANKX ( _pts, calendar_table[month_date], , ASC ) - 1 )
			VAR _n = COUNTROWS ( _pts )
			VAR _lo = MINX ( _pts, [@v] )
			VAR _hi = MAXX ( _pts, [@v] )
			VAR _xy = ADDCOLUMNS ( _pi, "@x", 3 + [@i] * 74 / MAX ( _n - 1, 1 ), "@y", 27 - DIVIDE ( [@v] - _lo, _hi - _lo, 0.5 ) * 22 )
			VAR _poly = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0" ) & "," & FORMAT ( [@y], "0.0" ), " ", [@i], ASC )
			VAR _end = TOPN ( 1, _xy, [@i], DESC )
			VAR _spark =
			    "<svg viewBox='0 0 80 30' style='width:80rem;height:30rem'><polyline points='" & _poly & "' fill='none' stroke='#0B3D2E' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>"
			        & "<circle cx='" & FORMAT ( MAXX ( _end, [@x] ), "0.0" ) & "' cy='" & FORMAT ( MAXX ( _end, [@y] ), "0.0" ) & "' r='3' fill='#0B3D2E'/></svg>"
			-- Back: the 3 biggest revenue streams this period, ranked live
			VAR _lines = UNION (
			        ROW ( "n", "Statutory allocation", "v", CALCULATE ( [Statutory], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "VAT", "v", CALCULATE ( [VAT], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "Oil derivation", "v", CALCULATE ( [Oil_Derivation], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "Exchange gain", "v", CALCULATE ( [Exchange_Gain], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "Ecology fund", "v", CALCULATE ( [Ecology], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "Other income", "v", CALCULATE ( [Others_Income], 'Period Calc'[Name] = "Current" ) )
			    )
			VAR _tot = [Gross_curr]
			VAR _top = TOPN ( 3, FILTER ( _lines, [v] > 0 ), [v], DESC )
			VAR _rk = ADDCOLUMNS ( _top, "r", RANKX ( _top, [v], , DESC ) )
			VAR _rows = CONCATENATEX ( _rk, "<b>" & [r] & "</b><span>" & [n] & "</span><span class='v'>" & SWITCH ( TRUE (), ABS ( [v] ) >= 1e12, _sym & FORMAT ( [v] / 1e12, "0.00" ) & "tn", ABS ( [v] ) >= 1e9, _sym & FORMAT ( [v] / 1e9, "0.0" ) & "bn", _sym & FORMAT ( [v] / 1e6, "0.0" ) & "m" ) & "</span><span class='sh'>" & FORMAT ( DIVIDE ( [v], _tot ), "0%" ) & "</span>", "", [r], ASC )
			RETURN
			    [Flip_css]
			        & "<div class='fc'><div class='fi'><div class='face front'><div class='lbl'>GROSS ALLOCATION</div>"
			        & "<div class='val'>" & SWITCH ( TRUE (), ABS ( _v ) >= 1e12, _sym & FORMAT ( _v / 1e12, "0.00" ) & "tn", ABS ( _v ) >= 1e9, _sym & FORMAT ( _v / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _v / 1e6, "0.0" ) & "m" ) & "</div>"
			        & "<div class='chg'><span class='bd' style='color:" & _col & ";background:" & SWITCH ( _col, "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#FBF1DC" ) & "'>" & _badge & "</span>" & [Periodic_text] & "</div>"
			        & "<div class='sp'>" & _spark & "</div><div class='hint'>HOVER FOR INSIGHT &#8635;</div></div>"
			        & "<div class='face back'><div class='bt'>TOP 3 REVENUE STREAMS</div>" & "<div class='t3'>" & _rows & "</div>" & "</div></div></div>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure Deductions_flipcard =
			-- Flip card: deductions. Front = value, change and 6-month sparkline; back = top 3 deduction lines
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _v = [Deductions_curr]
			VAR _chg = [Deductions_PnP]
			VAR _col = [Deductions_colour]
			VAR _mark = SWITCH ( TRUE (), ISBLANK ( _chg ), "", ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			VAR _badge = IF ( ISBLANK ( _chg ), "No change data", _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) )
			VAR _last = [Latest_month]
			VAR _pts =
			    ADDCOLUMNS (
			        FILTER (
			            ALL ( calendar_table[month_date] ),
			            calendar_table[month_date] > EOMONTH ( _last, -6 ) && calendar_table[month_date] <= EOMONTH ( _last, 0 )
			        ),
			        "@v", VAR _m = calendar_table[month_date] RETURN CALCULATE ( [Deductions], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m )
			    )
			VAR _pi = ADDCOLUMNS ( _pts, "@i", RANKX ( _pts, calendar_table[month_date], , ASC ) - 1 )
			VAR _n = COUNTROWS ( _pts )
			VAR _lo = MINX ( _pts, [@v] )
			VAR _hi = MAXX ( _pts, [@v] )
			VAR _xy = ADDCOLUMNS ( _pi, "@x", 3 + [@i] * 74 / MAX ( _n - 1, 1 ), "@y", 27 - DIVIDE ( [@v] - _lo, _hi - _lo, 0.5 ) * 22 )
			VAR _poly = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0" ) & "," & FORMAT ( [@y], "0.0" ), " ", [@i], ASC )
			VAR _end = TOPN ( 1, _xy, [@i], DESC )
			VAR _spark =
			    "<svg viewBox='0 0 80 30' style='width:80rem;height:30rem'><polyline points='" & _poly & "' fill='none' stroke='#0B3D2E' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>"
			        & "<circle cx='" & FORMAT ( MAXX ( _end, [@x] ), "0.0" ) & "' cy='" & FORMAT ( MAXX ( _end, [@y] ), "0.0" ) & "' r='3' fill='#0B3D2E'/></svg>"
			-- Back: the 3 biggest deduction lines this period, ranked live
			VAR _lines = UNION (
			        ROW ( "n", "External debt", "v", CALCULATE ( [External_Debt], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "Contractual (ISPO)", "v", CALCULATE ( [Contractual_Obligation], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "NDDC / HYPPADEC", "v", CALCULATE ( [NDDC_Transfer], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "Other (see note)", "v", CALCULATE ( [Other_Deductions_Note], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "Unlabelled", "v", CALCULATE ( [Deduction_Misc], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "Other deductions", "v", CALCULATE ( [Other_Deduction], 'Period Calc'[Name] = "Current" ) )
			    )
			VAR _tot = [Deductions_curr]
			VAR _top = TOPN ( 3, FILTER ( _lines, [v] > 0 ), [v], DESC )
			VAR _rk = ADDCOLUMNS ( _top, "r", RANKX ( _top, [v], , DESC ) )
			VAR _rows = CONCATENATEX ( _rk, "<b>" & [r] & "</b><span>" & [n] & "</span><span class='v'>" & SWITCH ( TRUE (), ABS ( [v] ) >= 1e12, _sym & FORMAT ( [v] / 1e12, "0.00" ) & "tn", ABS ( [v] ) >= 1e9, _sym & FORMAT ( [v] / 1e9, "0.0" ) & "bn", _sym & FORMAT ( [v] / 1e6, "0.0" ) & "m" ) & "</span><span class='sh'>" & FORMAT ( DIVIDE ( [v], _tot ), "0%" ) & "</span>", "", [r], ASC )
			RETURN
			    [Flip_css]
			        & "<div class='fc'><div class='fi'><div class='face front'><div class='lbl'>DEDUCTIONS</div>"
			        & "<div class='val'>" & SWITCH ( TRUE (), ABS ( _v ) >= 1e12, _sym & FORMAT ( _v / 1e12, "0.00" ) & "tn", ABS ( _v ) >= 1e9, _sym & FORMAT ( _v / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _v / 1e6, "0.0" ) & "m" ) & "</div>"
			        & "<div class='chg'><span class='bd' style='color:" & _col & ";background:" & SWITCH ( _col, "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#FBF1DC" ) & "'>" & _badge & "</span>" & [Periodic_text] & "</div>"
			        & "<div class='sp'>" & _spark & "</div><div class='hint'>HOVER FOR INSIGHT &#8635;</div></div>"
			        & "<div class='face back'><div class='bt'>TOP 3 DEDUCTION LINES</div>" & "<div class='t3'>" & _rows & "</div>" & "</div></div></div>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure Net_flipcard =
			-- Flip card: net received. Front = value, change and 6-month sparkline; back = what it means
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _v = [Net_curr]
			VAR _chg = [Net_PnP]
			VAR _col = [Net_colour]
			VAR _mark = SWITCH ( TRUE (), ISBLANK ( _chg ), "", ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			VAR _badge = IF ( ISBLANK ( _chg ), "No change data", _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) )
			VAR _last = [Latest_month]
			VAR _pts =
			    ADDCOLUMNS (
			        FILTER (
			            ALL ( calendar_table[month_date] ),
			            calendar_table[month_date] > EOMONTH ( _last, -6 ) && calendar_table[month_date] <= EOMONTH ( _last, 0 )
			        ),
			        "@v", VAR _m = calendar_table[month_date] RETURN CALCULATE ( [Net], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m )
			    )
			VAR _pi = ADDCOLUMNS ( _pts, "@i", RANKX ( _pts, calendar_table[month_date], , ASC ) - 1 )
			VAR _n = COUNTROWS ( _pts )
			VAR _lo = MINX ( _pts, [@v] )
			VAR _hi = MAXX ( _pts, [@v] )
			VAR _xy = ADDCOLUMNS ( _pi, "@x", 3 + [@i] * 74 / MAX ( _n - 1, 1 ), "@y", 27 - DIVIDE ( [@v] - _lo, _hi - _lo, 0.5 ) * 22 )
			VAR _poly = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0" ) & "," & FORMAT ( [@y], "0.0" ), " ", [@i], ASC )
			VAR _end = TOPN ( 1, _xy, [@i], DESC )
			VAR _spark =
			    "<svg viewBox='0 0 80 30' style='width:80rem;height:30rem'><polyline points='" & _poly & "' fill='none' stroke='#0B3D2E' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>"
			        & "<circle cx='" & FORMAT ( MAXX ( _end, [@x] ), "0.0" ) & "' cy='" & FORMAT ( MAXX ( _end, [@y] ), "0.0" ) & "' r='3' fill='#0B3D2E'/></svg>"
			-- Back: how much of each 100 allocated states kept, vs the 12-month average
			VAR _keep = DIVIDE ( [Net_curr], [Gross_curr] ) * 100
			VAR _avg =
			    AVERAGEX (
			        FILTER ( ALL ( calendar_table[month_date] ), calendar_table[month_date] > EOMONTH ( _last, -12 ) && calendar_table[month_date] <= EOMONTH ( _last, 0 ) ),
			        VAR _m = calendar_table[month_date]
			        RETURN DIVIDE ( CALCULATE ( [Net], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), CALCULATE ( [Gross], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ) ) * 100
			    )
			VAR _who = IF ( [Area_label] = "All states", "States", [Area_label] )
			VAR _txt = _who & " kept ₦" & FORMAT ( _keep, "0" ) & " of every ₦100 allocated in " & [Period_label] & ", "
			    & IF ( ROUND ( _keep, 0 ) = ROUND ( _avg, 0 ), "the same as", IF ( _keep > _avg, "above", "below" ) ) & " the 12-month average of ₦" & FORMAT ( _avg, "0" ) & "."
			RETURN
			    [Flip_css]
			        & "<div class='fc'><div class='fi'><div class='face front'><div class='lbl'>NET RECEIVED</div>"
			        & "<div class='val'>" & SWITCH ( TRUE (), ABS ( _v ) >= 1e12, _sym & FORMAT ( _v / 1e12, "0.00" ) & "tn", ABS ( _v ) >= 1e9, _sym & FORMAT ( _v / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _v / 1e6, "0.0" ) & "m" ) & "</div>"
			        & "<div class='chg'><span class='bd' style='color:" & _col & ";background:" & SWITCH ( _col, "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#FBF1DC" ) & "'>" & _badge & "</span>" & [Periodic_text] & "</div>"
			        & "<div class='sp'>" & _spark & "</div><div class='hint'>HOVER FOR INSIGHT &#8635;</div></div>"
			        & "<div class='face back'><div class='bt'>WHAT IT MEANS</div>" & "<p>" & _txt & "</p>" & "</div></div></div>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure FX_flipcard =
			-- Flip card: exchange rate. Front = value, change and 6-month sparkline; back = what it means
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _v = [FX_rate_curr]
			VAR _chg = [FX_rate_PnP]
			VAR _col = [FX_rate_colour]
			VAR _mark = SWITCH ( TRUE (), ISBLANK ( _chg ), "", ROUND ( _chg, 4 ) = 0, UNICHAR ( 9632 ), _chg > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) )
			VAR _badge = IF ( ISBLANK ( _chg ), "No change data", _mark & " " & FORMAT ( ABS ( _chg ), "0.0%" ) )
			VAR _last = [Latest_month]
			VAR _pts =
			    ADDCOLUMNS (
			        FILTER (
			            ALL ( calendar_table[month_date] ),
			            calendar_table[month_date] > EOMONTH ( _last, -6 ) && calendar_table[month_date] <= EOMONTH ( _last, 0 )
			        ),
			        "@v", VAR _m = calendar_table[month_date] RETURN CALCULATE ( [FX_rate_avg], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m )
			    )
			VAR _pi = ADDCOLUMNS ( _pts, "@i", RANKX ( _pts, calendar_table[month_date], , ASC ) - 1 )
			VAR _n = COUNTROWS ( _pts )
			VAR _lo = MINX ( _pts, [@v] )
			VAR _hi = MAXX ( _pts, [@v] )
			VAR _xy = ADDCOLUMNS ( _pi, "@x", 3 + [@i] * 74 / MAX ( _n - 1, 1 ), "@y", 27 - DIVIDE ( [@v] - _lo, _hi - _lo, 0.5 ) * 22 )
			VAR _poly = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0" ) & "," & FORMAT ( [@y], "0.0" ), " ", [@i], ASC )
			VAR _end = TOPN ( 1, _xy, [@i], DESC )
			VAR _spark =
			    "<svg viewBox='0 0 80 30' style='width:80rem;height:30rem'><polyline points='" & _poly & "' fill='none' stroke='#0B3D2E' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>"
			        & "<circle cx='" & FORMAT ( MAXX ( _end, [@x] ), "0.0" ) & "' cy='" & FORMAT ( MAXX ( _end, [@y] ), "0.0" ) & "' r='3' fill='#0B3D2E'/></svg>"
			-- Back: what the rate change means, and net received in dollars
			VAR _netUsd = CALCULATE ( [Net_curr], Currency[Currency] = "$" )
			VAR _txt =
			    IF ( ISBLANK ( _chg ), "No earlier period to compare.",
			        "The naira " & IF ( _chg > 0, "weakened ", "strengthened " ) & FORMAT ( ABS ( _chg ), "0.0%" ) & " against the dollar " & [Periodic_text] & ". " )
			        & "In dollars, net received was " & SWITCH ( TRUE (), ABS ( _netUsd ) >= 1e12, "$" & FORMAT ( _netUsd / 1e12, "0.00" ) & "tn", ABS ( _netUsd ) >= 1e9, "$" & FORMAT ( _netUsd / 1e9, "0.0" ) & "bn", "$" & FORMAT ( _netUsd / 1e6, "0.0" ) & "m" ) & "."
			RETURN
			    [Flip_css]
			        & "<div class='fc'><div class='fi'><div class='face front'><div class='lbl'>EXCHANGE RATE</div>"
			        & "<div class='val'>" & "₦" & FORMAT ( _v, "#,0" ) & "<small>/ $</small>" & "</div>"
			        & "<div class='chg'><span class='bd' style='color:" & _col & ";background:" & SWITCH ( _col, "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#FBF1DC" ) & "'>" & _badge & "</span>" & IF ( ISBLANK ( _chg ) || ROUND ( _chg, 4 ) = 0, [Periodic_text], IF ( _chg > 0, "naira weaker ", "naira stronger " ) & [Periodic_text] ) & "</div>"
			        & "<div class='sp'>" & _spark & "</div><div class='hint'>HOVER FOR INSIGHT &#8635;</div></div>"
			        & "<div class='face back'><div class='bt'>WHAT IT MEANS</div>" & "<p>" & _txt & "</p>" & "</div></div></div>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure State_shelf_html =
			-- Rotating shelf: top 5 states by net received; the leader sits in the centre. CSS animation only.
			VAR _step = 3 -- seconds each state spends in the centre
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _t = TOPN ( 5, FILTER ( ADDCOLUMNS ( VALUES ( dim_state[state] ), "@v", [Net_curr], "@z", CALCULATE ( MAX ( dim_state[zone] ) ) ), NOT ISBLANK ( [@v] ) ), [@v], DESC )
			VAR _n = COUNTROWS ( _t )
			VAR _tot = CALCULATE ( [Net_curr], REMOVEFILTERS ( dim_state ) )
			VAR _r = ADDCOLUMNS ( _t, "@r", RANKX ( _t, [@v], , DESC, Dense ) )
			VAR _cyc = _step * 5
			-- Each rank starts at a different point of the same 5-position cycle
			VAR _delays = CONCATENATEX ( GENERATESERIES ( 2, 5 ), ".r" & [Value] & "{animation-delay:-" & ( _cyc - ( [Value] - 1 ) * _step ) & "s}", "" )
			VAR _items =
			    CONCATENATEX (
			        _r,
			        "<div class='it r" & [@r] & "' style='background:linear-gradient(150deg,"
			            -- Zone colours shared across the dashboard (dark shade, zone colour)
			            & SWITCH ( [@z], "North Central", "#1E6E50,#2E9B72", "North East", "#9C7210,#D9A21B", "North West", "#24507E,#3A6EA5",
			                "South East", "#63408A,#8E5BB5", "South South", "#8E4521,#C8693A", "South West", "#062A1F,#1B5A45", "#5E6E67,#93A59D" )
			            & ")'><span class='rk'>#" & [@r] & "</span><div class='cd'>" & UPPER ( LEFT ( dim_state[state], 2 ) ) & "</div>"
			            & "<div class='nm'>" & dim_state[state] & "</div><div class='zn'>" & [@z] & "</div><div class='am'>" & SWITCH ( TRUE (), ABS ( [@v] ) >= 1e12, _sym & FORMAT ( [@v] / 1e12, "0.00" ) & "tn", ABS ( [@v] ) >= 1e9, _sym & FORMAT ( [@v] / 1e9, "0.0" ) & "bn", _sym & FORMAT ( [@v] / 1e6, "0.0" ) & "m" ) & "</div>"
			            & "<div class='sh'>" & FORMAT ( DIVIDE ( [@v], _tot ), "0.0%" ) & " of national net</div></div>",
			        "", [@r], ASC
			    )
			VAR _css =
			    "<style>html{font-size:calc(100vh / 228)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;font-family:Segoe UI,sans-serif;padding:12rem 16rem;box-sizing:border-box}"
			        & ".tt{font-size:11.5rem;font-weight:600;color:#14231D}.st{font-size:12rem;font-weight:600;color:#0E8A5F;margin-top:3rem}"
			        & ".stage{position:relative;height:160rem;margin-top:6rem}"
			        & ".it{position:absolute;left:50%;top:4rem;width:156rem;margin-left:-78rem;height:148rem;border-radius:14rem;color:#fff;padding:10rem 12rem;box-sizing:border-box;box-shadow:0 6rem 16rem rgba(11,61,46,.25);animation:spin " & _cyc & "s linear infinite}"
			        & ".stage:hover .it{animation-play-state:paused}"
			        & ".rk{position:absolute;top:8rem;right:9rem;font-size:17rem;font-weight:800;background:rgba(255,255,255,.22);border-radius:8rem;padding:3rem 9rem;line-height:1.2}"
			        & ".cd{width:30rem;height:30rem;border-radius:9rem;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:11rem}"
			        & ".nm{font-size:13rem;font-weight:700;margin-top:9rem}.am{font-size:25rem;font-weight:700;line-height:1.05;margin-top:3rem;letter-spacing:-.3rem}.sh{font-size:11rem;font-weight:600;opacity:.92;margin-top:5rem}"
			        & ".zn{font-size:9.5rem;opacity:.85;margin-top:1rem}"
			        & _delays
			        & "@keyframes spin{0%,16%{transform:translateX(0) scale(1);opacity:1;z-index:5}20%,36%{transform:translateX(-120rem) scale(.7);opacity:.55;z-index:3}"
			        & "40%,56%{transform:translateX(-190rem) scale(.5);opacity:.3;z-index:1}58%{transform:translateX(-190rem) scale(.5);opacity:0;z-index:0}"
			        & "59%{transform:translateX(190rem) scale(.5);opacity:0;z-index:0}62%,76%{transform:translateX(190rem) scale(.5);opacity:.3;z-index:1}"
			        & "80%,96%{transform:translateX(120rem) scale(.7);opacity:.55;z-index:3}100%{transform:translateX(0) scale(1);opacity:1;z-index:5}}"
			        -- Fewer than 5 states (a zone or state filter): show them side by side, without rotating
			        & ".few .stage{display:flex;gap:10rem;justify-content:center}.few .it{position:static;margin:0;animation:none}"
			        & "</style>"
			RETURN
			    _css
			        & "<div class='w" & IF ( _n < 5, " few", "" ) & "'><div class='tt'>Top " & _n & " states by net received</div>"
			        & "<div class='st'>" & [Period_label] & " · net received and share of the national net</div>"
			        & "<div class='stage'>" & _items & "</div></div>"
		displayFolder: 05 Visual Helpers\HTML

	measure Overview_insight_html =
			-- Key takeaway banner for FAAC Overview: net and change, deductions share vs recent months, the top state
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _net = [Net_curr]
			VAR _chg = [Net_PnP]
			VAR _share = DIVIDE ( [Deductions_curr], [Gross_curr] )
			VAR _last = [Latest_month]
			-- Deductions share in each of the 5 months before the latest one
			VAR _prev5 =
			    ADDCOLUMNS (
			        FILTER ( ALL ( calendar_table[month_date] ), calendar_table[month_date] > EOMONTH ( _last, -6 ) && calendar_table[month_date] <= EOMONTH ( _last, -1 ) ),
			        "@s", VAR _m = calendar_table[month_date] RETURN DIVIDE ( CALCULATE ( [Deductions], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), CALCULATE ( [Gross], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ) )
			    )
			VAR _isMonthly = SELECTEDVALUE ( Period[Period Order], 0 ) = 0
			VAR _shareNote =
			    SWITCH ( TRUE (),
			        NOT _isMonthly || COUNTROWS ( _prev5 ) < 5, "",
			        _share <= MINX ( _prev5, [@s] ), ", the lowest in 6 months",
			        _share >= MAXX ( _prev5, [@s] ), ", the highest in 6 months",
			        "" )
			VAR _top = TOPN ( 1, FILTER ( ADDCOLUMNS ( VALUES ( dim_state[state] ), "@v", [Net_curr] ), NOT ISBLANK ( [@v] ) ), [@v], DESC )
			VAR _topName = MAXX ( _top, dim_state[state] )
			VAR _topShare = DIVIDE ( MAXX ( _top, [@v] ), CALCULATE ( [Net_curr], REMOVEFILTERS ( dim_state ) ) )
			VAR _who = IF ( [Area_label] = "All states", "States", [Area_label] )
			VAR _up = "<span class='up'>"
			VAR _dn = "<span class='dn'>"
			VAR _hl = "<span class='hl'>"
			VAR _e = "</span>"
			VAR _chgTxt =
			    IF ( ISBLANK ( _chg ), "",
			        ", " & IF ( _chg >= 0, _up & UNICHAR ( 9650 ), _dn & UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & _e & " " & [Periodic_text] )
			VAR _msg =
			    _who & " received " & _hl & SWITCH ( TRUE (), ABS ( _net ) >= 1e12, _sym & FORMAT ( _net / 1e12, "0.00" ) & "tn", ABS ( _net ) >= 1e9, _sym & FORMAT ( _net / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _net / 1e6, "0.0" ) & "m" ) & _e & " net in " & [Period_label] & _chgTxt & ". "
			        & "Deductions took " & IF ( _shareNote = ", the lowest in 6 months", _up, IF ( _shareNote = "", _hl, _dn ) ) & FORMAT ( _share, "0.0%" ) & _e & " of gross" & _shareNote & "."
			        & IF ( COUNTROWS ( VALUES ( dim_state[state] ) ) > 1, " " & _topName & " led with " & _hl & FORMAT ( _topShare, "0.0%" ) & _e & " of the national net.", "" )
			RETURN
			    "<style>html{font-size:calc(100vh / 50)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".b{position:fixed;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;gap:14rem;padding:0 18rem;border-radius:12rem;box-sizing:border-box;"
			        & "background:linear-gradient(90deg,#0B3D2E 0%,#145A43 70%,#1D6B51 100%);color:#fff;font-family:Segoe UI,sans-serif}"
			        & ".ic{width:28rem;height:28rem;border-radius:8rem;background:rgba(226,181,62,.18);display:flex;align-items:center;justify-content:center;flex:none}"
			        & ".k{font-size:8.5rem;letter-spacing:2rem;color:#E2B53E;font-weight:600;white-space:nowrap}"
			        & ".t{font-size:12rem;line-height:1.35}.up{color:#6EE0AE;font-weight:700}.dn{color:#FF9A9A;font-weight:700}.hl{color:#E2B53E;font-weight:700}</style>"
			        & "<div class='b'><div class='ic'><svg viewBox='0 0 16 16' style='width:16rem;height:16rem'><path d='M8 1.5a4.5 4.5 0 0 0-2.6 8.2V12h5.2V9.7A4.5 4.5 0 0 0 8 1.5zM6 13.2h4V14.5H6z' fill='#E2B53E'/></svg></div>"
			        & "<div class='k'>KEY TAKEAWAY<br>" & UPPER ( [Period_label] ) & "</div><div class='t'>" & _msg & "</div></div>"
		displayFolder: 06 Titles & Labels\Insights

	measure Overview_month_tt_html =
			-- Tooltip card for the gross vs net line chart: the hovered month and its change vs the month before.
			-- Month-aware on purpose: Period Calc's "Current" would always show the latest month.
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _m = MAX ( calendar_table[month_date] )
			VAR _pm = EOMONTH ( _m, -1 )
			VAR _g = CALCULATE ( [Gross], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m )
			VAR _n = CALCULATE ( [Net], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m )
			VAR _gp = CALCULATE ( [Gross], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm )
			VAR _np = CALCULATE ( [Net], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm )
			-- Chip for one line; income up = green
			VAR _gc = DIVIDE ( _g - _gp, _gp )
			VAR _nc = DIVIDE ( _n - _np, _np )
			VAR _chipG = IF ( ISBLANK ( _gp ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>n/a</span>",
			    "<span class='c' style='color:" & IF ( ROUND ( _gc, 4 ) = 0, "#C98A00", IF ( _gc > 0, "#0E8A5F", "#C93C3C" ) ) & ";background:" & IF ( ROUND ( _gc, 4 ) = 0, "#FBF1DC", IF ( _gc > 0, "#E3F4EC", "#FBE7E7" ) ) & "'>"
			        & IF ( ROUND ( _gc, 4 ) = 0, UNICHAR ( 9632 ), IF ( _gc > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) ) & " " & FORMAT ( ABS ( _gc ), "0.0%" ) & "</span>" )
			VAR _chipN = IF ( ISBLANK ( _np ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>n/a</span>",
			    "<span class='c' style='color:" & IF ( ROUND ( _nc, 4 ) = 0, "#C98A00", IF ( _nc > 0, "#0E8A5F", "#C93C3C" ) ) & ";background:" & IF ( ROUND ( _nc, 4 ) = 0, "#FBF1DC", IF ( _nc > 0, "#E3F4EC", "#FBE7E7" ) ) & "'>"
			        & IF ( ROUND ( _nc, 4 ) = 0, UNICHAR ( 9632 ), IF ( _nc > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) ) & " " & FORMAT ( ABS ( _nc ), "0.0%" ) & "</span>" )
			RETURN
			    "<style>html{font-size:calc(100vh / 104)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;margin-bottom:6rem}.r{display:flex;justify-content:space-between;align-items:center;gap:8rem;padding:4rem 0;border-top:1rem solid #E3E9E6}"
			        & ".r span:first-child{color:#5E6E67;flex:1}.r b{font-weight:700}.c{font-weight:700;font-size:10rem;padding:1rem 6rem;border-radius:4rem;min-width:52rem;text-align:center}"
			        & ".vs{color:#5E6E67;font-size:9rem;margin-top:5rem}</style>"
			        & "<div class='w'><div class='m'>" & UPPER ( FORMAT ( _m, "mmm yyyy" ) ) & " · " & UPPER ( [Area_label] ) & "</div>"
			        & "<div class='r'><span>Gross allocation</span><b>" & SWITCH ( TRUE (), ABS ( _g ) >= 1e12, _sym & FORMAT ( _g / 1e12, "0.00" ) & "tn", ABS ( _g ) >= 1e9, _sym & FORMAT ( _g / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _g / 1e6, "0.0" ) & "m" ) & "</b>" & _chipG & "</div>"
			        & "<div class='r'><span>Net received</span><b>" & SWITCH ( TRUE (), ABS ( _n ) >= 1e12, _sym & FORMAT ( _n / 1e12, "0.00" ) & "tn", ABS ( _n ) >= 1e9, _sym & FORMAT ( _n / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _n / 1e6, "0.0" ) & "m" ) & "</b>" & _chipN & "</div>"
			        & "<div class='vs'>Change vs " & FORMAT ( _pm, "mmm yyyy" ) & "</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure Range_from =
			-- First month of the date range (month end). No selection = the first FAAC month; From after To is swapped
			VAR _f = COALESCE ( SELECTEDVALUE ( Date_from[month] ), EOMONTH ( CALCULATE ( MIN ( faac[disbursement_date] ), REMOVEFILTERS () ), 0 ) )
			VAR _t = COALESCE ( SELECTEDVALUE ( Date_to[month] ), EOMONTH ( CALCULATE ( MAX ( faac[disbursement_date] ), REMOVEFILTERS () ), 0 ) )
			RETURN MIN ( _f, _t )
		formatString: mmm yyyy
		displayFolder: 01 Base\Context

	measure Range_to =
			-- Last month of the date range (month end). No selection = the latest FAAC month
			MAX ( COALESCE ( SELECTEDVALUE ( Date_from[month] ), EOMONTH ( CALCULATE ( MIN ( faac[disbursement_date] ), REMOVEFILTERS () ), 0 ) ), COALESCE ( SELECTEDVALUE ( Date_to[month] ), EOMONTH ( CALCULATE ( MAX ( faac[disbursement_date] ), REMOVEFILTERS () ), 0 ) ) )
		formatString: mmm yyyy
		displayFolder: 01 Base\Context

	measure Month_in_range =
			-- 1 for months inside the date range: a visual filter on charts over time
			VAR _m = MAX ( calendar_table[month_date] )
			RETURN IF ( _m >= [Range_from] && _m <= [Range_to], 1, 0 )
		formatString: 0
		displayFolder: 01 Base\Context

	measure Zone_colour =
			-- One colour per geopolitical zone, used everywhere states are coloured by zone
			SWITCH (
			    SELECTEDVALUE ( dim_state[zone] ),
			    "North Central", "#2E9B72",
			    "North East", "#D9A21B",
			    "North West", "#3A6EA5",
			    "South East", "#8E5BB5",
			    "South South", "#C8693A",
			    "South West", "#0B3D2E",
			    "#93A59D"
			)
		displayFolder: 05 Visual Helpers\Colours

	measure Zone_name =
			-- The hovered state's zone, for default tooltips
			SELECTEDVALUE ( dim_state[zone] )
		displayFolder: 06 Titles & Labels\Text

	measure Zone_legend_html =
			-- Legend for charts coloured by zone (rule-based colours have no native legend)
			VAR _z = { ( "North Central", "#2E9B72", 1 ), ( "North East", "#D9A21B", 2 ), ( "North West", "#3A6EA5", 3 ),
			    ( "South East", "#8E5BB5", 4 ), ( "South South", "#C8693A", 5 ), ( "South West", "#0B3D2E", 6 ) }
			RETURN
			    "<style>html{font-size:calc(100vh / 20)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".l{position:fixed;top:0;left:0;right:0;bottom:0;display:flex;flex-wrap:wrap;align-items:center;gap:2rem 9rem;white-space:nowrap;"
			        & "font-family:Segoe UI,sans-serif;font-size:8.5rem;color:#5E6E67}.l i{display:inline-block;width:7rem;height:7rem;border-radius:2rem;margin-right:3rem}</style>"
			        & "<div class='l'>" & CONCATENATEX ( _z, "<span><i style='background:" & [Value2] & "'></i>" & [Value1] & "</span>", "", [Value3], ASC ) & "</div>"
		displayFolder: 05 Visual Helpers\HTML

	measure State_tt_html =
			-- State Detail tooltip (map): rank, share, and gross / deductions / net with change on the previous period
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _st = SELECTEDVALUE ( dim_state[state] )
			VAR _net = [Net_curr]
			VAR _rank = CALCULATE ( RANKX ( VALUES ( dim_state[state] ), [Net_curr], _net, DESC ), REMOVEFILTERS ( dim_state ) )
			VAR _n = CALCULATE ( COUNTROWS ( FILTER ( VALUES ( dim_state[state] ), NOT ISBLANK ( [Net_curr] ) ) ), REMOVEFILTERS ( dim_state ) )
			VAR _g = [Gross_curr]
			VAR _d = [Deductions_curr]
			VAR _gc = [Gross_PnP]
			VAR _dc = [Deductions_PnP]
			VAR _nc = [Net_PnP]
			RETURN
			    IF ( ISBLANK ( _net ),
			        "<div style='font-family:Segoe UI;padding:12px;font-size:12px'>" & COALESCE ( _st, "FCT" ) & ": not in the FAAC reports</div>",
			        "<style>html{font-size:calc(100vh / 150)}html,body{margin:0;padding:0;overflow:hidden}"
			            & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:11rem 13rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			            & ".m{font-weight:700;font-size:12.5rem;letter-spacing:.6rem}.rk{display:inline-block;font-weight:700;color:#0B3D2E;background:#EDF2EF;border-radius:5rem;padding:1rem 6rem;margin-left:6rem;letter-spacing:0;font-size:10.5rem}"
			            & ".sub{color:#5E6E67;font-size:9.5rem;margin:3rem 0 7rem}"
			            & ".r{display:flex;align-items:center;gap:8rem;padding:4rem 0;border-top:1px solid #E3E9E6}.r span:first-child{color:#5E6E67;flex:1}.r b{font-weight:700;min-width:62rem;text-align:right}"
			            & ".c{font-weight:700;font-size:10rem;padding:1rem 6rem;border-radius:4rem;min-width:52rem;text-align:center}.vs{color:#5E6E67;font-size:9rem;margin-top:5rem}</style>"
			            & "<div class='w'><div class='m'>" & UPPER ( _st ) & "<span class='rk'>Rank " & _rank & " of " & _n & "</span></div>"
			            & "<div class='sub'>" & [Period_label] & " · " & FORMAT ( [Net_share_national], "0.0%" ) & " of the national net</div>"
			            & "<div class='r'><span>Income (gross)</span><b>" & SWITCH ( TRUE (), ABS ( _g ) >= 1e12, _sym & FORMAT ( _g / 1e12, "0.00" ) & "tn", ABS ( _g ) >= 1e9, _sym & FORMAT ( _g / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _g / 1e6, "0.0" ) & "m" ) & "</b>" & IF ( ISBLANK ( _gc ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>n/a</span>", "<span class='c' style='color:" & IF ( ROUND ( _gc, 4 ) = 0, "#C98A00", IF ( _gc > 0, "#0E8A5F", "#C93C3C" ) ) & ";background:" & IF ( ROUND ( _gc, 4 ) = 0, "#FBF1DC", IF ( _gc > 0, "#E3F4EC", "#FBE7E7" ) ) & "'>" & IF ( ROUND ( _gc, 4 ) = 0, UNICHAR ( 9632 ), IF ( _gc > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) ) & " " & FORMAT ( ABS ( _gc ), "0.0%" ) & "</span>" ) & "</div>"
			            & "<div class='r'><span>Deductions</span><b>" & SWITCH ( TRUE (), ABS ( _d ) >= 1e12, _sym & FORMAT ( _d / 1e12, "0.00" ) & "tn", ABS ( _d ) >= 1e9, _sym & FORMAT ( _d / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _d / 1e6, "0.0" ) & "m" ) & "</b>" & IF ( ISBLANK ( _dc ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>n/a</span>", "<span class='c' style='color:" & IF ( ROUND ( _dc, 4 ) = 0, "#C98A00", IF ( _dc < 0, "#0E8A5F", "#C93C3C" ) ) & ";background:" & IF ( ROUND ( _dc, 4 ) = 0, "#FBF1DC", IF ( _dc < 0, "#E3F4EC", "#FBE7E7" ) ) & "'>" & IF ( ROUND ( _dc, 4 ) = 0, UNICHAR ( 9632 ), IF ( _dc > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) ) & " " & FORMAT ( ABS ( _dc ), "0.0%" ) & "</span>" ) & "</div>"
			            & "<div class='r'><span>Net received</span><b>" & SWITCH ( TRUE (), ABS ( _net ) >= 1e12, _sym & FORMAT ( _net / 1e12, "0.00" ) & "tn", ABS ( _net ) >= 1e9, _sym & FORMAT ( _net / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _net / 1e6, "0.0" ) & "m" ) & "</b>" & IF ( ISBLANK ( _nc ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>n/a</span>", "<span class='c' style='color:" & IF ( ROUND ( _nc, 4 ) = 0, "#C98A00", IF ( _nc > 0, "#0E8A5F", "#C93C3C" ) ) & ";background:" & IF ( ROUND ( _nc, 4 ) = 0, "#FBF1DC", IF ( _nc > 0, "#E3F4EC", "#FBE7E7" ) ) & "'>" & IF ( ROUND ( _nc, 4 ) = 0, UNICHAR ( 9632 ), IF ( _nc > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) ) & " " & FORMAT ( ABS ( _nc ), "0.0%" ) & "</span>" ) & "</div>"
			            & "<div class='vs'>Change " & [Periodic_text] & " · deductions up = red</div></div>"
			    )
		displayFolder: 06 Titles & Labels\Tooltips

	measure Banner_css =
			-- Shared styles for the insight banners (design height 50)
			"<style>html{font-size:calc(100vh / 50)}html,body{margin:0;padding:0;overflow:hidden}"
			    & ".b{position:fixed;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;gap:14rem;padding:0 18rem;border-radius:12rem;box-sizing:border-box;"
			    & "background:linear-gradient(90deg,#0B3D2E 0%,#145A43 70%,#1D6B51 100%);color:#fff;font-family:Segoe UI,sans-serif}"
			    & ".ic{width:28rem;height:28rem;border-radius:8rem;background:rgba(226,181,62,.18);display:flex;align-items:center;justify-content:center;flex:none}"
			    & ".k{font-size:8.5rem;letter-spacing:2rem;color:#E2B53E;font-weight:600;white-space:nowrap}"
			    & ".t{font-size:12rem;line-height:1.35}.up{color:#6EE0AE;font-weight:700}.dn{color:#FF9A9A;font-weight:700}.hl{color:#E2B53E;font-weight:700}</style>"
		displayFolder: 06 Titles & Labels\Insights

	measure State_insight_html =
			-- Key takeaway banner for FAAC States: one state (map click or State slicer) or the states in view
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _up = "<span class='up'>"
			VAR _dn = "<span class='dn'>"
			VAR _hl = "<span class='hl'>"
			VAR _e = "</span>"
			VAR _one = HASONEVALUE ( dim_state[state] )
			VAR _net = [Net_curr]
			VAR _chg = [Net_PnP]
			VAR _chgTxt =
			    IF ( ISBLANK ( _chg ), "",
			        ", " & IF ( _chg >= 0, _up & UNICHAR ( 9650 ), _dn & UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & _e & " " & [Periodic_text] )
			-- One state: rank, and its deductions share against all states
			VAR _rank = CALCULATE ( RANKX ( VALUES ( dim_state[state] ), [Net_curr], _net, DESC ), REMOVEFILTERS ( dim_state ) )
			VAR _share = DIVIDE ( [Deductions_curr], [Gross_curr] )
			VAR _natShare = CALCULATE ( DIVIDE ( [Deductions_curr], [Gross_curr] ), REMOVEFILTERS ( dim_state ) )
			VAR _oneMsg =
			    SELECTEDVALUE ( dim_state[state] ) & " received " & _hl & SWITCH ( TRUE (), ABS ( _net ) >= 1e12, _sym & FORMAT ( _net / 1e12, "0.00" ) & "tn", ABS ( _net ) >= 1e9, _sym & FORMAT ( _net / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _net / 1e6, "0.0" ) & "m" ) & _e & " net in " & [Period_label] & _chgTxt
			        & ", ranking " & _hl & _rank & " of 36" & _e & ". Deductions took " & IF ( _share <= _natShare, _up, _dn ) & FORMAT ( _share, "0.0%" ) & _e
			        & " of its gross, " & IF ( _share <= _natShare, "below", "above" ) & " the " & FORMAT ( _natShare, "0.0%" ) & " for all states."
			-- Several states: the total, the leader and the smallest share
			VAR _st = FILTER ( ADDCOLUMNS ( VALUES ( dim_state[state] ), "@v", [Net_curr] ), NOT ISBLANK ( [@v] ) )
			VAR _cnt = COUNTROWS ( _st )
			VAR _top = TOPN ( 1, _st, [@v], DESC )
			VAR _bot = TOPN ( 1, _st, [@v], ASC )
			VAR _nat = CALCULATE ( [Net_curr], REMOVEFILTERS ( dim_state ) )
			VAR _who = IF ( [Area_label] = "All states", "The " & _cnt & " states", "The " & _cnt & " " & [Area_label] & " states" )
			VAR _manyMsg =
			    _who & " received " & _hl & SWITCH ( TRUE (), ABS ( _net ) >= 1e12, _sym & FORMAT ( _net / 1e12, "0.00" ) & "tn", ABS ( _net ) >= 1e9, _sym & FORMAT ( _net / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _net / 1e6, "0.0" ) & "m" ) & _e & " net in " & [Period_label] & _chgTxt & ". "
			        & MAXX ( _top, dim_state[state] ) & " led with " & _hl & FORMAT ( DIVIDE ( MAXX ( _top, [@v] ), _nat ), "0.0%" ) & _e & " of the national net; "
			        & MAXX ( _bot, dim_state[state] ) & " had the smallest share at " & _hl & FORMAT ( DIVIDE ( MAXX ( _bot, [@v] ), _nat ), "0.0%" ) & _e & "."
			RETURN
			    [Banner_css]
			        & "<div class='b'><div class='ic'><svg viewBox='0 0 16 16' style='width:16rem;height:16rem'><path d='M8 1.5a4.5 4.5 0 0 0-2.6 8.2V12h5.2V9.7A4.5 4.5 0 0 0 8 1.5zM6 13.2h4V14.5H6z' fill='#E2B53E'/></svg></div>"
			        & "<div class='k'>KEY TAKEAWAY<br>" & UPPER ( [Period_label] ) & "</div><div class='t'>" & IF ( _one, _oneMsg, _manyMsg ) & "</div></div>"
		displayFolder: 06 Titles & Labels\Insights

	measure Revenue_month_tt_html =
			-- Tooltip card for the revenue area chart: each revenue line in the hovered month,
			-- its share of gross and its change on the month before. Month-aware on purpose (not Period Calc)
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _m = MAX ( calendar_table[month_date] )
			VAR _pm = EOMONTH ( _m, -1 )
			VAR _t = UNION (
			        ROW ( "n", "Statutory allocation", "k", "#0E6B45", "o", 0, "v", CALCULATE ( [Statutory], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), "p", CALCULATE ( [Statutory], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm ) ),
			        ROW ( "n", "VAT", "k", "#8FC9AE", "o", 1, "v", CALCULATE ( [VAT], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), "p", CALCULATE ( [VAT], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm ) ),
			        ROW ( "n", "Oil derivation", "k", "#E2B53E", "o", 2, "v", CALCULATE ( [Oil_Derivation], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), "p", CALCULATE ( [Oil_Derivation], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm ) ),
			        ROW ( "n", "Exchange gain", "k", "#4E9C78", "o", 3, "v", CALCULATE ( [Exchange_Gain], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), "p", CALCULATE ( [Exchange_Gain], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm ) ),
			        ROW ( "n", "Ecology fund", "k", "#B9D9C9", "o", 4, "v", CALCULATE ( [Ecology], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), "p", CALCULATE ( [Ecology], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm ) ),
			        ROW ( "n", "Other income", "k", "#7F8C86", "o", 5, "v", CALCULATE ( [Others_Income], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), "p", CALCULATE ( [Others_Income], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm ) )
			    )
			VAR _g = SUMX ( _t, [v] )
			VAR _gp = SUMX ( _t, [p] )
			VAR _rows =
			    CONCATENATEX (
			        _t,
			        "<div class='r'><span><i style='background:" & [k] & "'></i>" & [n] & "</span><b>" & SWITCH ( TRUE (), ABS ( [v] ) >= 1e12, _sym & FORMAT ( [v] / 1e12, "0.00" ) & "tn", ABS ( [v] ) >= 1e9, _sym & FORMAT ( [v] / 1e9, "0.0" ) & "bn", _sym & FORMAT ( [v] / 1e6, "0.0" ) & "m" ) & "</b><em>"
			            & FORMAT ( DIVIDE ( [v], _g ), "0%" ) & "</em>" & SWITCH ( TRUE (), [p] = 0 && [v] = 0, "<span class='c' style='color:#5E6E67;background:#EDF2EF'>" & "–" & "</span>", [p] = 0, "<span class='c' style='color:#5E6E67;background:#EDF2EF'>" & "Resumed" & "</span>", [v] = 0, "<span class='c' style='color:#5E6E67;background:#EDF2EF'>" & "Not paid" & "</span>", "<span class='c' style='color:" & IF ( ROUND ( DIVIDE ( [v] - [p], [p] ), 4 ) = 0, "#C98A00", IF ( DIVIDE ( [v] - [p], [p] ) > 0, "#0E8A5F", "#C93C3C" ) ) & ";background:" & IF ( ROUND ( DIVIDE ( [v] - [p], [p] ), 4 ) = 0, "#FBF1DC", IF ( DIVIDE ( [v] - [p], [p] ) > 0, "#E3F4EC", "#FBE7E7" ) ) & "'>" & IF ( ROUND ( DIVIDE ( [v] - [p], [p] ), 4 ) = 0, UNICHAR ( 9632 ), IF ( DIVIDE ( [v] - [p], [p] ) > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) ) & " " & FORMAT ( ABS ( DIVIDE ( [v] - [p], [p] ) ), "0.0%" ) & "</span>" ) & "</div>",
			        "", [o], ASC
			    )
			RETURN
			    "<style>html{font-size:calc(100vh / 230)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;margin-bottom:5rem;letter-spacing:.5rem}"
			        & ".r{display:grid;grid-template-columns:1fr 64rem 32rem 62rem;gap:6rem;align-items:center;padding:3.5rem 0;border-top:1px solid #E3E9E6}"
			        & ".r span{color:#5E6E67;white-space:nowrap}.r i{display:inline-block;width:7rem;height:7rem;border-radius:2rem;margin-right:5rem}"
			        & ".r b{text-align:right;font-weight:700}.r em{font-style:normal;color:#5E6E67;text-align:right}.r.t span{color:#14231D;font-weight:700}"
			        & ".c{font-weight:700;font-size:9.5rem;padding:1rem 5rem;border-radius:4rem;text-align:center;white-space:nowrap}.vs{color:#5E6E67;font-size:9rem;margin-top:5rem}</style>"
			        & "<div class='w'><div class='m'>" & UPPER ( FORMAT ( _m, "mmmm yyyy" ) ) & " · " & UPPER ( [Area_label] ) & "</div>" & _rows
			        & "<div class='r t'><span>Gross allocation</span><b>" & SWITCH ( TRUE (), ABS ( _g ) >= 1e12, _sym & FORMAT ( _g / 1e12, "0.00" ) & "tn", ABS ( _g ) >= 1e9, _sym & FORMAT ( _g / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _g / 1e6, "0.0" ) & "m" ) & "</b><em>100%</em>" & SWITCH ( TRUE (), _gp = 0 && _g = 0, "<span class='c' style='color:#5E6E67;background:#EDF2EF'>" & "–" & "</span>", _gp = 0, "<span class='c' style='color:#5E6E67;background:#EDF2EF'>" & "Resumed" & "</span>", _g = 0, "<span class='c' style='color:#5E6E67;background:#EDF2EF'>" & "Not paid" & "</span>", "<span class='c' style='color:" & IF ( ROUND ( DIVIDE ( _g - _gp, _gp ), 4 ) = 0, "#C98A00", IF ( DIVIDE ( _g - _gp, _gp ) > 0, "#0E8A5F", "#C93C3C" ) ) & ";background:" & IF ( ROUND ( DIVIDE ( _g - _gp, _gp ), 4 ) = 0, "#FBF1DC", IF ( DIVIDE ( _g - _gp, _gp ) > 0, "#E3F4EC", "#FBE7E7" ) ) & "'>" & IF ( ROUND ( DIVIDE ( _g - _gp, _gp ), 4 ) = 0, UNICHAR ( 9632 ), IF ( DIVIDE ( _g - _gp, _gp ) > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) ) & " " & FORMAT ( ABS ( DIVIDE ( _g - _gp, _gp ) ), "0.0%" ) & "</span>" ) & "</div>"
			        & "<div class='vs'>Change vs " & FORMAT ( _pm, "mmm yyyy" ) & "</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure Oil_share_of_total =
			-- A state's share of all oil derivation paid this period
			DIVIDE ( [Oil_Derivation], CALCULATE ( [Oil_Derivation], REMOVEFILTERS ( dim_state ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Shares

	measure Metric_share_svg =
			-- Share-of-gross bar for the revenue lines table (an image in a native table keeps its tooltip).
			-- Colours as rgb(): Power BI drew %23-encoded hex colours as black
			VAR _sh = DIVIDE ( [Metric_value_curr], [Gross_curr] )
			VAR _w = FORMAT ( MIN ( MAX ( _sh, 0 ), 1 ) * 60, "0.0" )
			RETURN
			    IF ( ISBLANK ( [Metric_value_curr] ), BLANK (),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='14'>"
			            & "<rect x='0' y='4' width='60' height='7' rx='2' fill='rgb(237,242,239)'/><rect x='0' y='4' width='" & _w & "' height='7' rx='2' fill='rgb(14,107,69)'/>"
			            & "<text x='66' y='11' font-family='Segoe UI' font-size='10' fill='rgb(20,35,29)'>" & FORMAT ( _sh, "0%" ) & "</text></svg>" )
		displayFolder: 05 Visual Helpers\SVG
		dataCategory: ImageUrl

	measure Revenue_insight_html =
			-- Key takeaway banner for Revenue mix: the biggest line, the line that moved most, the leading oil state
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _up = "<span class='up'>"
			VAR _dn = "<span class='dn'>"
			VAR _hl = "<span class='hl'>"
			VAR _e = "</span>"
			VAR _g = [Gross_curr]
			VAR _t = UNION (
			        ROW ( "n", "Statutory allocation", "c", CALCULATE ( [Statutory], 'Period Calc'[Name] = "Current" ), "p", CALCULATE ( [Statutory], 'Period Calc'[Name] = "Previous" ) ),
			        ROW ( "n", "VAT", "c", CALCULATE ( [VAT], 'Period Calc'[Name] = "Current" ), "p", CALCULATE ( [VAT], 'Period Calc'[Name] = "Previous" ) ),
			        ROW ( "n", "Oil derivation", "c", CALCULATE ( [Oil_Derivation], 'Period Calc'[Name] = "Current" ), "p", CALCULATE ( [Oil_Derivation], 'Period Calc'[Name] = "Previous" ) ),
			        ROW ( "n", "Exchange gain", "c", CALCULATE ( [Exchange_Gain], 'Period Calc'[Name] = "Current" ), "p", CALCULATE ( [Exchange_Gain], 'Period Calc'[Name] = "Previous" ) ),
			        ROW ( "n", "Ecology fund", "c", CALCULATE ( [Ecology], 'Period Calc'[Name] = "Current" ), "p", CALCULATE ( [Ecology], 'Period Calc'[Name] = "Previous" ) ),
			        ROW ( "n", "Other income", "c", CALCULATE ( [Others_Income], 'Period Calc'[Name] = "Current" ), "p", CALCULATE ( [Others_Income], 'Period Calc'[Name] = "Previous" ) )
			    )
			VAR _big = TOPN ( 1, _t, [c], DESC )
			-- Fastest mover: biggest change among lines paid in both periods
			VAR _mv = TOPN ( 1, FILTER ( ADDCOLUMNS ( _t, "@ch", DIVIDE ( [c] - [p], [p] ) ), [p] > 0 && [c] > 0 ), ABS ( [@ch] ), DESC )
			VAR _mvCh = MAXX ( _mv, [@ch] )
			VAR _oilTot = CALCULATE ( [Oil_Derivation], 'Period Calc'[Name] = "Current" )
			VAR _oilTop = TOPN ( 1, FILTER ( ADDCOLUMNS ( VALUES ( dim_state[state] ), "@o", CALCULATE ( [Oil_Derivation], 'Period Calc'[Name] = "Current" ) ), [@o] > 0 ), [@o], DESC )
			VAR _msg =
			    MAXX ( _big, [n] ) & " made up " & _hl & FORMAT ( DIVIDE ( MAXX ( _big, [c] ), _g ), "0%" ) & _e & " of the " & SWITCH ( TRUE (), ABS ( _g ) >= 1e12, _sym & FORMAT ( _g / 1e12, "0.00" ) & "tn", ABS ( _g ) >= 1e9, _sym & FORMAT ( _g / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _g / 1e6, "0.0" ) & "m" ) & " gross in " & [Period_label] & ". "
			        & IF ( COUNTROWS ( _mv ) = 1,
			            MAXX ( _mv, [n] ) & " moved most, " & IF ( _mvCh >= 0, _up & UNICHAR ( 9650 ), _dn & UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _mvCh ), "0.0%" ) & _e & " " & [Periodic_text]
			                & IF ( COUNTROWS ( _oilTop ) = 1, ", and ", "." ),
			            "" )
			        & IF ( COUNTROWS ( _oilTop ) = 1,
			            MAXX ( _oilTop, dim_state[state] ) & " took " & _hl & FORMAT ( DIVIDE ( MAXX ( _oilTop, [@o] ), _oilTot ), "0%" ) & _e & " of oil derivation.",
			            "" )
			RETURN
			    [Banner_css]
			        & "<div class='b'><div class='ic'><svg viewBox='0 0 16 16' style='width:16rem;height:16rem'><path d='M8 1.5a4.5 4.5 0 0 0-2.6 8.2V12h5.2V9.7A4.5 4.5 0 0 0 8 1.5zM6 13.2h4V14.5H6z' fill='#E2B53E'/></svg></div>"
			        & "<div class='k'>KEY TAKEAWAY<br>" & UPPER ( [Period_label] ) & "</div><div class='t'>" & _msg & "</div></div>"
		displayFolder: 06 Titles & Labels\Insights

	measure Metric_value_curr_text =
			-- Short money text for tables, this period: ₦794.0bn rather than ₦793,977,220,247
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _v = [Metric_value_curr]
			RETURN SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), ABS ( _v ) >= 1e12, _sym & FORMAT ( _v / 1e12, "0.00" ) & "tn", ABS ( _v ) >= 1e9, _sym & FORMAT ( _v / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _v / 1e6, "0.0" ) & "m" )
		displayFolder: 06 Titles & Labels\Text

	measure Metric_value_prev_text =
			-- Short money text for tables, previous period: ₦794.0bn rather than ₦793,977,220,247
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _v = [Metric_value_prev]
			RETURN SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), ABS ( _v ) >= 1e12, _sym & FORMAT ( _v / 1e12, "0.00" ) & "tn", ABS ( _v ) >= 1e9, _sym & FORMAT ( _v / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _v / 1e6, "0.0" ) & "m" )
		displayFolder: 06 Titles & Labels\Text

	measure Metric_change_short =
			-- e.g. "▲ 5.4%"; the colour comes from Metric_value_colour
			VAR _c = [Metric_value_PnP]
			RETURN IF ( ISBLANK ( _c ), BLANK (), SWITCH ( TRUE (), ROUND ( _c, 4 ) = 0, UNICHAR ( 9632 ), _c > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _c ), "0.0%" ) )
		displayFolder: 06 Titles & Labels\Text

	measure Oil_state_tt_html =
			-- Tooltip card for the oil derivation bars: state, zone, amount and share of all oil derivation
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _v = [Oil_Derivation]
			VAR _z = SELECTEDVALUE ( dim_state[zone] )
			RETURN
			    "<style>html{font-size:calc(100vh / 112)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;letter-spacing:.5rem}.sub{display:flex;align-items:center;gap:5rem;color:#5E6E67;font-size:9.5rem;margin:3rem 0 6rem}"
			        & ".sub i{display:inline-block;width:8rem;height:8rem;border-radius:2rem}.def{color:#5E6E67;font-size:9.5rem;line-height:1.4;margin:4rem 0 7rem}"
			        & ".r{display:flex;justify-content:space-between;align-items:center;gap:12rem;padding:4rem 0;border-top:1px solid #E3E9E6}.r span{color:#5E6E67}.r b{font-weight:700}"
			        & ".c{font-weight:700;font-size:10rem;padding:1rem 6rem;border-radius:4rem}</style>"
			        & "<div class='w'><div class='m'>" & UPPER ( SELECTEDVALUE ( dim_state[state] ) ) & "</div>"
			        & "<div class='sub'><i style='background:" & [Zone_colour] & "'></i>" & _z & "</div>"
			        & "<div class='r'><span>Oil derivation</span><b>" & SWITCH ( TRUE (), ISBLANK ( _v ), "₦0", ABS ( _v ) >= 1e12, _sym & FORMAT ( _v / 1e12, "0.00" ) & "tn", ABS ( _v ) >= 1e9, _sym & FORMAT ( _v / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _v / 1e6, "0.0" ) & "m" ) & "</b></div>"
			        & "<div class='r'><span>Share of all oil derivation</span><b>" & FORMAT ( [Oil_share_of_total], "0.0%" ) & "</b></div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure Metric_tt_html =
			-- Metric Detail tooltip card (revenue and deduction tables): name, definition, this period vs the previous one.
			-- Zero periods get a word instead of a %: some lines are only paid in some months
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _cur = [Metric_value_curr]
			VAR _prev = [Metric_value_prev]
			VAR _col = [Metric_value_colour]
			VAR _c = [Metric_value_PnP]
			VAR _word = "<span class='c' style='color:#5E6E67;background:#EDF2EF'>"
			VAR _chip =
			    SWITCH ( TRUE (),
			        ( ISBLANK ( _prev ) || _prev = 0 ) && ( ISBLANK ( _cur ) || _cur = 0 ), _word & "–</span>",
			        ISBLANK ( _prev ) || _prev = 0, _word & "Resumed</span>",
			        ISBLANK ( _cur ) || _cur = 0, _word & "Not paid</span>",
			        "<span class='c' style='color:" & _col & ";background:" & SWITCH ( _col, "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#FBF1DC" ) & "'>"
			            & SWITCH ( TRUE (), ROUND ( _c, 4 ) = 0, UNICHAR ( 9632 ), _c > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _c ), "0.0%" ) & "</span>" )
			VAR _prevLabel = SUBSTITUTE ( [Periodic_text], "vs ", "" )
			RETURN
			    "<style>html{font-size:calc(100vh / 176)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;letter-spacing:.5rem}.sub{display:flex;align-items:center;gap:5rem;color:#5E6E67;font-size:9.5rem;margin:3rem 0 6rem}"
			        & ".sub i{display:inline-block;width:8rem;height:8rem;border-radius:2rem}.def{color:#5E6E67;font-size:9.5rem;line-height:1.4;margin:4rem 0 7rem}"
			        & ".r{display:flex;justify-content:space-between;align-items:center;gap:12rem;padding:4rem 0;border-top:1px solid #E3E9E6}.r span{color:#5E6E67}.r b{font-weight:700}"
			        & ".c{font-weight:700;font-size:10rem;padding:1rem 6rem;border-radius:4rem}</style>"
			        & "<div class='w'><div class='m'>" & UPPER ( SELECTEDVALUE ( Metric_param[Metric_label] ) ) & IF ( [Area_label] <> "All states", " · " & UPPER ( [Area_label] ), "" ) & "</div>"
			        & "<div class='def'>" & [Metric_definition] & "</div>"
			        & "<div class='r'><span>" & [Period_label] & "</span><b>" & SWITCH ( TRUE (), ISBLANK ( _cur ), "₦0", ABS ( _cur ) >= 1e12, _sym & FORMAT ( _cur / 1e12, "0.00" ) & "tn", ABS ( _cur ) >= 1e9, _sym & FORMAT ( _cur / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _cur / 1e6, "0.0" ) & "m" ) & "</b></div>"
			        & "<div class='r'><span>" & _prevLabel & "</span><b>" & SWITCH ( TRUE (), ISBLANK ( _prev ), "₦0", ABS ( _prev ) >= 1e12, _sym & FORMAT ( _prev / 1e12, "0.00" ) & "tn", ABS ( _prev ) >= 1e9, _sym & FORMAT ( _prev / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _prev / 1e6, "0.0" ) & "m" ) & "</b></div>"
			        & "<div class='r'><span>Change</span>" & _chip & "</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure Deductions_month_tt_html =
			-- Tooltip card for the deduction lines chart: each line in the hovered month, its share of all
			-- deductions and its change on the month before (a rise is red). Month-aware on purpose (not Period Calc)
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _m = MAX ( calendar_table[month_date] )
			VAR _pm = EOMONTH ( _m, -1 )
			VAR _t = UNION (
			        ROW ( "n", "External debt", "k", "#0B3D2E", "o", 0, "v", CALCULATE ( [External_Debt], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), "p", CALCULATE ( [External_Debt], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm ) ),
			        ROW ( "n", "Contractual (ISPO)", "k", "#0E8A5F", "o", 1, "v", CALCULATE ( [Contractual_Obligation], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), "p", CALCULATE ( [Contractual_Obligation], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm ) ),
			        ROW ( "n", "NDDC / HYPPADEC", "k", "#6CC49A", "o", 2, "v", CALCULATE ( [NDDC_Transfer], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), "p", CALCULATE ( [NDDC_Transfer], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm ) ),
			        ROW ( "n", "Other (see note)", "k", "#E2B53E", "o", 3, "v", CALCULATE ( [Other_Deductions_Note], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), "p", CALCULATE ( [Other_Deductions_Note], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm ) ),
			        ROW ( "n", "Unlabelled", "k", "#93A59D", "o", 4, "v", CALCULATE ( [Deduction_Misc], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), "p", CALCULATE ( [Deduction_Misc], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm ) ),
			        ROW ( "n", "Other deductions", "k", "#3F7D68", "o", 5, "v", CALCULATE ( [Other_Deduction], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _m ), "p", CALCULATE ( [Other_Deduction], REMOVEFILTERS ( calendar_table ), calendar_table[month_date] = _pm ) )
			    )
			VAR _d = SUMX ( _t, [v] )
			VAR _dp = SUMX ( _t, [p] )
			VAR _rows =
			    CONCATENATEX (
			        _t,
			        "<div class='r'><span><i style='background:" & [k] & "'></i>" & [n] & "</span><b>" & SWITCH ( TRUE (), ISBLANK ( [v] ), _sym & "0", ABS ( [v] ) >= 1e12, _sym & FORMAT ( [v] / 1e12, "0.00" ) & "tn", ABS ( [v] ) >= 1e9, _sym & FORMAT ( [v] / 1e9, "0.0" ) & "bn", _sym & FORMAT ( [v] / 1e6, "0.0" ) & "m" ) & "</b><em>"
			            & FORMAT ( DIVIDE ( [v], _d ), "0%" ) & "</em>" & SWITCH ( TRUE (), ( ISBLANK ( [p] ) || [p] = 0 ) && ( ISBLANK ( [v] ) || [v] = 0 ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>–</span>", ISBLANK ( [p] ) || [p] = 0, "<span class='c' style='color:#5E6E67;background:#EDF2EF'>Resumed</span>", ISBLANK ( [v] ) || [v] = 0, "<span class='c' style='color:#5E6E67;background:#EDF2EF'>Not paid</span>", "<span class='c' style='color:" & IF ( ROUND ( DIVIDE ( [v] - [p], [p] ), 4 ) = 0, "#C98A00", IF ( DIVIDE ( [v] - [p], [p] ) > 0, "#C93C3C", "#0E8A5F" ) ) & ";background:" & IF ( ROUND ( DIVIDE ( [v] - [p], [p] ), 4 ) = 0, "#FBF1DC", IF ( DIVIDE ( [v] - [p], [p] ) > 0, "#FBE7E7", "#E3F4EC" ) ) & "'>" & IF ( ROUND ( DIVIDE ( [v] - [p], [p] ), 4 ) = 0, UNICHAR ( 9632 ), IF ( DIVIDE ( [v] - [p], [p] ) > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) ) & " " & FORMAT ( ABS ( DIVIDE ( [v] - [p], [p] ) ), "0.0%" ) & "</span>" ) & "</div>",
			        "", [o], ASC
			    )
			RETURN
			    "<style>html{font-size:calc(100vh / 230)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;letter-spacing:.5rem;margin-bottom:5rem}.sub{display:flex;align-items:center;gap:5rem;color:#5E6E67;font-size:9.5rem;margin:-2rem 0 6rem}"
			        & ".sub i{display:inline-block;width:8rem;height:8rem;border-radius:2rem}"
			        & ".r{display:grid;grid-template-columns:1fr 64rem 32rem 62rem;gap:6rem;align-items:center;padding:3.5rem 0;border-top:1px solid #E3E9E6}"
			        & ".r span{color:#5E6E67;white-space:nowrap}.r i{display:inline-block;width:10rem;height:3rem;border-radius:2rem;margin-right:5rem;vertical-align:2rem}"
			        & ".r b{text-align:right;font-weight:700}.r em{font-style:normal;color:#5E6E67;text-align:right}.r.t span{color:#14231D;font-weight:700}"
			        & ".c{font-weight:700;font-size:9.5rem;padding:1rem 5rem;border-radius:4rem;text-align:center;white-space:nowrap}.vs{color:#5E6E67;font-size:9rem;margin-top:5rem}</style>"
			        & "<div class='w'><div class='m'>" & UPPER ( FORMAT ( _m, "mmmm yyyy" ) ) & " · " & UPPER ( [Area_label] ) & "</div>" & _rows
			        & "<div class='r t'><span>All deductions</span><b>" & SWITCH ( TRUE (), ISBLANK ( _d ), _sym & "0", ABS ( _d ) >= 1e12, _sym & FORMAT ( _d / 1e12, "0.00" ) & "tn", ABS ( _d ) >= 1e9, _sym & FORMAT ( _d / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _d / 1e6, "0.0" ) & "m" ) & "</b><em>100%</em>" & SWITCH ( TRUE (), ( ISBLANK ( _dp ) || _dp = 0 ) && ( ISBLANK ( _d ) || _d = 0 ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>–</span>", ISBLANK ( _dp ) || _dp = 0, "<span class='c' style='color:#5E6E67;background:#EDF2EF'>Resumed</span>", ISBLANK ( _d ) || _d = 0, "<span class='c' style='color:#5E6E67;background:#EDF2EF'>Not paid</span>", "<span class='c' style='color:" & IF ( ROUND ( DIVIDE ( _d - _dp, _dp ), 4 ) = 0, "#C98A00", IF ( DIVIDE ( _d - _dp, _dp ) > 0, "#C93C3C", "#0E8A5F" ) ) & ";background:" & IF ( ROUND ( DIVIDE ( _d - _dp, _dp ), 4 ) = 0, "#FBF1DC", IF ( DIVIDE ( _d - _dp, _dp ) > 0, "#FBE7E7", "#E3F4EC" ) ) & "'>" & IF ( ROUND ( DIVIDE ( _d - _dp, _dp ), 4 ) = 0, UNICHAR ( 9632 ), IF ( DIVIDE ( _d - _dp, _dp ) > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) ) & " " & FORMAT ( ABS ( DIVIDE ( _d - _dp, _dp ) ), "0.0%" ) & "</span>" ) & "</div>"
			        & "<div class='vs'>Change vs " & FORMAT ( _pm, "mmm yyyy" ) & " · deductions up = red</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure External_debt_share_of_total =
			-- A state's share of all external debt deducted this period
			DIVIDE ( [External_Debt], CALCULATE ( [External_Debt], REMOVEFILTERS ( dim_state ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Shares

	measure External_debt_state_tt_html =
			-- Tooltip card for the external debt bars: state, zone, amount, share of all external debt, change (a rise is red)
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _v = [External_Debt]
			VAR _p = CALCULATE ( [External_Debt], 'Period Calc'[Name] = "Previous" )
			RETURN
			    "<style>html{font-size:calc(100vh / 136)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;letter-spacing:.5rem;margin-bottom:5rem}.sub{display:flex;align-items:center;gap:5rem;color:#5E6E67;font-size:9.5rem;margin:-2rem 0 6rem}"
			        & ".sub i{display:inline-block;width:8rem;height:8rem;border-radius:2rem}"
			        & ".r{display:grid;grid-template-columns:1fr auto;gap:6rem;align-items:center;padding:3.5rem 0;border-top:1px solid #E3E9E6}"
			        & ".r span{color:#5E6E67;white-space:nowrap}.r i{display:inline-block;width:10rem;height:3rem;border-radius:2rem;margin-right:5rem;vertical-align:2rem}"
			        & ".r b{text-align:right;font-weight:700}.r em{font-style:normal;color:#5E6E67;text-align:right}.r.t span{color:#14231D;font-weight:700}"
			        & ".c{font-weight:700;font-size:9.5rem;padding:1rem 5rem;border-radius:4rem;text-align:center;white-space:nowrap}.vs{color:#5E6E67;font-size:9rem;margin-top:5rem}</style>"
			        & "<div class='w'><div class='m'>" & UPPER ( SELECTEDVALUE ( dim_state[state] ) ) & "</div>"
			        & "<div class='sub'><i style='background:" & [Zone_colour] & "'></i>" & SELECTEDVALUE ( dim_state[zone] ) & "</div>"
			        & "<div class='r'><span>External debt</span><b>" & SWITCH ( TRUE (), ISBLANK ( _v ), _sym & "0", ABS ( _v ) >= 1e12, _sym & FORMAT ( _v / 1e12, "0.00" ) & "tn", ABS ( _v ) >= 1e9, _sym & FORMAT ( _v / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _v / 1e6, "0.0" ) & "m" ) & "</b></div>"
			        & "<div class='r'><span>Share of all external debt</span><b>" & FORMAT ( [External_debt_share_of_total], "0.0%" ) & "</b></div>"
			        & "<div class='r'><span>Change " & [Periodic_text] & "</span>" & SWITCH ( TRUE (), ( ISBLANK ( _p ) || _p = 0 ) && ( ISBLANK ( _v ) || _v = 0 ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>–</span>", ISBLANK ( _p ) || _p = 0, "<span class='c' style='color:#5E6E67;background:#EDF2EF'>Resumed</span>", ISBLANK ( _v ) || _v = 0, "<span class='c' style='color:#5E6E67;background:#EDF2EF'>Not paid</span>", "<span class='c' style='color:" & IF ( ROUND ( DIVIDE ( _v - _p, _p ), 4 ) = 0, "#C98A00", IF ( DIVIDE ( _v - _p, _p ) > 0, "#C93C3C", "#0E8A5F" ) ) & ";background:" & IF ( ROUND ( DIVIDE ( _v - _p, _p ), 4 ) = 0, "#FBF1DC", IF ( DIVIDE ( _v - _p, _p ) > 0, "#FBE7E7", "#E3F4EC" ) ) & "'>" & IF ( ROUND ( DIVIDE ( _v - _p, _p ), 4 ) = 0, UNICHAR ( 9632 ), IF ( DIVIDE ( _v - _p, _p ) > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) ) & " " & FORMAT ( ABS ( DIVIDE ( _v - _p, _p ) ), "0.0%" ) & "</span>" ) & "</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure Metric_heat_colour =
			-- Matrix heat shading: darker green for bigger values within each column (each deduction line)
			VAR _v = [Metric_value]
			VAR _mx = MAXX ( ALLSELECTED ( dim_state[state] ), [Metric_value] )
			VAR _t = DIVIDE ( _v, _mx )
			RETURN
			    SWITCH ( TRUE (),
			        ISBLANK ( _v ) || _v <= 0, "#FFFFFF",
			        _t < 0.2, "#EFF8F3",
			        _t < 0.4, "#DAF0E4",
			        _t < 0.6, "#BFE4D1",
			        _t < 0.8, "#9BD3B8",
			        "#74BE9C" )
		displayFolder: 05 Visual Helpers\Colours

	measure Deductions_insight_html =
			-- Key takeaway banner for Deductions: total and change (a fall is good), share of gross, biggest line, most external debt
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _up = "<span class='up'>"
			VAR _dn = "<span class='dn'>"
			VAR _hl = "<span class='hl'>"
			VAR _e = "</span>"
			VAR _d = [Deductions_curr]
			VAR _chg = [Deductions_PnP]
			VAR _t = UNION (
			        ROW ( "n", "External debt", "c", CALCULATE ( [External_Debt], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "Contractual (ISPO)", "c", CALCULATE ( [Contractual_Obligation], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "NDDC / HYPPADEC", "c", CALCULATE ( [NDDC_Transfer], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "Other (see note)", "c", CALCULATE ( [Other_Deductions_Note], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "Unlabelled", "c", CALCULATE ( [Deduction_Misc], 'Period Calc'[Name] = "Current" ) ),
			        ROW ( "n", "Other deductions", "c", CALCULATE ( [Other_Deduction], 'Period Calc'[Name] = "Current" ) )
			    )
			VAR _big = TOPN ( 1, _t, [c], DESC )
			VAR _ext = TOPN ( 1, FILTER ( ADDCOLUMNS ( VALUES ( dim_state[state] ), "@x", CALCULATE ( [External_Debt], 'Period Calc'[Name] = "Current" ) ), [@x] > 0 ), [@x], DESC )
			VAR _who = IF ( [Area_label] = "All states", "States", [Area_label] )
			VAR _msg =
			    _who & " lost " & _hl & SWITCH ( TRUE (), ISBLANK ( _d ), _sym & "0", ABS ( _d ) >= 1e12, _sym & FORMAT ( _d / 1e12, "0.00" ) & "tn", ABS ( _d ) >= 1e9, _sym & FORMAT ( _d / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _d / 1e6, "0.0" ) & "m" ) & _e & " to deductions in " & [Period_label]
			        & IF ( ISBLANK ( _chg ), "",
			            ", " & IF ( _chg <= 0, _up & UNICHAR ( 9660 ), _dn & UNICHAR ( 9650 ) ) & " " & FORMAT ( ABS ( _chg ), "0.0%" ) & _e & " " & [Periodic_text] )
			        & ", " & FORMAT ( DIVIDE ( _d, [Gross_curr] ), "0.0%" ) & " of gross. "
			        & MAXX ( _big, [n] ) & " was the biggest line at " & _hl & FORMAT ( DIVIDE ( MAXX ( _big, [c] ), _d ), "0%" ) & _e
			        & IF ( COUNTROWS ( _ext ) = 1 && COUNTROWS ( VALUES ( dim_state[state] ) ) > 1,
			            ", and " & MAXX ( _ext, dim_state[state] ) & " had the most external debt deducted, " & _hl & SWITCH ( TRUE (), ISBLANK ( MAXX ( _ext, [@x] ) ), _sym & "0", ABS ( MAXX ( _ext, [@x] ) ) >= 1e12, _sym & FORMAT ( MAXX ( _ext, [@x] ) / 1e12, "0.00" ) & "tn", ABS ( MAXX ( _ext, [@x] ) ) >= 1e9, _sym & FORMAT ( MAXX ( _ext, [@x] ) / 1e9, "0.0" ) & "bn", _sym & FORMAT ( MAXX ( _ext, [@x] ) / 1e6, "0.0" ) & "m" ) & _e & ".",
			            "." )
			RETURN
			    [Banner_css]
			        & "<div class='b'><div class='ic'><svg viewBox='0 0 16 16' style='width:16rem;height:16rem'><path d='M8 1.5a4.5 4.5 0 0 0-2.6 8.2V12h5.2V9.7A4.5 4.5 0 0 0 8 1.5zM6 13.2h4V14.5H6z' fill='#E2B53E'/></svg></div>"
			        & "<div class='k'>KEY TAKEAWAY<br>" & UPPER ( [Period_label] ) & "</div><div class='t'>" & _msg & "</div></div>"
		displayFolder: 06 Titles & Labels\Insights

	measure Metric_value_short =
			-- Short money text for matrix cells: ₦3.3bn rather than ₦3,312,404,118
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _v = [Metric_value]
			RETURN SWITCH ( TRUE (), ISBLANK ( _v ) || _v = 0, "–", ABS ( _v ) >= 1e12, _sym & FORMAT ( _v / 1e12, "0.00" ) & "tn", ABS ( _v ) >= 1e9, _sym & FORMAT ( _v / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _v / 1e6, "0.0" ) & "m" )
		displayFolder: 06 Titles & Labels\Text

	measure Side_A_bar_svg =
			-- Butterfly bar for side A: grows left from the centre, coloured by the rule like side B (user, 2026-11-06)
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a = DIVIDE ( CALCULATE ( [Side_A_total] ), SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 ) )
			VAR _b = DIVIDE ( CALCULATE ( [Side_B_total] ), SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 ) )
			VAR _w = DIVIDE ( _a, MAX ( _a, _b ) ) * 246
			RETURN
			    IF ( ISBLANK ( _a ), BLANK (),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='250' height='16'>"
			            & "<rect x='" & FORMAT ( 250 - _w, "0.0" ) & "' y='2' width='" & FORMAT ( _w, "0.0" ) & "' height='12' rx='2' fill='" & SWITCH ( [Metric_A_colour], "#0E8A5F", "rgb(14,138,95)", "#C93C3C", "rgb(201,60,60)", "#C98A00", "rgb(201,138,0)", "rgb(107,124,115)" ) & "'/></svg>" )
		displayFolder: 05 Visual Helpers\SVG
		dataCategory: ImageUrl

	measure Side_B_bar_svg =
			-- Butterfly bar for side B: grows right, coloured by the rule (better green, worse red, equal amber)
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a = DIVIDE ( CALCULATE ( [Side_A_total] ), SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 ) )
			VAR _b = DIVIDE ( CALCULATE ( [Side_B_total] ), SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 ) )
			VAR _w = DIVIDE ( _b, MAX ( _a, _b ) ) * 246
			VAR _fill = SWITCH ( [Metric_B_colour], "#0E8A5F", "rgb(14,138,95)", "#C93C3C", "rgb(201,60,60)", "#C98A00", "rgb(201,138,0)", "rgb(107,124,115)" )
			RETURN
			    IF ( ISBLANK ( _b ), BLANK (),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='250' height='16'>"
			            & "<rect x='0' y='2' width='" & FORMAT ( _w, "0.0" ) & "' height='12' rx='2' fill='" & _fill & "'/></svg>" )
		displayFolder: 05 Visual Helpers\SVG
		dataCategory: ImageUrl

	measure Side_A_value_text =
			-- Short money text for side A on the selected basis
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a = DIVIDE ( CALCULATE ( [Side_A_total] ), SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 ) )
			VAR _b = DIVIDE ( CALCULATE ( [Side_B_total] ), SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 ) )
			RETURN SWITCH ( TRUE (), ISBLANK ( _a ), "–", ABS ( _a ) >= 1e12, _sym & FORMAT ( _a / 1e12, "0.00" ) & "tn", ABS ( _a ) >= 1e9, _sym & FORMAT ( _a / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _a / 1e6, "0.0" ) & "m" )
		displayFolder: 06 Titles & Labels\Text

	measure Side_B_value_text =
			-- Short money text for side B on the selected basis
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a = DIVIDE ( CALCULATE ( [Side_A_total] ), SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 ) )
			VAR _b = DIVIDE ( CALCULATE ( [Side_B_total] ), SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 ) )
			RETURN SWITCH ( TRUE (), ISBLANK ( _b ), "–", ABS ( _b ) >= 1e12, _sym & FORMAT ( _b / 1e12, "0.00" ) & "tn", ABS ( _b ) >= 1e9, _sym & FORMAT ( _b / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _b / 1e6, "0.0" ) & "m" )
		displayFolder: 06 Titles & Labels\Text

	measure Compare_change_short =
			-- B vs A change chip text, e.g. "▲ 124.6%"; coloured with Metric_B_colour
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a = DIVIDE ( CALCULATE ( [Side_A_total] ), SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 ) )
			VAR _b = DIVIDE ( CALCULATE ( [Side_B_total] ), SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 ) )
			VAR _d = DIVIDE ( _b - _a, _a )
			RETURN
			    IF ( ISBLANK ( _a ) || ISBLANK ( _b ), "–",
			        SWITCH ( TRUE (), ROUND ( _d, 4 ) = 0, UNICHAR ( 9632 ), _d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _d ), "0.0%" ) )
		displayFolder: 06 Titles & Labels\Text

	measure Compare_tt_html =
			-- Compare Metric tooltip card: metric, basis and currency, definition, both sides, and the coloured verdict
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _a = DIVIDE ( CALCULATE ( [Side_A_total] ), SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 ) )
			VAR _b = DIVIDE ( CALCULATE ( [Side_B_total] ), SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 ) )
			VAR _col = [Metric_B_colour]
			RETURN
			    "<style>html{font-size:calc(100vh / 190)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;letter-spacing:.5rem}.sub{color:#5E6E67;font-size:9.5rem;margin:2rem 0 5rem}"
			        & ".def{color:#5E6E67;font-size:9.5rem;line-height:1.4;margin:0 0 7rem}"
			        & ".r{display:flex;justify-content:space-between;gap:12rem;padding:4rem 0;border-top:1px solid #E3E9E6}.r span{color:#5E6E67}.r b{font-weight:700}"
			        & ".v{font-weight:700;font-size:10.5rem;margin-top:6rem}</style>"
			        & "<div class='w'><div class='m'>" & UPPER ( SELECTEDVALUE ( Metric_param[Metric_label] ) ) & "</div>"
			        & "<div class='sub'>" & LOWER ( SELECTEDVALUE ( Basis[Basis], "Total" ) ) & " · " & IF ( _sym = "$", "US dollars", "naira" ) & "</div>"
			        & "<div class='def'>" & [Metric_definition] & "</div>"
			        & "<div class='r'><span>" & [Side_A_label] & "</span><b>" & SWITCH ( TRUE (), ISBLANK ( _a ), "–", ABS ( _a ) >= 1e12, _sym & FORMAT ( _a / 1e12, "0.00" ) & "tn", ABS ( _a ) >= 1e9, _sym & FORMAT ( _a / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _a / 1e6, "0.0" ) & "m" ) & "</b></div>"
			        & "<div class='r'><span>" & [Side_B_label] & "</span><b>" & SWITCH ( TRUE (), ISBLANK ( _b ), "–", ABS ( _b ) >= 1e12, _sym & FORMAT ( _b / 1e12, "0.00" ) & "tn", ABS ( _b ) >= 1e9, _sym & FORMAT ( _b / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _b / 1e6, "0.0" ) & "m" ) & "</b></div>"
			        & "<div class='v' style='color:" & _col & "'>" & [Compare_tooltip_text] & "</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure Comparison_insight_html =
			-- "In short" banner for Compare: B's net and change vs A, deductions and their share of gross on each side
			VAR _sym = IF ( SELECTEDVALUE ( Currency[Currency], "₦" ) = "$", "$", "₦" )
			VAR _basis = SELECTEDVALUE ( Basis[Basis], "Total" )
			VAR _by = SELECTEDVALUE ( Compare_By[compare_by], "Administration" )
			VAR _na = [Side_A_label]
			VAR _nb = [Side_B_label]
			VAR _netA = DIVIDE ( CALCULATE ( [Side_A_total], Metric_param[Metric_key] = "Net" ), SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 ) )
			VAR _netB = DIVIDE ( CALCULATE ( [Side_B_total], Metric_param[Metric_key] = "Net" ), SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 ) )
			VAR _dedA = DIVIDE ( CALCULATE ( [Side_A_total], Metric_param[Metric_key] = "Deductions" ), SWITCH ( _basis, "Monthly average", [Side_A_months], "Per state per month", [Side_A_state_months], 1 ) )
			VAR _dedB = DIVIDE ( CALCULATE ( [Side_B_total], Metric_param[Metric_key] = "Deductions" ), SWITCH ( _basis, "Monthly average", [Side_B_months], "Per state per month", [Side_B_state_months], 1 ) )
			VAR _shA = DIVIDE ( CALCULATE ( [Side_A_total], Metric_param[Metric_key] = "Deductions" ), CALCULATE ( [Side_A_total], Metric_param[Metric_key] = "Gross" ) )
			VAR _shB = DIVIDE ( CALCULATE ( [Side_B_total], Metric_param[Metric_key] = "Deductions" ), CALCULATE ( [Side_B_total], Metric_param[Metric_key] = "Gross" ) )
			VAR _cn = DIVIDE ( _netB - _netA, _netA )
			VAR _cd = DIVIDE ( _dedB - _dedA, _dedA )
			VAR _phrase = SWITCH ( _basis, "Monthly average", "a month on average", "Per state per month", "per state per month", "in total" )
			VAR _up = "<span class='up'>"
			VAR _dn = "<span class='dn'>"
			VAR _hl = "<span class='hl'>"
			VAR _e = "</span>"
			VAR _netSpan = IF ( _cn >= 0, _up & UNICHAR ( 9650 ), _dn & UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _cn ), "0.0%" ) & _e
			VAR _dedSpan = IF ( _cd <= 0, _up & UNICHAR ( 9660 ), _dn & UNICHAR ( 9650 ) ) & " " & FORMAT ( ABS ( _cd ), "0.0%" ) & _e
			-- "but" when deductions rose while their share of gross fell, otherwise "and"
			VAR _join = IF ( ( _cd > 0 ) = ( _shB < _shA ), "but", "and" )
			VAR _subject = IF ( _by = "Administration", "Under " & _nb & ", states received", _nb & " received" )
			VAR _msg =
			    IF ( ISBLANK ( _netA ) || ISBLANK ( _netB ) || _na = _nb,
			        IF ( _na = _nb, "Pick two different " & LOWER ( _by ) & "s to compare.", "No data for one side in the selected dates." ),
			        _subject & " " & _hl & SWITCH ( TRUE (), ISBLANK ( _netB ), "–", ABS ( _netB ) >= 1e12, _sym & FORMAT ( _netB / 1e12, "0.00" ) & "tn", ABS ( _netB ) >= 1e9, _sym & FORMAT ( _netB / 1e9, "0.0" ) & "bn", _sym & FORMAT ( _netB / 1e6, "0.0" ) & "m" ) & _e & " net " & _phrase & ", " & _netSpan & " vs " & _na & ". "
			            & "Deductions were " & _dedSpan & ", " & _join & " took " & IF ( _shB < _shA, "a smaller", "a bigger" ) & " share of gross ("
			            & IF ( _shB < _shA, _up, _dn ) & FORMAT ( _shB, "0.0%" ) & _e & " vs " & FORMAT ( _shA, "0.0%" ) & ")."
			            & "<span class='nom'>" & IF ( _sym = "$", "US dollars at each month's rate.", "Nominal naira, not adjusted for inflation." )
			            & " See FAAC in real terms for price-adjusted figures.</span>" )
			RETURN
			    "<style>html{font-size:calc(100vh / 68)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".b{position:fixed;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;gap:14rem;padding:0 18rem;border-radius:12rem;box-sizing:border-box;"
			        & "background:linear-gradient(90deg,#0B3D2E 0%,#145A43 70%,#1D6B51 100%);color:#fff;font-family:Segoe UI,sans-serif}"
			        & ".ic{width:28rem;height:28rem;border-radius:8rem;background:rgba(226,181,62,.18);display:flex;align-items:center;justify-content:center;flex:none}"
			        & ".k{font-size:8.5rem;letter-spacing:2rem;color:#E2B53E;font-weight:600;white-space:nowrap}"
			        & ".t{font-size:12rem;line-height:1.35;flex:1}.up{color:#6EE0AE;font-weight:700}.dn{color:#FF9A9A;font-weight:700}.hl{color:#E2B53E;font-weight:700}"
			        & ".nom{display:block;font-size:9.5rem;opacity:.75;margin-top:3rem}"
			        & ".lg{flex:none;font-size:9.5rem;line-height:1.6;opacity:.9;padding-left:14rem;border-left:1px solid rgba(255,255,255,.2)}"
			        & ".lg i{display:inline-block;width:8rem;height:8rem;border-radius:50%;margin:0 4rem 0 8rem}.lg i:first-child{margin-left:0}</style>"
			        & "<div class='b'><div class='ic'><svg viewBox='0 0 16 16' style='width:16rem;height:16rem'><path d='M8 1.5a4.5 4.5 0 0 0-2.6 8.2V12h5.2V9.7A4.5 4.5 0 0 0 8 1.5zM6 13.2h4V14.5H6z' fill='#E2B53E'/></svg></div>"
			        & "<div class='k'>IN SHORT</div><div class='t'>" & _msg & "</div>"
			        & "<div class='lg'><i style='background:#3FD08F'></i>Better <i style='background:#FF8A8A'></i>Worse <i style='background:#F2C14E'></i>Equal<br>Each side vs the other · deductions: higher is worse</div></div>"
		displayFolder: 06 Titles & Labels\Insights

	measure Inflation_flipcard =
			-- Flip card: inflation. Front = value, change, sparkline; back = what it means
			VAR _last = [Inflation_latest_month]
			VAR _v = [Inflation_latest]
			-- Peak in the selected years
			VAR _pk = TOPN ( 1, FILTER ( ADDCOLUMNS ( VALUES ( econ_month[month_date] ), "@i", CALCULATE ( [Inflation_yoy] ) ), NOT ISBLANK ( [@i] ) ), [@i], DESC )
			VAR _col = [Inflation_colour]
			VAR _pts = ADDCOLUMNS ( FILTER ( ALL ( econ_month[month_date] ), econ_month[month_date] > EDATE ( _last, -6 ) && econ_month[month_date] <= _last ), "@k", econ_month[month_date], "@v", VAR _mm = econ_month[month_date] RETURN CALCULATE ( [Inflation_yoy], REMOVEFILTERS ( calendar_table ), econ_month[month_date] = _mm ) )
			VAR _pi = ADDCOLUMNS ( _pts, "@i", RANKX ( _pts, [@k], , ASC ) - 1 )
			VAR _n = COUNTROWS ( _pts )
			VAR _lo = MINX ( _pts, [@v] )
			VAR _hi = MAXX ( _pts, [@v] )
			VAR _xy = ADDCOLUMNS ( _pi, "@x", 3 + [@i] * 74 / MAX ( _n - 1, 1 ), "@y", 27 - DIVIDE ( [@v] - _lo, _hi - _lo, 0.5 ) * 22 )
			VAR _poly = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0" ) & "," & FORMAT ( [@y], "0.0" ), " ", [@i], ASC )
			VAR _end = TOPN ( 1, _xy, [@i], DESC )
			VAR _spark =
			    "<svg viewBox='0 0 80 30' style='width:80rem;height:30rem'><polyline points='" & _poly & "' fill='none' stroke='#0B3D2E' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>"
			        & "<circle cx='" & FORMAT ( MAXX ( _end, [@x] ), "0.0" ) & "' cy='" & FORMAT ( MAXX ( _end, [@y] ), "0.0" ) & "' r='3' fill='#0B3D2E'/></svg>"
			VAR _back = "Prices were " & FORMAT ( _v, "0.0%" ) & " higher than a year earlier" & IF ( MAXX ( _pk, econ_month[month_date] ) = _last, ", the highest in the selected years.", ", down from the " & FORMAT ( MAXX ( _pk, [@i] ), "0.0%" ) & " peak in " & FORMAT ( MAXX ( _pk, econ_month[month_date] ), "mmm yyyy" ) & "." )
			RETURN
			    [Flip_css]
			        & "<div class='fc'><div class='fi'><div class='face front'><div class='lbl'>INFLATION</div>"
			        & "<div class='val'>" & FORMAT ( _v, "0.0%" ) & "</div>"
			        & "<div class='chg'><span class='bd' style='color:" & _col & ";background:" & SWITCH ( _col, "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#FBF1DC" ) & "'>" & [Inflation_change_text] & "</span></div>"
			        & "<div class='sp'>" & _spark & "</div><div class='asof'>" & [Inflation_as_of_text] & "</div><div class='hint'>HOVER &#8635;</div></div>"
			        & "<div class='face back'><div class='bt'>WHAT IT MEANS</div><p>" & _back & "</p></div></div></div>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure Naira_flipcard =
			-- Flip card: naira per US dollar. Front = value, change, sparkline; back = what it means
			VAR _last = [Naira_latest_month]
			VAR _v = [Naira_latest]
			VAR _first = CALCULATE ( MIN ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) )
			VAR _v0 = CALCULATE ( [Naira_per_usd], econ_month[month_date] = _first )
			VAR _col = [Naira_colour]
			VAR _pts = ADDCOLUMNS ( FILTER ( ALL ( econ_month[month_date] ), econ_month[month_date] > EDATE ( _last, -6 ) && econ_month[month_date] <= _last ), "@k", econ_month[month_date], "@v", VAR _mm = econ_month[month_date] RETURN CALCULATE ( [Naira_per_usd], REMOVEFILTERS ( calendar_table ), econ_month[month_date] = _mm ) )
			VAR _pi = ADDCOLUMNS ( _pts, "@i", RANKX ( _pts, [@k], , ASC ) - 1 )
			VAR _n = COUNTROWS ( _pts )
			VAR _lo = MINX ( _pts, [@v] )
			VAR _hi = MAXX ( _pts, [@v] )
			VAR _xy = ADDCOLUMNS ( _pi, "@x", 3 + [@i] * 74 / MAX ( _n - 1, 1 ), "@y", 27 - DIVIDE ( [@v] - _lo, _hi - _lo, 0.5 ) * 22 )
			VAR _poly = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0" ) & "," & FORMAT ( [@y], "0.0" ), " ", [@i], ASC )
			VAR _end = TOPN ( 1, _xy, [@i], DESC )
			VAR _spark =
			    "<svg viewBox='0 0 80 30' style='width:80rem;height:30rem'><polyline points='" & _poly & "' fill='none' stroke='#0B3D2E' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>"
			        & "<circle cx='" & FORMAT ( MAXX ( _end, [@x] ), "0.0" ) & "' cy='" & FORMAT ( MAXX ( _end, [@y] ), "0.0" ) & "' r='3' fill='#0B3D2E'/></svg>"
			VAR _back = "A dollar cost ₦" & FORMAT ( _v, "#,0" ) & " in " & FORMAT ( _last, "mmm yyyy" ) & ", " & FORMAT ( DIVIDE ( _v, _v0 ), "0.0" ) & "× the ₦" & FORMAT ( _v0, "#,0" ) & " of " & FORMAT ( _first, "mmm yyyy" ) & "."
			RETURN
			    [Flip_css]
			        & "<div class='fc'><div class='fi'><div class='face front'><div class='lbl'>NAIRA PER US DOLLAR</div>"
			        & "<div class='val'>" & "₦" & FORMAT ( _v, "#,0" ) & "<small>/ $</small>" & "</div>"
			        & "<div class='chg'><span class='bd' style='color:" & _col & ";background:" & SWITCH ( _col, "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#FBF1DC" ) & "'>" & [Naira_change_text] & "</span></div>"
			        & "<div class='sp'>" & _spark & "</div><div class='asof'>" & [Naira_as_of_text] & " average" & "</div><div class='hint'>HOVER &#8635;</div></div>"
			        & "<div class='face back'><div class='bt'>WHAT IT MEANS</div><p>" & _back & "</p></div></div></div>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure Growth_flipcard =
			-- Flip card: real GDP growth. Front = value, change, sparkline; back = what it means
			VAR _y = [GDP_latest_year]
			VAR _v = [Growth_latest]
			VAR _p = [Growth_prev]
			VAR _d = _v - _p
			-- Growth vs last year's growth is a change of pace, not a decline: amber when slower, red only below 0
			VAR _col = SWITCH ( TRUE (), _v < 0, "#C93C3C", ISBLANK ( _p ) || ROUND ( _d, 3 ) = 0 || _d < 0, "#C98A00", "#0E8A5F" )
			VAR _chg = SWITCH ( TRUE (),
			    _v < 0, "Economy shrank",
			    ISBLANK ( _p ), "No earlier year",
			    ROUND ( _d, 3 ) = 0, "Same pace as " & ( _y - 1 ),
			    FORMAT ( ABS ( _d ) * 100, "0.0" ) & " pts " & IF ( _d < 0, "slower", "faster" ) & " than " & ( _y - 1 ) )
			VAR _pop = CALCULATE ( [Population_growth], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _y )
			VAR _pts = ADDCOLUMNS ( FILTER ( ALL ( econ_year[year] ), econ_year[year] > _y - 6 && econ_year[year] <= _y ), "@k", econ_year[year], "@v", VAR _yy = econ_year[year] RETURN CALCULATE ( [Real_GDP_growth], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _yy ) )
			VAR _pi = ADDCOLUMNS ( _pts, "@i", RANKX ( _pts, [@k], , ASC ) - 1 )
			VAR _n = COUNTROWS ( _pts )
			VAR _lo = MINX ( _pts, [@v] )
			VAR _hi = MAXX ( _pts, [@v] )
			VAR _xy = ADDCOLUMNS ( _pi, "@x", 3 + [@i] * 74 / MAX ( _n - 1, 1 ), "@y", 27 - DIVIDE ( [@v] - _lo, _hi - _lo, 0.5 ) * 22 )
			VAR _poly = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0" ) & "," & FORMAT ( [@y], "0.0" ), " ", [@i], ASC )
			VAR _end = TOPN ( 1, _xy, [@i], DESC )
			VAR _spark =
			    "<svg viewBox='0 0 80 30' style='width:80rem;height:30rem'><polyline points='" & _poly & "' fill='none' stroke='#0B3D2E' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>"
			        & "<circle cx='" & FORMAT ( MAXX ( _end, [@x] ), "0.0" ) & "' cy='" & FORMAT ( MAXX ( _end, [@y] ), "0.0" ) & "' r='3' fill='#0B3D2E'/></svg>"
			VAR _back = "The economy grew " & FORMAT ( _v, "0.0%" ) & " in " & _y & " after removing price rises. The population grew " & FORMAT ( _pop, "0.0%" ) & ", so the average Nigerian's share " & IF ( _v >= _pop, "grew.", "shrank." )
			RETURN
			    [Flip_css]
			        & "<div class='fc'><div class='fi'><div class='face front'><div class='lbl'>REAL GDP GROWTH</div>"
			        & "<div class='val'>" & FORMAT ( _v, "0.0%" ) & "</div>"
			        & "<div class='chg'><span class='bd' style='color:" & _col & ";background:" & SWITCH ( _col, "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#FBF1DC" ) & "'>" & _chg & "</span></div>"
			        & "<div class='sp'>" & _spark & "</div><div class='asof'>" & [GDP_as_of_text] & ", World Bank" & "</div><div class='hint'>HOVER &#8635;</div></div>"
			        & "<div class='face back'><div class='bt'>WHAT IT MEANS</div><p>" & _back & "</p></div></div></div>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure PerPerson_flipcard =
			-- Flip card: GDP per person. Front = value, change, sparkline; back = what it means
			VAR _y = [GDP_latest_year]
			VAR _v = [GDP_per_person_usd_latest]
			VAR _p = CALCULATE ( [GDP_per_person_usd], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _y - 1 )
			VAR _c = DIVIDE ( _v - _p, _p )
			-- Peak year in the selected years
			VAR _pk = TOPN ( 1, FILTER ( ADDCOLUMNS ( VALUES ( econ_year[year] ), "@p", CALCULATE ( [GDP_per_person_usd] ) ), NOT ISBLANK ( [@p] ) ), [@p], DESC )
			VAR _col = SWITCH ( TRUE (), ISBLANK ( _p ) || ROUND ( _c, 4 ) = 0, "#C98A00", _c > 0, "#0E8A5F", "#C93C3C" )
			VAR _pts = ADDCOLUMNS ( FILTER ( ALL ( econ_year[year] ), econ_year[year] > _y - 6 && econ_year[year] <= _y ), "@k", econ_year[year], "@v", VAR _yy = econ_year[year] RETURN CALCULATE ( [GDP_per_person_usd], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _yy ) )
			VAR _pi = ADDCOLUMNS ( _pts, "@i", RANKX ( _pts, [@k], , ASC ) - 1 )
			VAR _n = COUNTROWS ( _pts )
			VAR _lo = MINX ( _pts, [@v] )
			VAR _hi = MAXX ( _pts, [@v] )
			VAR _xy = ADDCOLUMNS ( _pi, "@x", 3 + [@i] * 74 / MAX ( _n - 1, 1 ), "@y", 27 - DIVIDE ( [@v] - _lo, _hi - _lo, 0.5 ) * 22 )
			VAR _poly = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0" ) & "," & FORMAT ( [@y], "0.0" ), " ", [@i], ASC )
			VAR _end = TOPN ( 1, _xy, [@i], DESC )
			VAR _spark =
			    "<svg viewBox='0 0 80 30' style='width:80rem;height:30rem'><polyline points='" & _poly & "' fill='none' stroke='#0B3D2E' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>"
			        & "<circle cx='" & FORMAT ( MAXX ( _end, [@x] ), "0.0" ) & "' cy='" & FORMAT ( MAXX ( _end, [@y] ), "0.0" ) & "' r='3' fill='#0B3D2E'/></svg>"
			VAR _back = "Output per Nigerian was $" & FORMAT ( _v, "#,0" ) & " in " & _y & IF ( MAXX ( _pk, econ_year[year] ) = _y, ", the highest in the selected years.", ", " & FORMAT ( 1 - DIVIDE ( _v, MAXX ( _pk, [@p] ) ), "0%" ) & " below its " & MAXX ( _pk, econ_year[year] ) & " peak of $" & FORMAT ( MAXX ( _pk, [@p] ), "#,0" ) & ", mostly because the naira fell." )
			RETURN
			    [Flip_css]
			        & "<div class='fc'><div class='fi'><div class='face front'><div class='lbl'>GDP PER PERSON</div>"
			        & "<div class='val'>" & "$" & FORMAT ( _v, "#,0" ) & "<small>" & FORMAT ( [GDP_per_person_naira_latest] / 1e6, "₦0.00" ) & "m</small>" & "</div>"
			        & "<div class='chg'><span class='bd' style='color:" & _col & ";background:" & SWITCH ( _col, "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#FBF1DC" ) & "'>" & IF ( ISBLANK ( _p ), "No earlier year", IF ( _c >= 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _c ), "0.0%" ) & " vs " & ( _y - 1 ) ) & "</span></div>"
			        & "<div class='sp'>" & _spark & "</div><div class='asof'>" & [GDP_as_of_text] & ", in US dollars" & "</div><div class='hint'>HOVER &#8635;</div></div>"
			        & "<div class='face back'><div class='bt'>WHAT IT MEANS</div><p>" & _back & "</p></div></div></div>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure Economy_insight_html =
			-- Key takeaway banner for Economy Overview: inflation now vs its peak in the selected years, and the naira vs the start
			VAR _up = "<span class='up'>"
			VAR _dn = "<span class='dn'>"
			VAR _hl = "<span class='hl'>"
			VAR _e = "</span>"
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( econ_month[month_date] ), "@i", CALCULATE ( [Inflation_yoy] ), "@r", CALCULATE ( [Naira_per_usd] ) ), NOT ISBLANK ( [@i] ) || NOT ISBLANK ( [@r] ) )
			VAR _li = [Inflation_latest_month]
			VAR _i = [Inflation_latest]
			VAR _pk = TOPN ( 1, FILTER ( _t, NOT ISBLANK ( [@i] ) ), [@i], DESC )
			VAR _pkm = MAXX ( _pk, econ_month[month_date] )
			VAR _first = MINX ( FILTER ( _t, NOT ISBLANK ( [@r] ) ), econ_month[month_date] )
			VAR _r0 = MAXX ( FILTER ( _t, econ_month[month_date] = _first ), [@r] )
			VAR _r = [Naira_latest]
			VAR _x = DIVIDE ( _r, _r0 )
			VAR _msg =
			    "Inflation was " & _hl & FORMAT ( _i, "0.0%" ) & _e & " in " & FORMAT ( _li, "mmmm yyyy" )
			        & IF ( _pkm = _li, ", the highest in the selected years. ",
			            ", down from its " & _dn & FORMAT ( MAXX ( _pk, [@i] ), "0.0%" ) & _e & " peak in " & FORMAT ( _pkm, "mmm yyyy" ) & ". " )
			        & "A dollar cost " & _hl & "₦" & FORMAT ( _r, "#,0" ) & _e & ", "
			        & IF ( _x > 1.01, _dn & FORMAT ( _x, "0.0" ) & "×" & _e & " its level in " & FORMAT ( _first, "mmm yyyy" ) & ".",
			            "about the same as in " & FORMAT ( _first, "mmm yyyy" ) & "." )
			RETURN
			    [Banner_css]
			        & "<div class='b'><div class='ic'><svg viewBox='0 0 16 16' style='width:16rem;height:16rem'><path d='M8 1.5a4.5 4.5 0 0 0-2.6 8.2V12h5.2V9.7A4.5 4.5 0 0 0 8 1.5zM6 13.2h4V14.5H6z' fill='#E2B53E'/></svg></div>"
			        & "<div class='k'>KEY TAKEAWAY<br>" & UPPER ( FORMAT ( _li, "mmm yyyy" ) ) & "</div><div class='t'>" & _msg & "</div></div>"
		displayFolder: 06 Titles & Labels\Insights

	measure Inflation_explain_html =
			-- "What it means" side of the inflation chart (shown by a bookmark): definition, what the chart says,
			-- and how each president found and left inflation within the selected years
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( econ_month[month_date] ), "@i", CALCULATE ( [Inflation_yoy] ) ), NOT ISBLANK ( [@i] ) )
			VAR _first = MINX ( _t, econ_month[month_date] )
			VAR _last = MAXX ( _t, econ_month[month_date] )
			VAR _pk = TOPN ( 1, _t, [@i], DESC )
			VAR _now = MAXX ( FILTER ( _t, econ_month[month_date] = _last ), [@i] )
			VAR _avg = AVERAGEX ( _t, [@i] )
			-- Each president: first and last month with data in the selection, and inflation then
			VAR _ad0 = ADDCOLUMNS ( FILTER ( VALUES ( econ_month[president] ), NOT ISBLANK ( econ_month[president] ) ),
			    "@f", CALCULATE ( MIN ( econ_month[month_date] ), NOT ISBLANK ( econ_month[inflation_yoy] ) ),
			    "@l", CALCULATE ( MAX ( econ_month[month_date] ), NOT ISBLANK ( econ_month[inflation_yoy] ) ) )
			VAR _ad = ADDCOLUMNS ( FILTER ( _ad0, NOT ISBLANK ( [@f] ) ),
			    -- Found = the month before their first one (what they inherited); the first month in the data has no earlier month
			    "@a", VAR _f = [@f] RETURN COALESCE ( CALCULATE ( [Inflation_yoy], REMOVEFILTERS ( econ_month ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_month[month_date] = EDATE ( _f, -1 ) ), CALCULATE ( [Inflation_yoy], econ_month[month_date] = _f ) ),
			    "@b", VAR _l = [@l] RETURN CALCULATE ( [Inflation_yoy], econ_month[month_date] = _l ) )
			VAR _rows = CONCATENATEX ( _ad,
			    "<div class='ar'><span class='nm'>" & econ_month[president] & "<small>" & FORMAT ( [@f], "mmm yyyy" ) & " – " & FORMAT ( [@l], "mmm yyyy" ) & IF ( [@l] = _last, " (latest)", "" ) & "</small></span>"
			        & "<span class='vv'>" & FORMAT ( [@a], "0.0%" ) & " → " & FORMAT ( [@b], "0.0%" ) & "</span>"
			        & "<span class='ch' style='color:" & SWITCH ( TRUE (), ROUND ( [@b] - [@a], 3 ) = 0, "#F0C75E", [@b] < [@a], "#7FD6A8", "#FF8A80" ) & "'>"
			            & SWITCH ( TRUE (), ROUND ( [@b] - [@a], 3 ) = 0, UNICHAR ( 9632 ), [@b] < [@a], UNICHAR ( 9660 ), UNICHAR ( 9650 ) ) & " " & FORMAT ( ABS ( [@b] - [@a] ) * 100, "0.0" ) & " pts</span></div>",
			    "", [@f], ASC )
			RETURN
			    "<style>html{font-size:calc(100vh / 408)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".x{position:fixed;top:0;left:0;right:0;bottom:0;border-radius:12rem;background:#0B3D2E;color:#fff;padding:44rem 26rem 18rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;animation:fi .45s ease-out}"
			        & "@keyframes fi{from{transform:perspective(1200px) rotateY(-90deg);opacity:.2}to{transform:none;opacity:1}}"
			        & ".h{font-size:9.5rem;letter-spacing:1.8rem;color:#E2B53E;font-weight:700;margin-top:14rem}.h:first-child{margin-top:0}"
			        & ".x p{margin:5rem 0 0;font-size:13rem;line-height:1.45}.x b{color:#E2B53E}"
			        & ".ar{display:flex;align-items:center;gap:10rem;padding:5rem 0;border-top:1px solid #1E5E49;font-size:12.5rem}"
			        & ".ar.hd{border-top:0;padding:8rem 0 2rem;font-size:8.5rem;letter-spacing:1.2rem;color:#B9D9C9}"
			        & ".nm{flex:1;font-weight:600}.nm small{display:block;font-weight:400;font-size:9.5rem;color:#B9D9C9}"
			        & ".vv{min-width:150rem;text-align:right;font-weight:700;color:#E2B53E}.ch{min-width:78rem;text-align:right;font-weight:700}</style>"
			        & "<div class='x'><div class='h'>WHAT IS INFLATION?</div>"
			        & "<p>How much more everyday goods and services cost than a year earlier. At <b>15%</b>, something that cost ₦1,000 a year ago now costs about ₦1,150. Falling inflation means prices still rise, just more slowly.</p>"
			        & "<div class='h'>WHAT THE CHART SAYS · " & UPPER ( FORMAT ( _first, "mmm yyyy" ) & " TO " & FORMAT ( _last, "mmm yyyy" ) ) & "</div>"
			        & "<p>Inflation averaged <b>" & FORMAT ( _avg, "0.0%" ) & "</b>, peaked at <b>" & FORMAT ( MAXX ( _pk, [@i] ), "0.0%" ) & "</b> in " & FORMAT ( MAXX ( _pk, econ_month[month_date] ), "mmm yyyy" )
			        & " and was <b>" & FORMAT ( _now, "0.0%" ) & "</b> in " & FORMAT ( _last, "mmm yyyy" ) & ".</p>"
			        & "<div class='ar hd'><span class='nm'>EACH PRESIDENT</span><span class='vv'>FOUND → LEFT</span><span class='ch'>CHANGE</span></div>"
			        & _rows & "</div>"
		displayFolder: 05 Visual Helpers\HTML

	measure Naira_explain_html =
			-- "What it means" side of the naira chart (shown by a bookmark): definition, what the chart says,
			-- and the rate each president found and left within the selected years
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( econ_month[month_date] ), "@r", CALCULATE ( [Naira_per_usd] ) ), NOT ISBLANK ( [@r] ) )
			VAR _first = MINX ( _t, econ_month[month_date] )
			VAR _last = MAXX ( _t, econ_month[month_date] )
			VAR _r0 = MAXX ( FILTER ( _t, econ_month[month_date] = _first ), [@r] )
			VAR _r1 = MAXX ( FILTER ( _t, econ_month[month_date] = _last ), [@r] )
			VAR _lost = 1 - DIVIDE ( _r0, _r1 )
			VAR _ad0 = ADDCOLUMNS ( FILTER ( VALUES ( econ_month[president] ), NOT ISBLANK ( econ_month[president] ) ),
			    "@f", CALCULATE ( MIN ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) ),
			    "@l", CALCULATE ( MAX ( econ_month[month_date] ), NOT ISBLANK ( econ_month[naira_per_usd] ) ) )
			VAR _ad = ADDCOLUMNS ( FILTER ( _ad0, NOT ISBLANK ( [@f] ) ),
			    -- Found = the month before their first one (what they inherited); the first month in the data has no earlier month
			    "@a", VAR _f = [@f] RETURN COALESCE ( CALCULATE ( [Naira_per_usd], REMOVEFILTERS ( econ_month ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_month[month_date] = EDATE ( _f, -1 ) ), CALCULATE ( [Naira_per_usd], econ_month[month_date] = _f ) ),
			    "@b", VAR _l = [@l] RETURN CALCULATE ( [Naira_per_usd], econ_month[month_date] = _l ) )
			-- Change in naira per dollar: up = weaker naira = red
			VAR _rows = CONCATENATEX ( _ad,
			    VAR _c = DIVIDE ( [@b] - [@a], [@a] )
			    RETURN
			        "<div class='ar'><span class='nm'>" & econ_month[president] & "<small>" & FORMAT ( [@f], "mmm yyyy" ) & " – " & FORMAT ( [@l], "mmm yyyy" ) & IF ( [@l] = _last, " (latest)", "" ) & "</small></span>"
			            & "<span class='vv'>₦" & FORMAT ( [@a], "#,0" ) & " → ₦" & FORMAT ( [@b], "#,0" ) & "</span>"
			            & "<span class='ch' style='color:" & SWITCH ( TRUE (), ROUND ( _c, 2 ) = 0, "#F0C75E", _c < 0, "#7FD6A8", "#FF8A80" ) & "'>"
			                & SWITCH ( TRUE (), ROUND ( _c, 2 ) = 0, UNICHAR ( 9632 ), _c < 0, UNICHAR ( 9660 ), UNICHAR ( 9650 ) ) & " " & FORMAT ( ABS ( _c ), "0%" ) & "</span></div>",
			    "", [@f], ASC )
			RETURN
			    "<style>html{font-size:calc(100vh / 408)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".x{position:fixed;top:0;left:0;right:0;bottom:0;border-radius:12rem;background:#0B3D2E;color:#fff;padding:44rem 26rem 18rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;animation:fi .45s ease-out}"
			        & "@keyframes fi{from{transform:perspective(1200px) rotateY(-90deg);opacity:.2}to{transform:none;opacity:1}}"
			        & ".h{font-size:9.5rem;letter-spacing:1.8rem;color:#E2B53E;font-weight:700;margin-top:14rem}.h:first-child{margin-top:0}"
			        & ".x p{margin:5rem 0 0;font-size:13rem;line-height:1.45}.x b{color:#E2B53E}"
			        & ".ar{display:flex;align-items:center;gap:10rem;padding:5rem 0;border-top:1px solid #1E5E49;font-size:12.5rem}"
			        & ".ar.hd{border-top:0;padding:8rem 0 2rem;font-size:8.5rem;letter-spacing:1.2rem;color:#B9D9C9}"
			        & ".nm{flex:1;font-weight:600}.nm small{display:block;font-weight:400;font-size:9.5rem;color:#B9D9C9}"
			        & ".vv{min-width:150rem;text-align:right;font-weight:700;color:#E2B53E}.ch{min-width:78rem;text-align:right;font-weight:700}</style>"
			        & "<div class='x'><div class='h'>WHAT DOES NAIRA PER US DOLLAR MEAN?</div>"
			        & "<p>How many naira you need to buy one US dollar. A higher number means a <b>weaker naira</b>.</p>"
			        & "<div class='h'>WHAT THE CHART SAYS · " & UPPER ( FORMAT ( _first, "mmm yyyy" ) & " TO " & FORMAT ( _last, "mmm yyyy" ) ) & "</div>"
			        & "<p>A dollar went from <b>₦" & FORMAT ( _r0, "#,0" ) & "</b> to <b>₦" & FORMAT ( _r1, "#,0" ) & "</b>"
			        & IF ( _lost > 0.005, ": the naira lost <b>" & FORMAT ( _lost, "0%" ) & "</b> of its value against the dollar.", "." ) & "</p>"
			        & "<div class='ar hd'><span class='nm'>EACH PRESIDENT</span><span class='vv'>FOUND → LEFT</span><span class='ch'>NAIRA PER $</span></div>"
			        & _rows & "</div>"
		displayFolder: 05 Visual Helpers\HTML

	measure Inflation_month_tt_html =
			-- Tooltip card for the inflation chart: the hovered month and its change on the month before and a year earlier
			VAR _m = MAX ( econ_month[month_date] )
			VAR _pres = SELECTEDVALUE ( econ_month[president], CALCULATE ( MAX ( econ_month[president] ), econ_month[month_date] = _m ) )
			VAR _na = "<span class='c' style='color:#5E6E67;background:#EDF2EF'>n/a</span>"
			VAR _v = CALCULATE ( [Inflation_yoy], REMOVEFILTERS ( calendar_table ), econ_month[month_date] = _m )
			VAR _v1 = CALCULATE ( [Inflation_yoy], REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_month[month_date] = EDATE ( _m, -1 ) )
			VAR _v12 = CALCULATE ( [Inflation_yoy], REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_month[month_date] = EDATE ( _m, -12 ) )
			VAR _d1 = _v - _v1
			VAR _d12 = _v - _v12
			RETURN
			    "<style>html{font-size:calc(100vh / 140)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;letter-spacing:.5rem}.sub{color:#5E6E67;font-size:9.5rem;margin:2rem 0 6rem}"
			        & ".r{display:flex;justify-content:space-between;align-items:center;gap:10rem;padding:4rem 0;border-top:1px solid #E3E9E6}.r span:first-child{color:#5E6E67}.r b{font-weight:700;font-size:12rem}"
			        & ".c{font-weight:700;font-size:9.5rem;padding:1rem 6rem;border-radius:4rem}</style>"
			        & "<div class='w'><div class='m'>" & UPPER ( FORMAT ( _m, "mmmm yyyy" ) ) & "</div><div class='sub'>" & COALESCE ( _pres, "No president" ) & " · down = green</div>"
			        & "<div class='r'><span>Inflation</span><b>" & FORMAT ( _v, "0.0%" ) & "</b></div>"
			        & "<div class='r'><span>vs " & FORMAT ( EDATE ( _m, -1 ), "mmm yyyy" ) & "</span>" & IF ( ISBLANK ( _v1 ), _na, "<span class='c' style='color:" & IF ( _d1 <= 0, "#0E8A5F", "#C93C3C" ) & ";background:" & IF ( _d1 <= 0, "#E3F4EC", "#FBE7E7" ) & "'>" & IF ( _d1 <= 0, UNICHAR ( 9660 ), UNICHAR ( 9650 ) ) & " " & FORMAT ( ABS ( _d1 ) * 100, "0.0" ) & " pts" & "</span>" ) & "</div>"
			        & "<div class='r'><span>vs " & FORMAT ( EDATE ( _m, -12 ), "mmm yyyy" ) & "</span>" & IF ( ISBLANK ( _v12 ), _na, "<span class='c' style='color:" & IF ( _d12 <= 0, "#0E8A5F", "#C93C3C" ) & ";background:" & IF ( _d12 <= 0, "#E3F4EC", "#FBE7E7" ) & "'>" & IF ( _d12 <= 0, UNICHAR ( 9660 ), UNICHAR ( 9650 ) ) & " " & FORMAT ( ABS ( _d12 ) * 100, "0.0" ) & " pts" & "</span>" ) & "</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure Naira_month_tt_html =
			-- Tooltip card for the naira per US dollar chart: the hovered month and its change on the month before and a year earlier
			VAR _m = MAX ( econ_month[month_date] )
			VAR _pres = SELECTEDVALUE ( econ_month[president], CALCULATE ( MAX ( econ_month[president] ), econ_month[month_date] = _m ) )
			VAR _na = "<span class='c' style='color:#5E6E67;background:#EDF2EF'>n/a</span>"
			VAR _v = CALCULATE ( [Naira_per_usd], REMOVEFILTERS ( calendar_table ), econ_month[month_date] = _m )
			VAR _v1 = CALCULATE ( [Naira_per_usd], REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_month[month_date] = EDATE ( _m, -1 ) )
			VAR _v12 = CALCULATE ( [Naira_per_usd], REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_month[month_date] = EDATE ( _m, -12 ) )
			VAR _d1 = DIVIDE ( _v - _v1, _v1 )
			VAR _d12 = DIVIDE ( _v - _v12, _v12 )
			RETURN
			    "<style>html{font-size:calc(100vh / 140)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;letter-spacing:.5rem}.sub{color:#5E6E67;font-size:9.5rem;margin:2rem 0 6rem}"
			        & ".r{display:flex;justify-content:space-between;align-items:center;gap:10rem;padding:4rem 0;border-top:1px solid #E3E9E6}.r span:first-child{color:#5E6E67}.r b{font-weight:700;font-size:12rem}"
			        & ".c{font-weight:700;font-size:9.5rem;padding:1rem 6rem;border-radius:4rem}</style>"
			        & "<div class='w'><div class='m'>" & UPPER ( FORMAT ( _m, "mmmm yyyy" ) ) & "</div><div class='sub'>" & COALESCE ( _pres, "No president" ) & " · weaker naira = red</div>"
			        & "<div class='r'><span>Naira per US dollar</span><b>" & "₦" & FORMAT ( _v, "#,0" ) & "</b></div>"
			        & "<div class='r'><span>vs " & FORMAT ( EDATE ( _m, -1 ), "mmm yyyy" ) & "</span>" & IF ( ISBLANK ( _v1 ), _na, "<span class='c' style='color:" & IF ( _d1 <= 0, "#0E8A5F", "#C93C3C" ) & ";background:" & IF ( _d1 <= 0, "#E3F4EC", "#FBE7E7" ) & "'>" & IF ( _d1 <= 0, UNICHAR ( 9660 ), UNICHAR ( 9650 ) ) & " " & FORMAT ( ABS ( _d1 ), "0.0%" ) & "</span>" ) & "</div>"
			        & "<div class='r'><span>vs " & FORMAT ( EDATE ( _m, -12 ), "mmm yyyy" ) & "</span>" & IF ( ISBLANK ( _v12 ), _na, "<span class='c' style='color:" & IF ( _d12 <= 0, "#0E8A5F", "#C93C3C" ) & ";background:" & IF ( _d12 <= 0, "#E3F4EC", "#FBE7E7" ) & "'>" & IF ( _d12 <= 0, UNICHAR ( 9660 ), UNICHAR ( 9650 ) ) & " " & FORMAT ( ABS ( _d12 ), "0.0%" ) & "</span>" ) & "</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure President_colour =
			-- Column colour per year: the president in office (same colours as the monthly lines); before 1999 light grey
			SWITCH ( CALCULATE ( MAX ( econ_year[president] ) ),
			    "Obasanjo", "#7F8C86", "Yar'Adua", "#B9D9C9", "Jonathan", "#8FC9AE", "Buhari", "#4E9C78", "Tinubu", "#0E6B45",
			    "#D5DDD9" )
		displayFolder: 04 Comparison\Colours

	measure President_legend_html =
			-- Legend for the president-coloured columns: only the presidents in the selected years
			VAR _p = ADDCOLUMNS ( VALUES ( econ_year[president] ), "@f", CALCULATE ( MIN ( econ_year[year] ) ) )
			RETURN
			    "<style>html{font-size:calc(100vh / 20)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".l{position:fixed;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;gap:12rem;font-family:Segoe UI,sans-serif;font-size:9.5rem;color:#5E6E67;white-space:nowrap}"
			        & ".l i{display:inline-block;width:9rem;height:9rem;border-radius:2rem;margin-right:4rem;vertical-align:-1rem}</style><div class='l'>"
			        & CONCATENATEX ( _p,
			            VAR _n = COALESCE ( econ_year[president], "Before 1999" )
			            RETURN "<span><i style='background:" & SWITCH ( _n, "Obasanjo", "#7F8C86", "Yar'Adua", "#B9D9C9", "Jonathan", "#8FC9AE", "Buhari", "#4E9C78", "Tinubu", "#0E6B45", "#D5DDD9" ) & "'></i>" & _n & "</span>",
			            "", [@f], ASC )
			        & "</div>"
		displayFolder: 05 Visual Helpers\HTML

	measure Population_growth =
			-- Population change vs the year before. Over several years: the average yearly rate
			AVERAGEX ( VALUES ( econ_year[year] ),
			    VAR _y = econ_year[year]
			    VAR _p = CALCULATE ( SUM ( econ_year[population] ) )
			    VAR _p0 = CALCULATE ( SUM ( econ_year[population] ), REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _y - 1 )
			    RETURN DIVIDE ( _p - _p0, _p0 ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Rates & Averages\Economy

	measure GdpNaira_explain_html =
			-- "What it means" side of the GDP in naira chart (shown by a bookmark): definition, what the chart says,
			-- and each president's first and last year within the selected years
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( econ_year[year] ), "@v", CALCULATE ( [GDP_naira] ) ), NOT ISBLANK ( [@v] ) )
			VAR _first = MINX ( _t, econ_year[year] )
			VAR _last = MAXX ( _t, econ_year[year] )
			VAR _v0 = MAXX ( FILTER ( _t, econ_year[year] = _first ), [@v] )
			VAR _v1 = MAXX ( FILTER ( _t, econ_year[year] = _last ), [@v] )
			VAR _pk = TOPN ( 1, _t, [@v], DESC )
			VAR _pky = MAXX ( _pk, econ_year[year] )
			VAR _pkv = MAXX ( _pk, [@v] )
			VAR _ad0 = ADDCOLUMNS ( VALUES ( econ_year[president] ),
			    "@f", CALCULATE ( MIN ( econ_year[year] ), NOT ISBLANK ( econ_year[gdp_naira] ) ),
			    "@l", CALCULATE ( MAX ( econ_year[year] ), NOT ISBLANK ( econ_year[gdp_naira] ) ) )
			VAR _ad = ADDCOLUMNS ( FILTER ( _ad0, NOT ISBLANK ( [@f] ) ),
			    -- Found = the year before their first one (what they inherited); the first year in the data has no earlier year
			    "@a", VAR _f = [@f] RETURN COALESCE ( CALCULATE ( [GDP_naira], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _f - 1 ), CALCULATE ( [GDP_naira], econ_year[year] = _f ) ),
			    "@b", VAR _l = [@l] RETURN CALCULATE ( [GDP_naira], econ_year[year] = _l ) )
			VAR _rows = CONCATENATEX ( _ad,
			    VAR _c = DIVIDE ( [@b] - [@a], [@a] )
			    RETURN
			        "<div class='ar'><span class='nm'>" & COALESCE ( econ_year[president], "Before 1999" ) & "<small>" & IF ( [@f] = [@l], FORMAT ( [@f], "0" ), [@f] & "–" & [@l] ) & IF ( [@l] = _last, " (latest)", "" ) & "</small></span>"
			            & "<span class='vv'>" & ( "₦" & IF ( [@a] >= 1e13, FORMAT ( [@a] / 1e12, "#,0" ), FORMAT ( [@a] / 1e12, "#,0.0" ) ) & "tn" ) & " → " & ( "₦" & IF ( [@b] >= 1e13, FORMAT ( [@b] / 1e12, "#,0" ), FORMAT ( [@b] / 1e12, "#,0.0" ) ) & "tn" ) & "</span>"
			            & "<span class='ch' style='color:" & SWITCH ( TRUE (), ROUND ( _c, 2 ) = 0, "#F0C75E", _c > 0, "#7FD6A8", "#FF8A80" ) & "'>"
			            & SWITCH ( TRUE (), ROUND ( _c, 2 ) = 0, UNICHAR ( 9632 ), _c > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _c ), "0%" ) & "</span></div>",
			    "", [@f], ASC )
			VAR _say = IF ( _first = _last, "GDP was <b>" & ( "₦" & IF ( _v1 >= 1e13, FORMAT ( _v1 / 1e12, "#,0" ), FORMAT ( _v1 / 1e12, "#,0.0" ) ) & "tn" ) & "</b> in " & _last & ".",
			    "GDP grew from <b>" & ( "₦" & IF ( _v0 >= 1e13, FORMAT ( _v0 / 1e12, "#,0" ), FORMAT ( _v0 / 1e12, "#,0.0" ) ) & "tn" ) & "</b> in " & _first & " to <b>" & ( "₦" & IF ( _v1 >= 1e13, FORMAT ( _v1 / 1e12, "#,0" ), FORMAT ( _v1 / 1e12, "#,0.0" ) ) & "tn" ) & "</b> in " & _last & ", " & FORMAT ( DIVIDE ( _v1, _v0 ), IF ( DIVIDE ( _v1, _v0 ) >= 10, "#,0", "#,0.0" ) ) & "× bigger. "
			        & "Most of that is rising prices. With them removed, the yearly growth in the growth chart (" & _first & " to " & _last & ") adds up to about <b>" & FORMAT ( PRODUCTX ( FILTER ( ADDCOLUMNS ( VALUES ( econ_year[year] ), "@g", CALCULATE ( [Real_GDP_growth] ) ), NOT ISBLANK ( [@g] ) ), 1 + [@g] ) - 1, "0%" ) & " more output</b>." )
			RETURN
			    "<style>html{font-size:calc(100vh / 252)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".x{position:fixed;top:0;left:0;right:0;bottom:0;border-radius:12rem;background:#0B3D2E;color:#fff;padding:40rem 18rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;display:flex;gap:18rem;animation:fi .45s ease-out}"
			        & "@keyframes fi{from{transform:perspective(1200px) rotateY(-90deg);opacity:.2}to{transform:none;opacity:1}}"
			        & ".c1{flex:1.1}.c2{flex:1}"
			        & ".h{font-size:8rem;letter-spacing:1.5rem;color:#E2B53E;font-weight:700;margin-top:9rem}.h:first-child{margin-top:0}"
			        & ".x p{margin:3rem 0 0;font-size:10.5rem;line-height:1.4}.x b{color:#E2B53E}"
			        & ".ar{display:flex;align-items:center;gap:6rem;padding:3rem 0;border-top:1px solid #1E5E49;font-size:10rem}"
			        & ".ar.hd{border-top:0;padding:0 0 2rem;font-size:7.5rem;letter-spacing:1.1rem;color:#B9D9C9}"
			        & ".nm{flex:1;font-weight:600}.nm small{display:block;font-weight:400;font-size:8rem;color:#B9D9C9}"
			        & ".vv{text-align:right;font-weight:700;color:#E2B53E;white-space:nowrap}.ch{min-width:44rem;text-align:right;font-weight:700}</style>"
			        & "<div class='x'><div class='c1'><div class='h'>WHAT IS GDP?</div><p>Gross domestic product: the total value of everything Nigeria produces in a year. In naira it rises partly because prices rise, so a bigger number doesn't always mean more was produced.</p>"
			        & "<div class='h'>WHAT THE CHART SAYS · " & IF ( _first = _last, _last, _first & " TO " & _last ) & "</div><p>" & _say & "</p></div>"
			        & "<div class='c2'><div class='ar hd'><span class='nm'>EACH PRESIDENT</span><span class='vv'>FOUND → LEFT</span><span class='ch'>CHANGE</span></div>" & _rows & "</div></div>"
		displayFolder: 05 Visual Helpers\HTML

	measure GdpUsd_explain_html =
			-- "What it means" side of the GDP in US dollars chart (shown by a bookmark): definition, what the chart says,
			-- and each president's first and last year within the selected years
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( econ_year[year] ), "@v", CALCULATE ( [GDP_usd] ) ), NOT ISBLANK ( [@v] ) )
			VAR _first = MINX ( _t, econ_year[year] )
			VAR _last = MAXX ( _t, econ_year[year] )
			VAR _v0 = MAXX ( FILTER ( _t, econ_year[year] = _first ), [@v] )
			VAR _v1 = MAXX ( FILTER ( _t, econ_year[year] = _last ), [@v] )
			VAR _pk = TOPN ( 1, _t, [@v], DESC )
			VAR _pky = MAXX ( _pk, econ_year[year] )
			VAR _pkv = MAXX ( _pk, [@v] )
			VAR _ad0 = ADDCOLUMNS ( VALUES ( econ_year[president] ),
			    "@f", CALCULATE ( MIN ( econ_year[year] ), NOT ISBLANK ( econ_year[gdp_usd] ) ),
			    "@l", CALCULATE ( MAX ( econ_year[year] ), NOT ISBLANK ( econ_year[gdp_usd] ) ) )
			VAR _ad = ADDCOLUMNS ( FILTER ( _ad0, NOT ISBLANK ( [@f] ) ),
			    -- Found = the year before their first one (what they inherited); the first year in the data has no earlier year
			    "@a", VAR _f = [@f] RETURN COALESCE ( CALCULATE ( [GDP_usd], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _f - 1 ), CALCULATE ( [GDP_usd], econ_year[year] = _f ) ),
			    "@b", VAR _l = [@l] RETURN CALCULATE ( [GDP_usd], econ_year[year] = _l ) )
			VAR _rows = CONCATENATEX ( _ad,
			    VAR _c = DIVIDE ( [@b] - [@a], [@a] )
			    RETURN
			        "<div class='ar'><span class='nm'>" & COALESCE ( econ_year[president], "Before 1999" ) & "<small>" & IF ( [@f] = [@l], FORMAT ( [@f], "0" ), [@f] & "–" & [@l] ) & IF ( [@l] = _last, " (latest)", "" ) & "</small></span>"
			            & "<span class='vv'>" & ( "$" & FORMAT ( [@a] / 1e9, "#,0" ) & "bn" ) & " → " & ( "$" & FORMAT ( [@b] / 1e9, "#,0" ) & "bn" ) & "</span>"
			            & "<span class='ch' style='color:" & SWITCH ( TRUE (), ROUND ( _c, 2 ) = 0, "#F0C75E", _c > 0, "#7FD6A8", "#FF8A80" ) & "'>"
			            & SWITCH ( TRUE (), ROUND ( _c, 2 ) = 0, UNICHAR ( 9632 ), _c > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _c ), "0%" ) & "</span></div>",
			    "", [@f], ASC )
			VAR _say = VAR _r1 = CALCULATE ( AVERAGE ( econ_year[avg_naira_per_usd] ), econ_year[year] = _last )
			    VAR _r0 = CALCULATE ( AVERAGE ( econ_year[avg_naira_per_usd] ), econ_year[year] = _pky )
			    RETURN
			        IF ( _pky = _last, "GDP in dollars was at its highest in " & _last & ": <b>" & ( "$" & FORMAT ( _v1 / 1e9, "#,0" ) & "bn" ) & "</b>.",
			            "GDP in dollars peaked at <b>" & ( "$" & FORMAT ( _pkv / 1e9, "#,0" ) & "bn" ) & "</b> in " & _pky & ". In " & _last & " it was <b>" & ( "$" & FORMAT ( _v1 / 1e9, "#,0" ) & "bn" ) & "</b>, "
			                & FORMAT ( 1 - DIVIDE ( _v1, _pkv ), "0%" ) & " lower" & IF ( _r1 > _r0 * 1.2, ", mainly because a dollar cost ₦" & FORMAT ( _r1, "#,0" ) & " instead of ₦" & FORMAT ( _r0, "#,0" ), "" ) & "." )
			RETURN
			    "<style>html{font-size:calc(100vh / 252)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".x{position:fixed;top:0;left:0;right:0;bottom:0;border-radius:12rem;background:#0B3D2E;color:#fff;padding:40rem 18rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;display:flex;gap:18rem;animation:fi .45s ease-out}"
			        & "@keyframes fi{from{transform:perspective(1200px) rotateY(-90deg);opacity:.2}to{transform:none;opacity:1}}"
			        & ".c1{flex:1.1}.c2{flex:1}"
			        & ".h{font-size:8rem;letter-spacing:1.5rem;color:#E2B53E;font-weight:700;margin-top:9rem}.h:first-child{margin-top:0}"
			        & ".x p{margin:3rem 0 0;font-size:10.5rem;line-height:1.4}.x b{color:#E2B53E}"
			        & ".ar{display:flex;align-items:center;gap:6rem;padding:3rem 0;border-top:1px solid #1E5E49;font-size:10rem}"
			        & ".ar.hd{border-top:0;padding:0 0 2rem;font-size:7.5rem;letter-spacing:1.1rem;color:#B9D9C9}"
			        & ".nm{flex:1;font-weight:600}.nm small{display:block;font-weight:400;font-size:8rem;color:#B9D9C9}"
			        & ".vv{text-align:right;font-weight:700;color:#E2B53E;white-space:nowrap}.ch{min-width:44rem;text-align:right;font-weight:700}</style>"
			        & "<div class='x'><div class='c1'><div class='h'>WHY SHOW IT IN US DOLLARS?</div><p>Converting GDP to US dollars lets you compare Nigeria with other countries. It falls when the naira loses value, even if Nigerians produce more.</p>"
			        & "<div class='h'>WHAT THE CHART SAYS · " & IF ( _first = _last, _last, _first & " TO " & _last ) & "</div><p>" & _say & "</p></div>"
			        & "<div class='c2'><div class='ar hd'><span class='nm'>EACH PRESIDENT</span><span class='vv'>FOUND → LEFT</span><span class='ch'>CHANGE</span></div>" & _rows & "</div></div>"
		displayFolder: 05 Visual Helpers\HTML

	measure Growth_explain_html =
			-- "What it means" side of the real GDP growth chart (shown by a bookmark): definition, what the chart says,
			-- and each president's first and last year within the selected years
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( econ_year[year] ), "@v", CALCULATE ( [Real_GDP_growth] ) ), NOT ISBLANK ( [@v] ) )
			VAR _first = MINX ( _t, econ_year[year] )
			VAR _last = MAXX ( _t, econ_year[year] )
			VAR _v0 = MAXX ( FILTER ( _t, econ_year[year] = _first ), [@v] )
			VAR _v1 = MAXX ( FILTER ( _t, econ_year[year] = _last ), [@v] )
			VAR _pk = TOPN ( 1, _t, [@v], DESC )
			VAR _pky = MAXX ( _pk, econ_year[year] )
			VAR _pkv = MAXX ( _pk, [@v] )
			VAR _ad0 = ADDCOLUMNS ( VALUES ( econ_year[president] ),
			    "@f", CALCULATE ( MIN ( econ_year[year] ), NOT ISBLANK ( econ_year[real_gdp_growth] ) ),
			    "@l", CALCULATE ( MAX ( econ_year[year] ), NOT ISBLANK ( econ_year[real_gdp_growth] ) ) )
			VAR _ad = ADDCOLUMNS ( FILTER ( _ad0, NOT ISBLANK ( [@f] ) ),
			    -- Found = the year before their first one (what they inherited); the first year in the data has no earlier year
			    "@a", VAR _f = [@f] RETURN COALESCE ( CALCULATE ( [Real_GDP_growth], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _f - 1 ), CALCULATE ( [Real_GDP_growth], econ_year[year] = _f ) ),
			    "@b", VAR _l = [@l] RETURN CALCULATE ( [Real_GDP_growth], econ_year[year] = _l ) )
			VAR _rows = CONCATENATEX ( _ad,
			    -- A term's years are consecutive, so its years in the selection are first..last
			    VAR _yrs = FILTER ( _t, econ_year[year] >= [@f] && econ_year[year] <= [@l] )
			    VAR _avg = AVERAGEX ( _yrs, [@v] )
			    VAR _sh = COUNTROWS ( FILTER ( _yrs, [@v] < 0 ) )
			    RETURN
			        "<div class='ar'><span class='nm'>" & COALESCE ( econ_year[president], "Before 1999" ) & "<small>" & IF ( [@f] = [@l], FORMAT ( [@f], "0" ), [@f] & "–" & [@l] ) & IF ( [@l] = _last, " (latest)", "" ) & "</small></span>"
			            & "<span class='vv'>" & FORMAT ( _avg, "0.0%" ) & " a year</span>"
			            & "<span class='ch' style='color:" & IF ( _sh > 0, "#FF8A80", "#7FD6A8" ) & "'>" & IF ( _sh > 0, _sh & " shrank", "none" ) & "</span></div>",
			    "", [@f], ASC )
			VAR _say = VAR _sh = FILTER ( _t, [@v] < 0 )
			    VAR _below = COUNTROWS ( FILTER ( _t, [@v] < CALCULATE ( [Population_growth] ) ) )
			    RETURN
			        "Average growth was <b>" & FORMAT ( AVERAGEX ( _t, [@v] ), "0.0%" ) & "</b> a year. The economy shrank in <b>" & COUNTROWS ( _sh ) + 0 & " of " & COUNTROWS ( _t ) & "</b> years"
			            & IF ( COUNTROWS ( _sh ) > 0, " (" & CONCATENATEX ( _sh, econ_year[year], ", ", econ_year[year], ASC ) & ")", "" )
			            & " and grew slower than the population in <b>" & _below + 0 & "</b>."
			RETURN
			    "<style>html{font-size:calc(100vh / 252)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".x{position:fixed;top:0;left:0;right:0;bottom:0;border-radius:12rem;background:#0B3D2E;color:#fff;padding:40rem 18rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;display:flex;gap:18rem;animation:fi .45s ease-out}"
			        & "@keyframes fi{from{transform:perspective(1200px) rotateY(-90deg);opacity:.2}to{transform:none;opacity:1}}"
			        & ".c1{flex:1.1}.c2{flex:1}"
			        & ".h{font-size:8rem;letter-spacing:1.5rem;color:#E2B53E;font-weight:700;margin-top:9rem}.h:first-child{margin-top:0}"
			        & ".x p{margin:3rem 0 0;font-size:10.5rem;line-height:1.4}.x b{color:#E2B53E}"
			        & ".ar{display:flex;align-items:center;gap:6rem;padding:3rem 0;border-top:1px solid #1E5E49;font-size:10rem}"
			        & ".ar.hd{border-top:0;padding:0 0 2rem;font-size:7.5rem;letter-spacing:1.1rem;color:#B9D9C9}"
			        & ".nm{flex:1;font-weight:600}.nm small{display:block;font-weight:400;font-size:8rem;color:#B9D9C9}"
			        & ".vv{text-align:right;font-weight:700;color:#E2B53E;white-space:nowrap}.ch{min-width:44rem;text-align:right;font-weight:700}</style>"
			        & "<div class='x'><div class='c1'><div class='h'>WHAT IS REAL GDP GROWTH?</div><p>How much more the economy produced than the year before, with price rises taken out. Below 0 the economy shrank (a recession). The dashed line is population growth: below it, the average Nigerian's share shrank.</p>"
			        & "<div class='h'>WHAT THE CHART SAYS · " & IF ( _first = _last, _last, _first & " TO " & _last ) & "</div><p>" & _say & "</p></div>"
			        & "<div class='c2'><div class='ar hd'><span class='nm'>EACH PRESIDENT</span><span class='vv'>AVERAGE</span><span class='ch'>SHRANK</span></div>" & _rows & "</div></div>"
		displayFolder: 05 Visual Helpers\HTML

	measure PerPerson_explain_html =
			-- "What it means" side of the GDP per person chart (shown by a bookmark): definition, what the chart says,
			-- and each president's first and last year within the selected years
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( econ_year[year] ), "@v", CALCULATE ( [GDP_per_person_usd] ) ), NOT ISBLANK ( [@v] ) )
			VAR _first = MINX ( _t, econ_year[year] )
			VAR _last = MAXX ( _t, econ_year[year] )
			VAR _v0 = MAXX ( FILTER ( _t, econ_year[year] = _first ), [@v] )
			VAR _v1 = MAXX ( FILTER ( _t, econ_year[year] = _last ), [@v] )
			VAR _pk = TOPN ( 1, _t, [@v], DESC )
			VAR _pky = MAXX ( _pk, econ_year[year] )
			VAR _pkv = MAXX ( _pk, [@v] )
			VAR _ad0 = ADDCOLUMNS ( VALUES ( econ_year[president] ),
			    "@f", CALCULATE ( MIN ( econ_year[year] ), NOT ISBLANK ( econ_year[gdp_usd] ) ),
			    "@l", CALCULATE ( MAX ( econ_year[year] ), NOT ISBLANK ( econ_year[gdp_usd] ) ) )
			VAR _ad = ADDCOLUMNS ( FILTER ( _ad0, NOT ISBLANK ( [@f] ) ),
			    -- Found = the year before their first one (what they inherited); the first year in the data has no earlier year
			    "@a", VAR _f = [@f] RETURN COALESCE ( CALCULATE ( [GDP_per_person_usd], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _f - 1 ), CALCULATE ( [GDP_per_person_usd], econ_year[year] = _f ) ),
			    "@b", VAR _l = [@l] RETURN CALCULATE ( [GDP_per_person_usd], econ_year[year] = _l ) )
			VAR _rows = CONCATENATEX ( _ad,
			    VAR _c = DIVIDE ( [@b] - [@a], [@a] )
			    RETURN
			        "<div class='ar'><span class='nm'>" & COALESCE ( econ_year[president], "Before 1999" ) & "<small>" & IF ( [@f] = [@l], FORMAT ( [@f], "0" ), [@f] & "–" & [@l] ) & IF ( [@l] = _last, " (latest)", "" ) & "</small></span>"
			            & "<span class='vv'>" & ( "$" & FORMAT ( [@a], "#,0" ) ) & " → " & ( "$" & FORMAT ( [@b], "#,0" ) ) & "</span>"
			            & "<span class='ch' style='color:" & SWITCH ( TRUE (), ROUND ( _c, 2 ) = 0, "#F0C75E", _c > 0, "#7FD6A8", "#FF8A80" ) & "'>"
			            & SWITCH ( TRUE (), ROUND ( _c, 2 ) = 0, UNICHAR ( 9632 ), _c > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _c ), "0%" ) & "</span></div>",
			    "", [@f], ASC )
			VAR _say = VAR _n1 = CALCULATE ( [GDP_per_person_naira], econ_year[year] = _last )
			    RETURN
			        IF ( _pky = _last, "At <b>" & ( "$" & FORMAT ( _v1, "#,0" ) ) & "</b> (₦" & FORMAT ( _n1 / 1e6, "0.00" ) & "m), " & _last & " was the highest in the selected years.",
			            "It was <b>" & ( "$" & FORMAT ( _v1, "#,0" ) ) & "</b> in " & _last & " (₦" & FORMAT ( _n1 / 1e6, "0.00" ) & "m), <b>" & FORMAT ( 1 - DIVIDE ( _v1, _pkv ), "0%" ) & " below</b> its " & _pky & " peak of " & ( "$" & FORMAT ( _pkv, "#,0" ) ) & "." )
			RETURN
			    "<style>html{font-size:calc(100vh / 252)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".x{position:fixed;top:0;left:0;right:0;bottom:0;border-radius:12rem;background:#0B3D2E;color:#fff;padding:40rem 18rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;display:flex;gap:18rem;animation:fi .45s ease-out}"
			        & "@keyframes fi{from{transform:perspective(1200px) rotateY(-90deg);opacity:.2}to{transform:none;opacity:1}}"
			        & ".c1{flex:1.1}.c2{flex:1}"
			        & ".h{font-size:8rem;letter-spacing:1.5rem;color:#E2B53E;font-weight:700;margin-top:9rem}.h:first-child{margin-top:0}"
			        & ".x p{margin:3rem 0 0;font-size:10.5rem;line-height:1.4}.x b{color:#E2B53E}"
			        & ".ar{display:flex;align-items:center;gap:6rem;padding:3rem 0;border-top:1px solid #1E5E49;font-size:10rem}"
			        & ".ar.hd{border-top:0;padding:0 0 2rem;font-size:7.5rem;letter-spacing:1.1rem;color:#B9D9C9}"
			        & ".nm{flex:1;font-weight:600}.nm small{display:block;font-weight:400;font-size:8rem;color:#B9D9C9}"
			        & ".vv{text-align:right;font-weight:700;color:#E2B53E;white-space:nowrap}.ch{min-width:44rem;text-align:right;font-weight:700}</style>"
			        & "<div class='x'><div class='c1'><div class='h'>WHAT IS GDP PER PERSON?</div><p>GDP divided by the number of people: a rough measure of the average Nigerian's share of what the country produces, not what any one person earns.</p>"
			        & "<div class='h'>WHAT THE CHART SAYS · " & IF ( _first = _last, _last, _first & " TO " & _last ) & "</div><p>" & _say & "</p></div>"
			        & "<div class='c2'><div class='ar hd'><span class='nm'>EACH PRESIDENT</span><span class='vv'>FOUND → LEFT</span><span class='ch'>CHANGE</span></div>" & _rows & "</div></div>"
		displayFolder: 05 Visual Helpers\HTML

	measure GdpNaira_year_tt_html =
			-- Tooltip card for the GDP in naira chart: the hovered year, its president, the value and the change on the year before
			VAR _y = MAX ( econ_year[year] )
			VAR _pres = CALCULATE ( MAX ( econ_year[president] ) )
			VAR _v = [GDP_naira]
			VAR _p = CALCULATE ( [GDP_naira], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _y - 1 )
			VAR _d = DIVIDE ( _v - _p, _p )
			VAR _flat = ROUND ( _d, 3 ) = 0
			VAR _chip = IF ( ISBLANK ( _p ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>n/a</span>",
			    "<span class='c' style='color:" & SWITCH ( TRUE (), _flat, "#C98A00", _d > 0, "#0E8A5F", "#C93C3C" ) & ";background:" & SWITCH ( TRUE (), _flat, "#FBF1DC", _d > 0, "#E3F4EC", "#FBE7E7" ) & "'>"
			        & SWITCH ( TRUE (), _flat, UNICHAR ( 9632 ), _d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _d ), "0.0%" ) & "</span>" )
			RETURN
			    "<style>html{font-size:calc(100vh / 140)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;letter-spacing:.5rem}.sub{color:#5E6E67;font-size:9.5rem;margin:2rem 0 6rem}.sub i{display:inline-block;width:8rem;height:8rem;border-radius:2rem;margin-right:4rem}"
			        & ".r{display:flex;justify-content:space-between;align-items:center;gap:10rem;padding:4rem 0;border-top:1px solid #E3E9E6}.r span:first-child{color:#5E6E67}.r b{font-weight:700;font-size:12rem}"
			        & ".c{font-weight:700;font-size:9.5rem;padding:1rem 6rem;border-radius:4rem}</style>"
			        & "<div class='w'><div class='m'>" & _y & "</div><div class='sub'><i style='background:" & [President_colour] & "'></i>" & COALESCE ( _pres, "Before 1999 (no elected president)" ) & "</div>"
			        & "<div class='r'><span>GDP in naira</span><b>" & ( "₦" & IF ( _v >= 1e13, FORMAT ( _v / 1e12, "#,0" ), FORMAT ( _v / 1e12, "#,0.0" ) ) & "tn" ) & "</b></div>"
			        & "<div class='r'><span>In US dollars</span><b>" & ( "$" & FORMAT ( [GDP_usd] / 1e9, "#,0" ) & "bn" ) & "</b></div>"
			        & "<div class='r'><span>vs " & ( _y - 1 ) & "</span>" & _chip & "</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure GdpUsd_year_tt_html =
			-- Tooltip card for the GDP in US dollars chart: the hovered year, its president, the value and the change on the year before
			VAR _y = MAX ( econ_year[year] )
			VAR _pres = CALCULATE ( MAX ( econ_year[president] ) )
			VAR _v = [GDP_usd]
			VAR _p = CALCULATE ( [GDP_usd], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _y - 1 )
			VAR _d = DIVIDE ( _v - _p, _p )
			VAR _flat = ROUND ( _d, 3 ) = 0
			VAR _chip = IF ( ISBLANK ( _p ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>n/a</span>",
			    "<span class='c' style='color:" & SWITCH ( TRUE (), _flat, "#C98A00", _d > 0, "#0E8A5F", "#C93C3C" ) & ";background:" & SWITCH ( TRUE (), _flat, "#FBF1DC", _d > 0, "#E3F4EC", "#FBE7E7" ) & "'>"
			        & SWITCH ( TRUE (), _flat, UNICHAR ( 9632 ), _d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _d ), "0.0%" ) & "</span>" )
			RETURN
			    "<style>html{font-size:calc(100vh / 140)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;letter-spacing:.5rem}.sub{color:#5E6E67;font-size:9.5rem;margin:2rem 0 6rem}.sub i{display:inline-block;width:8rem;height:8rem;border-radius:2rem;margin-right:4rem}"
			        & ".r{display:flex;justify-content:space-between;align-items:center;gap:10rem;padding:4rem 0;border-top:1px solid #E3E9E6}.r span:first-child{color:#5E6E67}.r b{font-weight:700;font-size:12rem}"
			        & ".c{font-weight:700;font-size:9.5rem;padding:1rem 6rem;border-radius:4rem}</style>"
			        & "<div class='w'><div class='m'>" & _y & "</div><div class='sub'><i style='background:" & [President_colour] & "'></i>" & COALESCE ( _pres, "Before 1999 (no elected president)" ) & "</div>"
			        & "<div class='r'><span>GDP in US dollars</span><b>" & ( "$" & FORMAT ( _v / 1e9, "#,0" ) & "bn" ) & "</b></div>"
			        & "<div class='r'><span>Naira per US dollar</span><b>" & "₦" & FORMAT ( AVERAGE ( econ_year[avg_naira_per_usd] ), "#,0" ) & "</b></div>"
			        & "<div class='r'><span>vs " & ( _y - 1 ) & "</span>" & _chip & "</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure Growth_year_tt_html =
			-- Tooltip card for the real GDP growth chart: the hovered year, its president, growth (red only below 0)
			-- and its pace against the year before
			VAR _y = MAX ( econ_year[year] )
			VAR _pres = CALCULATE ( MAX ( econ_year[president] ) )
			VAR _v = [Real_GDP_growth]
			VAR _p = CALCULATE ( [Real_GDP_growth], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _y - 1 )
			VAR _d = _v - _p
			VAR _flat = ROUND ( _d, 3 ) = 0
			VAR _chip = IF ( ISBLANK ( _p ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>n/a</span>",
			    "<span class='c' style='color:" & SWITCH ( TRUE (), _flat || _d < 0, "#C98A00", "#0E8A5F" ) & ";background:" & SWITCH ( TRUE (), _flat || _d < 0, "#FBF1DC", "#E3F4EC" ) & "'>"
			        & IF ( _flat, "same pace", FORMAT ( ABS ( _d ) * 100, "0.0" ) & " pts " & IF ( _d < 0, "slower", "faster" ) ) & "</span>" )
			RETURN
			    "<style>html{font-size:calc(100vh / 140)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;letter-spacing:.5rem}.sub{color:#5E6E67;font-size:9.5rem;margin:2rem 0 6rem}.sub i{display:inline-block;width:8rem;height:8rem;border-radius:2rem;margin-right:4rem}"
			        & ".r{display:flex;justify-content:space-between;align-items:center;gap:10rem;padding:4rem 0;border-top:1px solid #E3E9E6}.r span:first-child{color:#5E6E67}.r b{font-weight:700;font-size:12rem}"
			        & ".c{font-weight:700;font-size:9.5rem;padding:1rem 6rem;border-radius:4rem}</style>"
			        & "<div class='w'><div class='m'>" & _y & "</div><div class='sub'><i style='background:" & [President_colour] & "'></i>" & COALESCE ( _pres, "Before 1999 (no elected president)" ) & "</div>"
			        & "<div class='r'><span>Real GDP growth</span><b style='color:" & IF ( _v < 0, "#C93C3C", "#14231D" ) & "'>" & FORMAT ( _v, "0.0%" ) & "</b></div>"
			        & "<div class='r'><span>Population growth</span><b>" & FORMAT ( [Population_growth], "0.0%" ) & "</b></div>"
			        & "<div class='r'><span>vs " & ( _y - 1 ) & "'s " & FORMAT ( _p, "0.0%" ) & "</span>" & _chip & "</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure PerPerson_year_tt_html =
			-- Tooltip card for the GDP per person chart: the hovered year, its president, the value and the change on the year before
			VAR _y = MAX ( econ_year[year] )
			VAR _pres = CALCULATE ( MAX ( econ_year[president] ) )
			VAR _v = [GDP_per_person_usd]
			VAR _p = CALCULATE ( [GDP_per_person_usd], REMOVEFILTERS ( econ_year ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), econ_year[year] = _y - 1 )
			VAR _d = DIVIDE ( _v - _p, _p )
			VAR _flat = ROUND ( _d, 3 ) = 0
			VAR _chip = IF ( ISBLANK ( _p ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>n/a</span>",
			    "<span class='c' style='color:" & SWITCH ( TRUE (), _flat, "#C98A00", _d > 0, "#0E8A5F", "#C93C3C" ) & ";background:" & SWITCH ( TRUE (), _flat, "#FBF1DC", _d > 0, "#E3F4EC", "#FBE7E7" ) & "'>"
			        & SWITCH ( TRUE (), _flat, UNICHAR ( 9632 ), _d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _d ), "0.0%" ) & "</span>" )
			RETURN
			    "<style>html{font-size:calc(100vh / 140)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;letter-spacing:.5rem}.sub{color:#5E6E67;font-size:9.5rem;margin:2rem 0 6rem}.sub i{display:inline-block;width:8rem;height:8rem;border-radius:2rem;margin-right:4rem}"
			        & ".r{display:flex;justify-content:space-between;align-items:center;gap:10rem;padding:4rem 0;border-top:1px solid #E3E9E6}.r span:first-child{color:#5E6E67}.r b{font-weight:700;font-size:12rem}"
			        & ".c{font-weight:700;font-size:9.5rem;padding:1rem 6rem;border-radius:4rem}</style>"
			        & "<div class='w'><div class='m'>" & _y & "</div><div class='sub'><i style='background:" & [President_colour] & "'></i>" & COALESCE ( _pres, "Before 1999 (no elected president)" ) & "</div>"
			        & "<div class='r'><span>GDP per person</span><b>" & ( "$" & FORMAT ( _v, "#,0" ) ) & "</b></div>"
			        & "<div class='r'><span>In naira</span><b>" & "₦" & FORMAT ( [GDP_per_person_naira] / 1e6, "0.00" ) & "m" & "</b></div>"
			        & "<div class='r'><span>vs " & ( _y - 1 ) & "</span>" & _chip & "</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure GDP_insight_html =
			-- Key takeaway banner for Economy size: size in naira and dollars in the latest year, the dollar peak, real growth
			VAR _hl = "<span class='hl'>"
			VAR _e = "</span>"
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( econ_year[year] ), "@u", CALCULATE ( [GDP_usd] ) ), NOT ISBLANK ( [@u] ) )
			VAR _y = MAXX ( _t, econ_year[year] )
			VAR _n = CALCULATE ( [GDP_naira], econ_year[year] = _y )
			VAR _u = MAXX ( FILTER ( _t, econ_year[year] = _y ), [@u] )
			VAR _pk = TOPN ( 1, _t, [@u], DESC )
			VAR _pky = MAXX ( _pk, econ_year[year] )
			VAR _pkv = MAXX ( _pk, [@u] )
			VAR _g = CALCULATE ( [Real_GDP_growth], econ_year[year] = _y )
			VAR _msg =
			    "Nigeria's economy was " & _hl & ( "₦" & IF ( _n >= 1e13, FORMAT ( _n / 1e12, "#,0" ), FORMAT ( _n / 1e12, "#,0.0" ) ) & "tn" ) & _e & " in " & _y & ", or " & _hl & ( "$" & FORMAT ( _u / 1e9, "#,0" ) & "bn" ) & _e & " in dollars"
			        & IF ( _pky = _y, ", the biggest in the selected years. ",
			            ", <span class='dn'>" & FORMAT ( 1 - DIVIDE ( _u, _pkv ), "0%" ) & " below</span> its " & _pky & " peak of " & ( "$" & FORMAT ( _pkv / 1e9, "#,0" ) & "bn" ) & " as the naira fell. " )
			        & "Real growth was <span class='" & IF ( _g >= 0, "up", "dn" ) & "'>" & FORMAT ( _g, "0.0%" ) & "</span>."
			RETURN
			    [Banner_css]
			        & "<div class='b'><div class='ic'><svg viewBox='0 0 16 16' style='width:16rem;height:16rem'><path d='M8 1.5a4.5 4.5 0 0 0-2.6 8.2V12h5.2V9.7A4.5 4.5 0 0 0 8 1.5zM6 13.2h4V14.5H6z' fill='#E2B53E'/></svg></div>"
			        & "<div class='k'>KEY TAKEAWAY<br>" & _y & "</div><div class='t'>" & _msg & "</div></div>"
		displayFolder: 06 Titles & Labels\Insights

	measure Net_other_prices =
			-- The basis NOT picked on the Prices switch: drawn as the dashed line so the gap between the two shows
			IF ( SELECTEDVALUE ( Prices[Prices], "As paid" ) = "Today's prices", [Net_paid], [Net_today_prices] )
		formatString: ₦#,0
		displayFolder: 01 Base\Real terms

	measure Month_president_colour =
			-- Column colour per month: the president in office that month (same colours as the other economy charts)
			SWITCH ( CALCULATE ( MAX ( econ_month[president] ) ), "Obasanjo", "#7F8C86", "Yar'Adua", "#B9D9C9", "Jonathan", "#8FC9AE", "Buhari", "#4E9C78", "Tinubu", "#0E6B45", "#D5DDD9" )
		displayFolder: 04 Comparison\Colours

	measure Real_legend_html =
			-- Legend for the real-terms chart: presidents with FAAC months in the selection, plus the dashed other-basis line
			VAR _p = FILTER ( ADDCOLUMNS ( VALUES ( dim_administration[president] ), "@f", CALCULATE ( MIN ( faac[disbursement_date] ) ) ), NOT ISBLANK ( [@f] ) && NOT ISBLANK ( dim_administration[president] ) )
			VAR _other = IF ( SELECTEDVALUE ( Prices[Prices], "As paid" ) = "Today's prices", "As paid", "In " & FORMAT ( [Price_base_month], "mmm yyyy" ) & " prices" )
			RETURN
			    "<style>html{font-size:calc(100vh / 20)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".l{position:fixed;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;gap:14rem;font-family:Segoe UI,sans-serif;font-size:9.5rem;color:#5E6E67;white-space:nowrap}"
			        & ".l i{display:inline-block;width:9rem;height:9rem;border-radius:2rem;margin-right:4rem;vertical-align:-1rem}"
			        & ".l u{display:inline-block;width:18rem;border-top:2rem dashed #E2B53E;margin-right:4rem;vertical-align:3rem}</style><div class='l'>"
			        & CONCATENATEX ( _p, "<span><i style='background:" & SWITCH ( dim_administration[president], "Obasanjo", "#7F8C86", "Yar'Adua", "#B9D9C9", "Jonathan", "#8FC9AE", "Buhari", "#4E9C78", "Tinubu", "#0E6B45", "#D5DDD9" ) & "'></i>" & dim_administration[president] & "</span>", "", [@f], ASC )
			        & "<span><u></u>" & _other & " (dashed)</span></div>"
		displayFolder: 05 Visual Helpers\HTML

	measure RealFirst_flipcard =
			-- Flip card: first month in the selection. Front = value and context; back = what it means
			VAR _f = [Real_first_month]
			VAR _l = [Real_latest_month]
			VAR _base = [Price_base_month]
			VAR _bl = FORMAT ( _base, "mmm yyyy" )
			VAR _pf = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _f, 0 ) )
			VAR _pl = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _l, 0 ) )
			VAR _tf = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _f, 0 ) )
			VAR _tl = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _l, 0 ) )

			RETURN
			    [Flip_css]
			        & "<div class='fc'><div class='fi'><div class='face front'><div class='lbl'>" & "FIRST MONTH · " & UPPER ( FORMAT ( _f, "mmm yyyy" ) ) & "</div>"
			        & "<div class='val'>" & ( "₦" & IF ( ABS ( _pf ) >= 1e12, FORMAT ( _pf / 1e12, "#,0.00" ) & "tn", FORMAT ( _pf / 1e9, "#,0.0" ) & "bn" ) ) & "<small>" & "as paid" & "</small></div>"
			        & "<div class='chg'>" & "<span class='bd' style='color:" & "#0B3D2E" & ";background:" & SWITCH ( "#0B3D2E", "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#0B3D2E", "#EDF2EF", "#FBF1DC" ) & "'>" & ( "₦" & IF ( ABS ( _tf ) >= 1e12, FORMAT ( _tf / 1e12, "#,0.00" ) & "tn", FORMAT ( _tf / 1e9, "#,0.0" ) & "bn" ) ) & "</span>" & " in " & _bl & " prices" & "</div>"
			        & "<div class='asof'>" & "Net received, all 36 states" & "</div><div class='hint'>HOVER &#8635;</div></div>"
			        & "<div class='face back'><div class='bt'>WHAT IT MEANS</div><p>" & "In " & FORMAT ( _f, "mmm yyyy" ) & " states received " & ( "₦" & IF ( ABS ( _pf ) >= 1e12, FORMAT ( _pf / 1e12, "#,0.00" ) & "tn", FORMAT ( _pf / 1e9, "#,0.0" ) & "bn" ) ) & ". Prices have risen " & FORMAT ( DIVIDE ( _tf, _pf ), "0.00" ) & "× since, so that money is worth " & ( "₦" & IF ( ABS ( _tf ) >= 1e12, FORMAT ( _tf / 1e12, "#,0.00" ) & "tn", FORMAT ( _tf / 1e9, "#,0.0" ) & "bn" ) ) & " in " & _bl & " prices." & "</p></div></div></div>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure RealLatest_flipcard =
			-- Flip card: latest month in the selection. Front = value and context; back = what it means
			VAR _f = [Real_first_month]
			VAR _l = [Real_latest_month]
			VAR _base = [Price_base_month]
			VAR _bl = FORMAT ( _base, "mmm yyyy" )
			VAR _pf = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _f, 0 ) )
			VAR _pl = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _l, 0 ) )
			VAR _tf = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _f, 0 ) )
			VAR _tl = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _l, 0 ) )
			VAR _pp = CALCULATE ( [Net_paid], REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), calendar_table[month_date] = EOMONTH ( _l, -1 ) )
			VAR _c = DIVIDE ( _pl - _pp, _pp )
			VAR _col = SWITCH ( TRUE (), ISBLANK ( _pp ) || ROUND ( _c, 3 ) = 0, "#C98A00", _c > 0, "#0E8A5F", "#C93C3C" )
			VAR _isbase = EOMONTH ( _l, 0 ) = EOMONTH ( _base, 0 )
			RETURN
			    [Flip_css]
			        & "<div class='fc'><div class='fi'><div class='face front'><div class='lbl'>" & "LATEST MONTH · " & UPPER ( FORMAT ( _l, "mmm yyyy" ) ) & "</div>"
			        & "<div class='val'>" & ( "₦" & IF ( ABS ( _pl ) >= 1e12, FORMAT ( _pl / 1e12, "#,0.00" ) & "tn", FORMAT ( _pl / 1e9, "#,0.0" ) & "bn" ) ) & "<small>" & "as paid" & "</small></div>"
			        & "<div class='chg'>" & IF ( ISBLANK ( _pp ), "", "<span class='bd' style='color:" & _col & ";background:" & SWITCH ( _col, "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#0B3D2E", "#EDF2EF", "#FBF1DC" ) & "'>" & IF ( _c >= 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _c ), "0.0%" ) & "</span>" & "vs " & FORMAT ( EDATE ( _l, -1 ), "mmm yyyy" ) ) & "</div>"
			        & "<div class='asof'>" & IF ( _isbase, "This is the price base month", ( "₦" & IF ( ABS ( _tl ) >= 1e12, FORMAT ( _tl / 1e12, "#,0.00" ) & "tn", FORMAT ( _tl / 1e9, "#,0.0" ) & "bn" ) ) & " in " & _bl & " prices" ) & "</div><div class='hint'>HOVER &#8635;</div></div>"
			        & "<div class='face back'><div class='bt'>WHAT IT MEANS</div><p>" & IF ( _isbase, "This is the latest month, so today's prices and the amount paid are the same.", ( "₦" & IF ( ABS ( _pl ) >= 1e12, FORMAT ( _pl / 1e12, "#,0.00" ) & "tn", FORMAT ( _pl / 1e9, "#,0.0" ) & "bn" ) ) & " paid in " & FORMAT ( _l, "mmm yyyy" ) & " is worth " & ( "₦" & IF ( ABS ( _tl ) >= 1e12, FORMAT ( _tl / 1e12, "#,0.00" ) & "tn", FORMAT ( _tl / 1e9, "#,0.0" ) & "bn" ) ) & " in " & _bl & " prices." ) & "</p></div></div></div>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure ChangePaid_flipcard =
			-- Flip card: change as paid. Front = value and context; back = what it means
			VAR _f = [Real_first_month]
			VAR _l = [Real_latest_month]
			VAR _base = [Price_base_month]
			VAR _bl = FORMAT ( _base, "mmm yyyy" )
			VAR _pf = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _f, 0 ) )
			VAR _pl = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _l, 0 ) )
			VAR _tf = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _f, 0 ) )
			VAR _tl = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _l, 0 ) )
			VAR _c = DIVIDE ( _pl, _pf ) - 1
			VAR _col = SWITCH ( TRUE (), ROUND ( _c, 3 ) = 0, "#C98A00", _c > 0, "#0E8A5F", "#C93C3C" )
			RETURN
			    [Flip_css]
			        & "<div class='fc'><div class='fi'><div class='face front'><div class='lbl'>" & "CHANGE AS PAID" & "</div>"
			        & "<div class='val'>" & IF ( _c > 0, "+", "" ) & FORMAT ( _c, "0%" ) & "<small>" & FORMAT ( DIVIDE ( _pl, _pf ), "0.0" ) & "×" & "</small></div>"
			        & "<div class='chg'>" & "<span class='bd' style='color:" & _col & ";background:" & SWITCH ( _col, "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#0B3D2E", "#EDF2EF", "#FBF1DC" ) & "'>" & IF ( _c >= 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " in naira" & "</span>" & FORMAT ( _f, "mmm yyyy" ) & " to " & FORMAT ( _l, "mmm yyyy" ) & "</div>"
			        & "<div class='asof'>" & "Not adjusted for prices" & "</div><div class='hint'>HOVER &#8635;</div></div>"
			        & "<div class='face back'><div class='bt'>WHAT IT MEANS</div><p>" & "Counting naira as paid, monthly FAAC money is " & FORMAT ( DIVIDE ( _pl, _pf ), "0.0" ) & "× what it was in " & FORMAT ( _f, "mmm yyyy" ) & ". But prices rose too, so this overstates what states can buy." & "</p></div></div></div>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure ChangeReal_flipcard =
			-- Flip card: change in real terms. Front = value and context; back = what it means
			VAR _f = [Real_first_month]
			VAR _l = [Real_latest_month]
			VAR _base = [Price_base_month]
			VAR _bl = FORMAT ( _base, "mmm yyyy" )
			VAR _pf = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _f, 0 ) )
			VAR _pl = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _l, 0 ) )
			VAR _tf = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _f, 0 ) )
			VAR _tl = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _l, 0 ) )
			VAR _c = DIVIDE ( _tl, _tf ) - 1
			VAR _col = SWITCH ( TRUE (), ISBLANK ( _tl ) || ROUND ( _c, 3 ) = 0, "#C98A00", _c > 0, "#0E8A5F", "#C93C3C" )
			RETURN
			    [Flip_css]
			        & "<div class='fc'><div class='fi'><div class='face front'><div class='lbl'>" & "CHANGE IN REAL TERMS" & "</div>"
			        & "<div class='val'>" & IF ( ISBLANK ( _tl ), "n/a", IF ( _c > 0, "+", "" ) & FORMAT ( _c, "0%" ) ) & "<small>" & "after prices" & "</small></div>"
			        & "<div class='chg'>" & "<span class='bd' style='color:" & _col & ";background:" & SWITCH ( _col, "#0E8A5F", "#E3F4EC", "#C93C3C", "#FBE7E7", "#0B3D2E", "#EDF2EF", "#FBF1DC" ) & "'>" & IF ( _c >= 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " buying power" & "</span>" & FORMAT ( _f, "mmm yyyy" ) & " to " & FORMAT ( _l, "mmm yyyy" ) & "</div>"
			        & "<div class='asof'>" & "In " & _bl & " prices" & "</div><div class='hint'>HOVER &#8635;</div></div>"
			        & "<div class='face back'><div class='bt'>WHAT IT MEANS</div><p>" & IF ( ISBLANK ( _tl ), "Price data for " & FORMAT ( _l, "mmm yyyy" ) & " isn't out yet.", "After allowing for price rises, states can buy " & IF ( ROUND ( _c, 2 ) = 0, "about the same", FORMAT ( ABS ( _c ), "0%" ) & IF ( _c > 0, " more", " less" ) ) & " with their monthly FAAC money than in " & FORMAT ( _f, "mmm yyyy" ) & "." ) & "</p></div></div></div>"
		displayFolder: 05 Visual Helpers\Flip Cards

	measure Real_explain_html =
			-- "What it means" side of the real-terms chart (shown by a bookmark): what "real terms" means, a worked
			-- example from the data, what the chart says, and each president's monthly net found and left in today's prices
			VAR _f = [Real_first_month]
			VAR _l = [Real_latest_month]
			VAR _base = [Price_base_month]
			VAR _bl = FORMAT ( _base, "mmm yyyy" )
			VAR _pf = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _f, 0 ) )
			VAR _pl = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _l, 0 ) )
			VAR _tf = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _f, 0 ) )
			VAR _tl = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _l, 0 ) )
			VAR _mult = DIVIDE ( _tf, _pf )
			VAR _c = DIVIDE ( _tl, _tf ) - 1
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( calendar_table[month_date] ), "@r", [Net_today_prices] ), NOT ISBLANK ( [@r] ) )
			VAR _pk = TOPN ( 1, _t, [@r], DESC )
			VAR _lastm = MAXX ( _t, calendar_table[month_date] )
			-- Each president: first and last FAAC month in the selection; found = the month before their first (what they inherited)
			VAR _ad0 = FILTER ( ADDCOLUMNS ( VALUES ( dim_administration[president] ),
			    "@f", CALCULATE ( MIN ( faac[disbursement_date] ) ),
			    "@l", CALCULATE ( MAX ( faac[disbursement_date] ) ) ), NOT ISBLANK ( [@f] ) && NOT ISBLANK ( dim_administration[president] ) )
			VAR _ad = ADDCOLUMNS ( _ad0,
			    "@a", VAR _f0 = [@f] RETURN COALESCE (
			        CALCULATE ( [Net_today_prices], REMOVEFILTERS ( econ_month ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), calendar_table[month_date] = EOMONTH ( _f0, -1 ) ),
			        CALCULATE ( [Net_today_prices], REMOVEFILTERS ( econ_month ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), calendar_table[month_date] = EOMONTH ( _f0, 0 ) ) ),
			    "@b", VAR _l0 = [@l] RETURN CALCULATE ( [Net_today_prices], REMOVEFILTERS ( econ_month ), REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), calendar_table[month_date] = EOMONTH ( _l0, 0 ) ) )
			VAR _rows = CONCATENATEX ( _ad,
			    VAR _d = DIVIDE ( [@b] - [@a], [@a] )
			    RETURN
			        "<div class='ar'><span class='nm'>" & dim_administration[president] & "<small>" & FORMAT ( [@f], "mmm yyyy" ) & " – " & FORMAT ( [@l], "mmm yyyy" ) & IF ( [@l] = _l, " (latest)", "" ) & "</small></span>"
			            & "<span class='vv'>" & ( "₦" & IF ( ABS ( [@a] ) >= 1e12, FORMAT ( [@a] / 1e12, "#,0.00" ) & "tn", FORMAT ( [@a] / 1e9, "#,0.0" ) & "bn" ) ) & " → " & ( "₦" & IF ( ABS ( [@b] ) >= 1e12, FORMAT ( [@b] / 1e12, "#,0.00" ) & "tn", FORMAT ( [@b] / 1e9, "#,0.0" ) & "bn" ) ) & "</span>"
			            & "<span class='ch' style='color:" & SWITCH ( TRUE (), ROUND ( _d, 2 ) = 0, "#F0C75E", _d > 0, "#7FD6A8", "#FF8A80" ) & "'>"
			            & SWITCH ( TRUE (), ROUND ( _d, 2 ) = 0, UNICHAR ( 9632 ), _d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _d ), "0%" ) & "</span></div>",
			    "", [@f], ASC )
			VAR _say =
			    IF ( _c < 0,
			        "In naira, states got <b>" & FORMAT ( DIVIDE ( _pl, _pf ), "0.0" ) & "× more</b> in " & FORMAT ( _l, "mmm yyyy" ) & " than in " & FORMAT ( _f, "mmm yyyy" ) & ". In real terms it was <b>" & FORMAT ( ABS ( _c ), "0%" ) & " less</b>: prices rose faster than FAAC money.",
			        "States got <b>" & FORMAT ( _c, "0%" ) & " more</b> in real terms in " & FORMAT ( _l, "mmm yyyy" ) & " than in " & FORMAT ( _f, "mmm yyyy" ) & "." )
			        & " The real peak was <b>" & ( "₦" & IF ( ABS ( MAXX ( _pk, [@r] ) ) >= 1e12, FORMAT ( MAXX ( _pk, [@r] ) / 1e12, "#,0.00" ) & "tn", FORMAT ( MAXX ( _pk, [@r] ) / 1e9, "#,0.0" ) & "bn" ) ) & "</b> in " & FORMAT ( MAXX ( _pk, calendar_table[month_date] ), "mmm yyyy" ) & "."
			RETURN
			    "<style>html{font-size:calc(100vh / 408)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".x{position:fixed;top:0;left:0;right:0;bottom:0;border-radius:12rem;background:#0B3D2E;color:#fff;padding:44rem 26rem 18rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;display:flex;gap:30rem;animation:fi .45s ease-out}"
			        & "@keyframes fi{from{transform:perspective(1200px) rotateY(-90deg);opacity:.2}to{transform:none;opacity:1}}"
			        & ".c1,.c2{flex:1}"
			        & ".h{font-size:9.5rem;letter-spacing:1.8rem;color:#E2B53E;font-weight:700;margin-top:16rem}.h:first-child{margin-top:0}"
			        & ".x p{margin:5rem 0 0;font-size:13rem;line-height:1.45}.x b{color:#E2B53E}"
			        & ".k{display:grid;grid-template-columns:1fr 1fr;gap:8rem;margin-top:8rem}.t{background:#14523F;border-radius:10rem;padding:9rem 12rem;font-size:9.5rem;color:#B9D9C9}"
			        & ".t b{display:block;font-size:19rem;color:#E2B53E;margin-top:2rem}"
			        & ".ar{display:flex;align-items:center;gap:10rem;padding:5rem 0;border-top:1px solid #1E5E49;font-size:12.5rem}"
			        & ".ar.hd{border-top:0;padding:8rem 0 2rem;font-size:8.5rem;letter-spacing:1.2rem;color:#B9D9C9}"
			        & ".nm{flex:1;font-weight:600}.nm small{display:block;font-weight:400;font-size:9.5rem;color:#B9D9C9}"
			        & ".vv{text-align:right;font-weight:700;color:#E2B53E;white-space:nowrap}.ch{min-width:64rem;text-align:right;font-weight:700}</style>"
			        & "<div class='x'><div class='c1'><div class='h'>WHAT DOES &quot;IN REAL TERMS&quot; MEAN?</div>"
			        & "<p>Prices in Nigeria rise every year, so ₦100 buys less today than it did a few years ago. To compare FAAC money fairly, each month's amount is restated in <b>" & _bl & " prices</b> using the consumer price index. That's &quot;today's prices&quot;. &quot;As paid&quot; is the naira actually received.</p>"
			        & "<div class='h'>A WORKED EXAMPLE FROM THIS DATA</div><div class='k'>"
			        & "<div class='t'>" & FORMAT ( _f, "mmm yyyy" ) & ", as paid<b>" & ( "₦" & IF ( ABS ( _pf ) >= 1e12, FORMAT ( _pf / 1e12, "#,0.00" ) & "tn", FORMAT ( _pf / 1e9, "#,0.0" ) & "bn" ) ) & "</b></div>"
			        & "<div class='t'>Prices since then<b>× " & FORMAT ( _mult, "0.00" ) & "</b></div>"
			        & "<div class='t'>In " & _bl & " prices<b>" & ( "₦" & IF ( ABS ( _tf ) >= 1e12, FORMAT ( _tf / 1e12, "#,0.00" ) & "tn", FORMAT ( _tf / 1e9, "#,0.0" ) & "bn" ) ) & "</b></div>"
			        & "<div class='t'>" & FORMAT ( _l, "mmm yyyy" ) & ", as paid<b>" & ( "₦" & IF ( ABS ( _pl ) >= 1e12, FORMAT ( _pl / 1e12, "#,0.00" ) & "tn", FORMAT ( _pl / 1e9, "#,0.0" ) & "bn" ) ) & "</b></div></div></div>"
			        & "<div class='c2'><div class='h'>WHAT THE CHART SAYS · " & UPPER ( FORMAT ( _f, "mmm yyyy" ) & " TO " & FORMAT ( _l, "mmm yyyy" ) ) & "</div><p>" & _say & "</p>"
			        & "<div class='ar hd'><span class='nm'>EACH PRESIDENT · MONTHLY NET</span><span class='vv'>FOUND → LEFT, " & UPPER ( _bl ) & " PRICES</span><span class='ch'>CHANGE</span></div>"
			        & _rows & "</div></div>"
		displayFolder: 05 Visual Helpers\HTML

	measure Real_month_tt_html =
			-- Tooltip card for the real-terms chart: the hovered month as paid and in today's prices, the price rise
			-- since then, and the change on the month before in the basis picked on the Prices switch
			VAR _m = MAX ( calendar_table[month_date] )
			VAR _pres = CALCULATE ( MAX ( econ_month[president] ) )
			VAR _base = [Price_base_month]
			VAR _bl = FORMAT ( _base, "mmm yyyy" )
			VAR _paid = [Net_paid]
			VAR _today = [Net_today_prices]
			VAR _v = [Net_prices]
			VAR _p = CALCULATE ( [Net_prices], REMOVEFILTERS ( calendar_table ), REMOVEFILTERS ( dim_administration ), calendar_table[month_date] = EOMONTH ( _m, -1 ) )
			VAR _d = DIVIDE ( _v - _p, _p )
			VAR _flat = ROUND ( _d, 3 ) = 0
			VAR _real = SELECTEDVALUE ( Prices[Prices], "As paid" ) = "Today's prices"
			VAR _chip = IF ( ISBLANK ( _p ), "<span class='c' style='color:#5E6E67;background:#EDF2EF'>n/a</span>",
			    "<span class='c' style='color:" & SWITCH ( TRUE (), _flat, "#C98A00", _d > 0, "#0E8A5F", "#C93C3C" ) & ";background:" & SWITCH ( TRUE (), _flat, "#FBF1DC", _d > 0, "#E3F4EC", "#FBE7E7" ) & "'>"
			        & SWITCH ( TRUE (), _flat, UNICHAR ( 9632 ), _d > 0, UNICHAR ( 9650 ), UNICHAR ( 9660 ) ) & " " & FORMAT ( ABS ( _d ), "0.0%" ) & "</span>" )
			VAR _note = IF ( EOMONTH ( _m, 0 ) = EOMONTH ( _base, 0 ), "This is the price base month, so today's prices equal what was paid.",
			    IF ( ISBLANK ( _today ), "No price data for this month yet.",
			        "Prices rose " & FORMAT ( DIVIDE ( _today, _paid ), "0.00" ) & "× from " & FORMAT ( _m, "mmm yyyy" ) & " to " & _bl & ", so " & ( "₦" & IF ( ABS ( _paid ) >= 1e12, FORMAT ( _paid / 1e12, "#,0.00" ) & "tn", FORMAT ( _paid / 1e9, "#,0.0" ) & "bn" ) ) & " then is worth " & ( "₦" & IF ( ABS ( _today ) >= 1e12, FORMAT ( _today / 1e12, "#,0.00" ) & "tn", FORMAT ( _today / 1e9, "#,0.0" ) & "bn" ) ) & " now." ) )
			RETURN
			    "<style>html{font-size:calc(100vh / 176)}html,body{margin:0;padding:0;overflow:hidden}"
			        & ".w{position:fixed;top:0;left:0;right:0;bottom:0;padding:10rem 12rem;box-sizing:border-box;font-family:Segoe UI,sans-serif;font-size:10.5rem;color:#14231D;background:#fff;border-radius:12rem;overflow:hidden}"
			        & ".m{font-weight:700;font-size:12rem;letter-spacing:.5rem}.sub{color:#5E6E67;font-size:9.5rem;margin:2rem 0 6rem}.sub i{display:inline-block;width:8rem;height:8rem;border-radius:2rem;margin-right:4rem}"
			        & ".r{display:flex;justify-content:space-between;align-items:center;gap:10rem;padding:4rem 0;border-top:1px solid #E3E9E6}.r span:first-child{color:#5E6E67}.r b{font-weight:700;font-size:12rem}"
			        & ".c{font-weight:700;font-size:9.5rem;padding:1rem 6rem;border-radius:4rem}.n{margin-top:6rem;font-size:9.5rem;line-height:1.35;color:#5E6E67}</style>"
			        & "<div class='w'><div class='m'>" & UPPER ( FORMAT ( _m, "mmmm yyyy" ) ) & "</div><div class='sub'><i style='background:" & [Month_president_colour] & "'></i>" & COALESCE ( _pres, "No president" ) & "</div>"
			        & "<div class='r'><span>As paid</span><b>" & ( "₦" & IF ( ABS ( _paid ) >= 1e12, FORMAT ( _paid / 1e12, "#,0.00" ) & "tn", FORMAT ( _paid / 1e9, "#,0.0" ) & "bn" ) ) & "</b></div>"
			        & "<div class='r'><span>In " & _bl & " prices</span><b>" & IF ( ISBLANK ( _today ), "n/a", ( "₦" & IF ( ABS ( _today ) >= 1e12, FORMAT ( _today / 1e12, "#,0.00" ) & "tn", FORMAT ( _today / 1e9, "#,0.0" ) & "bn" ) ) ) & "</b></div>"
			        & "<div class='r'><span>vs " & FORMAT ( EDATE ( _m, -1 ), "mmm yyyy" ) & IF ( _real, " (real)", " (as paid)" ) & "</span>" & _chip & "</div>"
			        & "<div class='n'>" & _note & "</div></div>"
		displayFolder: 06 Titles & Labels\Tooltips

	measure Real_insight_html =
			-- Key takeaway banner for FAAC in real terms: as paid vs real change over the selection, and the real peak
			VAR _f = [Real_first_month]
			VAR _l = [Real_latest_month]
			VAR _base = [Price_base_month]
			VAR _bl = FORMAT ( _base, "mmm yyyy" )
			VAR _pf = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _f, 0 ) )
			VAR _pl = CALCULATE ( [Net_paid], calendar_table[month_date] = EOMONTH ( _l, 0 ) )
			VAR _tf = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _f, 0 ) )
			VAR _tl = CALCULATE ( [Net_today_prices], calendar_table[month_date] = EOMONTH ( _l, 0 ) )
			VAR _c = DIVIDE ( _tl, _tf ) - 1
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( calendar_table[month_date] ), "@r", [Net_today_prices] ), NOT ISBLANK ( [@r] ) )
			VAR _pk = TOPN ( 1, _t, [@r], DESC )
			VAR _msg =
			    "In naira, states received <span class='hl'>" & FORMAT ( DIVIDE ( _pl, _pf ), "0.0" ) & "×</span> as much in " & FORMAT ( _l, "mmmm yyyy" ) & " as in " & FORMAT ( _f, "mmm yyyy" ) & ". "
			        & IF ( ISBLANK ( _tl ), "Price data for " & FORMAT ( _l, "mmm yyyy" ) & " isn't out yet. ",
			            "After price rises, that is " & IF ( ROUND ( _c, 2 ) = 0, "about the same",
			                "<span class='" & IF ( _c < 0, "dn", "up" ) & "'>" & FORMAT ( ABS ( _c ), "0%" ) & IF ( _c < 0, " less", " more" ) & "</span>" ) & " in real terms. " )
			        & "The real peak was " & ( "₦" & IF ( ABS ( MAXX ( _pk, [@r] ) ) >= 1e12, FORMAT ( MAXX ( _pk, [@r] ) / 1e12, "#,0.00" ) & "tn", FORMAT ( MAXX ( _pk, [@r] ) / 1e9, "#,0.0" ) & "bn" ) ) & " in " & FORMAT ( MAXX ( _pk, calendar_table[month_date] ), "mmm yyyy" ) & "."
			RETURN
			    [Banner_css]
			        & "<div class='b'><div class='ic'><svg viewBox='0 0 16 16' style='width:16rem;height:16rem'><path d='M8 1.5a4.5 4.5 0 0 0-2.6 8.2V12h5.2V9.7A4.5 4.5 0 0 0 8 1.5zM6 13.2h4V14.5H6z' fill='#E2B53E'/></svg></div>"
			        & "<div class='k'>KEY TAKEAWAY<br>" & UPPER ( FORMAT ( _l, "mmm yyyy" ) ) & "</div><div class='t'>" & _msg & "</div></div>"
		displayFolder: 06 Titles & Labels\Insights

	column Value
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition Dax = calculated
		mode: import
		source =
				ROW ( "Value", 0 )

	annotation PBI_ResultType = Table
