    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What this is",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0E6B45",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The Nigeria Data Dashboard brings public Nigerian data into one place. The FAAC section shows what each state receives every month from the Federation Account Allocation Committee: the gross allocation, what is deducted, and what the state actually receives.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0F2019"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0F2019"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The Economy section tracks inflation, the naira, the size of the economy, FAAC in real terms (after inflation) and how each administration did.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0F2019"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0F2019"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "It's for anyone who wants to see how federal revenue reaches the states: journalists, researchers, students and curious citizens. An elections section is coming.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#0F2019"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
